{% extends "layout.html.twig" %}

{% block title %}Dashboard — LudusCartographer{% endblock %}

{% block content %}
<!-- ヘッダー -->
<div class="flex items-center justify-between mb-4">
    <div>
        <h2 class="text-2xl font-bold text-brand-light">Dashboard</h2>
    </div>
    <div class="flex items-center gap-4">
        <div id="stats" class="text-sm text-gray-400"></div>
        <div id="status" class="flex items-center gap-2">
            <span id="status-dot" class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            <span id="status-text" class="text-xs text-gray-500">自動更新中</span>
        </div>
    </div>
</div>

<!-- タブ -->
<div class="flex items-center gap-1 mb-4 border-b border-gray-800">
    <button id="tab-live" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-brand text-brand-light"
            onclick="switchTab('live')">
        Live
    </button>
    <button id="tab-final" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-300"
            onclick="switchTab('final')">
        Final
    </button>
    <select id="session-select" class="ml-3 bg-gray-800 text-gray-300 text-xs rounded px-2 py-1 border border-gray-700 focus:border-brand outline-none">
        <option value="">最新セッション</option>
    </select>
    <select id="filter-select" class="ml-1 bg-gray-800 text-gray-300 text-xs rounded px-2 py-1 border border-gray-700 focus:border-brand outline-none">
        <option value="reps" selected>採用</option>
        <option value="all">全画像</option>
        <option value="thinned">不採用</option>
        <option value="pending">未処理</option>
    </select>
</div>

<!-- グリッド -->
<div id="grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
    <div class="col-span-full text-center text-gray-600 py-12">読み込み中...</div>
</div>

<!-- モーダル -->
<div id="modal" class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center p-4">
    <div class="flex items-center gap-3 max-w-6xl w-full">
        <button id="modal-prev" class="flex-shrink-0 w-10 h-10 rounded-full bg-gray-700/80 hover:bg-gray-600 text-white text-xl flex items-center justify-center transition-colors" title="前へ (←)">&#8249;</button>
        <div class="bg-gray-900 rounded-xl flex-1 min-w-0 max-h-[95vh] overflow-auto border border-gray-700" onclick="event.stopPropagation()">
            <div class="flex justify-between items-center p-4 border-b border-gray-800">
                <div class="flex items-center gap-3 min-w-0">
                    <span id="modal-counter" class="text-xs text-gray-500 flex-shrink-0"></span>
                    <h3 id="modal-title" class="text-lg font-bold text-brand-light truncate"></h3>
                </div>
                <button id="modal-close-btn" class="text-gray-500 hover:text-white text-2xl flex-shrink-0 ml-4">&times;</button>
            </div>
            <div class="p-4">
                <img id="modal-img" src="" class="w-full rounded-lg bg-gray-800 mb-4" />
                <div id="modal-ocr" class="bg-gray-800 rounded-lg p-4 text-sm text-gray-300 whitespace-pre-wrap max-h-60 overflow-auto"></div>
                <div class="mt-3 flex gap-4 text-xs text-gray-600">
                    <span id="modal-scene"></span>
                    <span id="modal-fp" class="font-mono"></span>
                    <span id="modal-time"></span>
                </div>
            </div>
        </div>
        <button id="modal-next" class="flex-shrink-0 w-10 h-10 rounded-full bg-gray-700/80 hover:bg-gray-600 text-white text-xl flex items-center justify-center transition-colors" title="次へ (→)">&#8250;</button>
    </div>
</div>

<script>
(function() {
    const POLL_INTERVAL = 3000;
    const API_BASE = 'api/search.php';
    const grid = document.getElementById('grid');
    const stats = document.getElementById('stats');
    const modal = document.getElementById('modal');
    let allScreens = [];
    let maxId = 0;
    let currentTab = 'live';
    let pollTimer = null;
    let currentSessionId = '';  // 空=最新セッション
    let pollCount = 0;
    const FULL_REFRESH_EVERY = 5;  // 5回に1回フルリフレッシュ (ステータス更新反映)
    let knownSessions = [];
    const filterSelect = document.getElementById('filter-select');
    const sessionSelect = document.getElementById('session-select');
    filterSelect.addEventListener('change', renderAll);
    sessionSelect.addEventListener('change', function() {
        currentSessionId = this.value;
        allScreens = [];
        maxId = 0;
        fetchLiveInitial();
    });

    function getGameParam() {
        return new URLSearchParams(window.location.search).get('game') || '';
    }

    function imgUrl(path) {
        if (!path) return '';
        return 'img.php?path=' + encodeURIComponent(path);
    }

    function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function renderCard(s, idx) {
        const thumb = s.thumbnail_path ? imgUrl(s.thumbnail_path) : (s.screenshot_path ? imgUrl(s.screenshot_path) : '');
        const ocrPreview = (s.ocr_text || '').substring(0, 80);
        const sceneBadge = s.category && s.category !== 'depth=0'
            ? `<span class="inline-block px-1.5 py-0.5 text-[9px] rounded bg-gray-800 text-gray-400">${escapeHtml(s.category)}</span>`
            : '';
        // ステータスドット: 処理済みのみ表示
        const isThinned = s.cluster_id !== null && s.cluster_id !== undefined && !s.is_representative;
        const dots = [];
        if (isThinned) dots.push('<span class="w-1.5 h-1.5 rounded-full bg-gray-500" title="不採用"></span>');
        if (s.is_representative) dots.push('<span class="w-1.5 h-1.5 rounded-full bg-emerald-500" title="採用"></span>');
        if (s.has_hq_ocr) dots.push('<span class="w-1.5 h-1.5 rounded-full bg-sky-500" title="HQ OCR済"></span>');
        const statusDots = dots.length ? `<span class="flex gap-0.5 items-center">${dots.join('')}</span>` : '';
        const dimClass = (isThinned && filterSelect.value === 'all') ? ' opacity-40' : '';
        return `
            <div class="bg-gray-900 border border-gray-800 rounded-lg overflow-hidden cursor-pointer
                        hover:border-brand/50 hover:shadow-lg hover:shadow-brand/10 transition-all${dimClass}"
                 data-idx="${idx}">
                ${thumb
                    ? `<img src="${thumb}" class="w-full aspect-video object-cover bg-gray-800" loading="lazy" />`
                    : `<div class="w-full aspect-video bg-gray-800 flex items-center justify-center text-3xl">📱</div>`
                }
                <div class="p-2">
                    <p class="text-xs font-semibold text-gray-200 truncate">${escapeHtml(s.name || 'Unknown')}</p>
                    <p class="text-[10px] text-gray-500 truncate mt-0.5">${escapeHtml(ocrPreview)}</p>
                    <div class="flex items-center justify-between mt-1">
                        <div class="flex items-center gap-1.5">${sceneBadge}${statusDots}</div>
                        <span class="text-[10px] text-gray-600">${escapeHtml(s.last_seen_at || '')}</span>
                    </div>
                </div>
            </div>
        `;
    }

    function renderAll() {
        const filter = filterSelect.value;
        let filtered = allScreens;
        if (filter === 'reps') {
            filtered = allScreens.filter(s => s.is_representative || s.cluster_id === null || s.cluster_id === undefined);
        } else if (filter === 'thinned') {
            filtered = allScreens.filter(s => s.cluster_id !== null && s.cluster_id !== undefined && !s.is_representative);
        } else if (filter === 'pending') {
            filtered = allScreens.filter(s => (s.cluster_id === null || s.cluster_id === undefined) || (s.is_representative && !s.has_hq_ocr));
        }
        if (filtered.length === 0) {
            const msg = currentTab === 'live'
                ? 'まだスクリーンが記録されていません。<br><code class="text-brand-light">auto_pilot.py -S</code> で起動してください。'
                : 'まだ決定版がありません。<br>バッチプロセッサを実行してください。';
            grid.innerHTML = `<div class="col-span-full text-center text-gray-600 py-12">${msg}</div>`;
            return;
        }
        grid.innerHTML = filtered.map((s, i) => renderCard(s, allScreens.indexOf(s))).join('');
        const repsCount = allScreens.filter(s => s.is_representative).length;
        stats.textContent = filter === 'all'
            ? `${allScreens.length} 画面 (代表 ${repsCount})`
            : `${filtered.length} 画面`;
    }

    // --- セッション一覧取得 ---
    async function fetchSessions() {
        const game = getGameParam();
        const params = new URLSearchParams({ action: 'get_sessions' });
        if (game) params.set('game', game);
        try {
            const res = await fetch(API_BASE + '?' + params);
            const data = await res.json();
            knownSessions = (data.sessions || []).map(s => s.session_dir);
            sessionSelect.innerHTML = '<option value="">最新セッション</option>';
            const older = (data.sessions || []).slice(1); // 最新を除外
            for (const s of older) {
                const label = s.session_dir.replace('ap_', '').replace(/_/g, ' ');
                sessionSelect.innerHTML += `<option value="${escapeHtml(s.session_dir)}">${escapeHtml(label)}</option>`;
            }
        } catch (e) {}
    }

    // --- Live タブ ---
    async function fetchLiveInitial() {
        await fetchSessions();
        // 「最新セッション」(value='') → 最新セッションIDで API を呼ぶ
        const sid = currentSessionId || (knownSessions.length > 0 ? knownSessions[0] : '');
        const game = getGameParam();
        const params = new URLSearchParams({ action: 'get_recent_screens', limit: '10000' });
        if (game) params.set('game', game);
        if (sid) params.set('session_id', sid);
        try {
            const res = await fetch(API_BASE + '?' + params);
            const data = await res.json();
            allScreens = data.screens || [];
            if (allScreens.length > 0) {
                maxId = Math.max(...allScreens.map(s => s.id));
            }
            renderAll();
        } catch (e) {
            grid.innerHTML = '<div class="col-span-full text-center text-red-500 py-12">API エラー</div>';
        }
    }

    async function pollLive() {
        pollCount++;
        // 新しいセッションが始まったか確認
        const game = getGameParam();
        const sessParams = new URLSearchParams({ action: 'get_sessions' });
        if (game) sessParams.set('game', game);
        try {
            const sessRes = await fetch(API_BASE + '?' + sessParams);
            const sessData = await sessRes.json();
            const latestSessions = (sessData.sessions || []).map(s => s.session_dir);
            if (latestSessions.length > 0 && latestSessions[0] !== knownSessions[0]) {
                knownSessions = latestSessions;
                sessionSelect.innerHTML = '<option value="">最新セッション</option>';
                const olderPoll = (sessData.sessions || []).slice(1);
                for (const s of olderPoll) {
                    const label = s.session_dir.replace('ap_', '').replace(/_/g, ' ');
                    sessionSelect.innerHTML += `<option value="${escapeHtml(s.session_dir)}">${escapeHtml(label)}</option>`;
                }
                currentSessionId = '';
                sessionSelect.value = '';
                allScreens = [];
                maxId = 0;
                pollCount = 0;
                fetchLiveInitial();
                return;
            }
        } catch (e) {}

        // 定期フルリフレッシュ: バックグラウンド処理のステータス変更を反映
        if (pollCount % FULL_REFRESH_EVERY === 0) {
            const sid = currentSessionId || (knownSessions.length > 0 ? knownSessions[0] : '');
            const fullParams = new URLSearchParams({ action: 'get_recent_screens', limit: '10000' });
            if (game) fullParams.set('game', game);
            if (sid) fullParams.set('session_id', sid);
            try {
                const res = await fetch(API_BASE + '?' + fullParams);
                const data = await res.json();
                allScreens = data.screens || [];
                if (allScreens.length > 0) {
                    maxId = Math.max(...allScreens.map(s => s.id));
                }
                renderAll();
            } catch (e) {}
            return;
        }

        // 差分ポーリング: 新規画像のみ取得
        const sid = currentSessionId || (knownSessions.length > 0 ? knownSessions[0] : '');
        const params = new URLSearchParams({
            action: 'get_recent_screens',
            limit: '100',
            after_id: String(maxId),
        });
        if (game) params.set('game', game);
        if (sid) params.set('session_id', sid);
        try {
            const res = await fetch(API_BASE + '?' + params);
            const data = await res.json();
            const newScreens = data.screens || [];
            if (newScreens.length > 0) {
                allScreens = newScreens.concat(allScreens);
                maxId = Math.max(maxId, Math.max(...newScreens.map(s => s.id)));
                if (modalIdx >= 0) {
                    modalIdx += newScreens.length;
                    document.getElementById('modal-counter').textContent =
                        (allScreens.length - modalIdx) + ' / ' + allScreens.length;
                    updateModalNav();
                }
                renderAll();
            }
        } catch (e) {}
    }


    // --- Final タブ ---
    async function fetchFinal() {
        const game = getGameParam();
        const params = new URLSearchParams({ action: 'get_final_screens', limit: '10000' });
        if (game) params.set('game', game);
        try {
            const res = await fetch(API_BASE + '?' + params);
            const data = await res.json();
            allScreens = data.screens || [];
            renderAll();
        } catch (e) {
            grid.innerHTML = '<div class="col-span-full text-center text-red-500 py-12">API エラー</div>';
        }
    }

    // --- タブ切り替え ---
    window.switchTab = function(tab) {
        currentTab = tab;
        allScreens = [];
        maxId = 0;

        // タブボタンのスタイル更新
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.remove('border-brand', 'text-brand-light');
            btn.classList.add('border-transparent', 'text-gray-500');
        });
        const activeBtn = document.getElementById('tab-' + tab);
        activeBtn.classList.remove('border-transparent', 'text-gray-500');
        activeBtn.classList.add('border-brand', 'text-brand-light');

        // ステータス表示切り替え
        const statusDot = document.getElementById('status-dot');
        const statusText = document.getElementById('status-text');

        // ポーリング制御
        if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }

        if (tab === 'live') {
            statusDot.classList.remove('hidden');
            statusText.textContent = '自動更新中';
            filterSelect.classList.remove('hidden');
            sessionSelect.classList.remove('hidden');
            grid.innerHTML = '<div class="col-span-full text-center text-gray-600 py-12">読み込み中...</div>';
            fetchLiveInitial();
            pollTimer = setInterval(pollLive, POLL_INTERVAL);
        } else {
            statusDot.classList.add('hidden');
            statusText.textContent = '決定版';
            filterSelect.classList.add('hidden');
            sessionSelect.classList.add('hidden');
            grid.innerHTML = '<div class="col-span-full text-center text-gray-600 py-12">読み込み中...</div>';
            fetchFinal();
        }
    };

    // --- ハートビート ---
    function heartbeat() {
        fetch(API_BASE + '?action=heartbeat').catch(function() {});
    }

    // --- 初期化 ---
    fetchLiveInitial();
    heartbeat();
    pollTimer = setInterval(pollLive, POLL_INTERVAL);
    setInterval(heartbeat, 10000);

    // --- モーダル ---
    // allScreens は新しい順（idx=0 が最新）。
    // ← = 古い方向 (idx+1)、→ = 新しい方向 (idx-1)
    let modalIdx = -1;

    function showModal(idx) {
        if (idx < 0 || idx >= allScreens.length) return;
        modalIdx = idx;
        const s = allScreens[idx];
        const chronoPos = allScreens.length - idx; // 時系列での位置（1 = 最古）
        const isThinned = s.cluster_id !== null && s.cluster_id !== undefined && !s.is_representative;
        const titlePrefix = isThinned ? '[不採用] ' : '';
        document.getElementById('modal-title').textContent = titlePrefix + (s.name || 'Unknown');
        document.getElementById('modal-img').src = s.screenshot_path ? imgUrl(s.screenshot_path) : '';
        document.getElementById('modal-ocr').textContent = s.ocr_text || '(OCR テキストなし)';
        document.getElementById('modal-scene').textContent = s.category || '';
        document.getElementById('modal-fp').textContent = 'fp: ' + (s.screen_hash || '');
        document.getElementById('modal-time').textContent = s.last_seen_at || '';
        document.getElementById('modal-counter').textContent = chronoPos + ' / ' + allScreens.length;
        updateModalNav();
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function updateModalNav() {
        if (modalIdx < 0) return;
        // ← 古い方向 (idx+1 が存在するか)
        document.getElementById('modal-prev').style.visibility = modalIdx < allScreens.length - 1 ? 'visible' : 'hidden';
        // → 新しい方向 (idx-1 が存在するか、または idx==0 で新着が来る可能性)
        document.getElementById('modal-next').style.visibility = modalIdx > 0 ? 'visible' : 'hidden';
    }

    function closeModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modalIdx = -1;
    }

    grid.addEventListener('click', function(e) {
        const card = e.target.closest('[data-idx]');
        if (!card) return;
        showModal(parseInt(card.dataset.idx, 10));
    });

    // ← 古い画像へ (idx が大きい方)
    document.getElementById('modal-prev').addEventListener('click', function(e) {
        e.stopPropagation();
        if (modalIdx < allScreens.length - 1) showModal(modalIdx + 1);
    });
    // → 新しい画像へ (idx が小さい方)
    document.getElementById('modal-next').addEventListener('click', function(e) {
        e.stopPropagation();
        if (modalIdx > 0) showModal(modalIdx - 1);
    });

    modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
    });
    document.getElementById('modal-close-btn').addEventListener('click', closeModal);
    document.addEventListener('keydown', function(e) {
        if (!modal.classList.contains('flex')) return;
        if (e.key === 'Escape') closeModal();
        // ← 古い方向、→ 新しい方向
        if (e.key === 'ArrowLeft' && modalIdx < allScreens.length - 1) showModal(modalIdx + 1);
        if (e.key === 'ArrowRight' && modalIdx > 0) showModal(modalIdx - 1);
    });
})();
</script>
{% endblock %}
