{% extends "layout.html.twig" %}

{% block title %}Dashboard — LudusCartographer{% endblock %}

{% block content %}
<!-- ヘッダー+タブ (sticky) -->
<div id="dashboard-sticky" class="sticky top-0 z-40 bg-gray-950 pb-2" style="margin: -2rem calc(-50vw + 50%) 0; padding: 1rem calc(50vw - 50%) 0;">
<div class="flex items-center justify-between mb-2">
    <h2 class="text-2xl font-bold text-brand-light">Dashboard</h2>
</div>

<!-- タブ -->
<div class="flex items-center gap-1 mb-0 border-b border-gray-800">
    <button id="tab-live" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-brand text-brand-light"
            onclick="switchTab('live')">
        Live
    </button>
    <button id="tab-final" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-300"
            onclick="switchTab('final')">
        Final
    </button>
    <button id="tab-merge" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-300"
            onclick="switchTab('merge')">
        Merge
    </button>
    <select id="filter-select" class="ml-3 bg-gray-800 text-gray-300 text-xs rounded px-2 py-1 border border-gray-700 focus:border-brand outline-none">
        <option value="reps" selected>採用</option>
        <option value="all">すべて</option>
        <option value="thinned">不採用</option>
        <option value="pending">未処理</option>
    </select>
    <select id="sort-select" class="ml-1 bg-gray-800 text-gray-300 text-xs rounded px-2 py-1 border border-gray-700 focus:border-brand outline-none">
        <option value="desc" selected>降順</option>
        <option value="asc">昇順</option>
    </select>
    <select id="session-select" class="ml-1 bg-gray-800 text-gray-300 text-xs rounded px-2 py-1 border border-gray-700 focus:border-brand outline-none">
        <option value="">最新セッション</option>
    </select>
    <!-- Final 採用/不採用アクション (右詰) -->
    <div class="ml-auto flex items-center gap-2">
        <div id="status" class="flex items-center gap-2">
            <span id="status-dot" class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            <span id="status-text" class="text-xs text-gray-500">自動更新中</span>
        </div>
    </div>
    <div id="final-actions" class="hidden ml-auto flex items-center gap-2">
        <span id="final-select-count" class="text-xs text-gray-400"></span>
        <button id="final-merge-group-btn" class="px-3 py-1 bg-blue-700 hover:bg-blue-600 text-white text-xs font-bold rounded transition-colors disabled:opacity-50 disabled:cursor-not-allowed" disabled>統合</button>
        <button id="final-adopt-btn" class="px-3 py-1 bg-green-700 hover:bg-green-600 text-white text-xs font-bold rounded transition-colors disabled:opacity-50 disabled:cursor-not-allowed" disabled>採用</button>
        <button id="final-exclude-btn" class="px-3 py-1 bg-gray-600 hover:bg-gray-500 text-white text-xs rounded transition-colors disabled:opacity-50 disabled:cursor-not-allowed" disabled>不採用</button>
        <button id="final-reset-btn" class="px-3 py-1 bg-gray-700 hover:bg-gray-600 text-gray-300 text-xs rounded transition-colors disabled:opacity-50 disabled:cursor-not-allowed" disabled>リセット</button>
    </div>
</div>
</div>

<!-- 確認ポップアップ -->
<div id="confirm-popup" class="fixed inset-0 bg-black/70 z-[60] hidden items-center justify-center p-4">
    <div id="confirm-inner" class="bg-gray-900 rounded-xl border border-gray-700 max-w-4xl min-w-[26rem] max-h-[80vh] overflow-auto p-6" onclick="event.stopPropagation()">
        <h3 class="text-lg font-bold text-brand-light mb-4">変更確認</h3>
        <div id="confirm-body" class="space-y-3 mb-6"></div>
        <div class="flex justify-end gap-3">
            <button id="confirm-cancel" class="px-4 py-1.5 bg-gray-700 hover:bg-gray-600 text-gray-300 text-sm rounded">キャンセル</button>
            <button id="confirm-ok" class="px-4 py-1.5 bg-green-700 hover:bg-green-600 text-white text-sm font-bold rounded">更新</button>
        </div>
    </div>
</div>

<!-- 画像プレビュー (確認ポップアップ上) -->
<div id="preview-overlay" class="fixed inset-0 bg-black/80 z-[70] hidden items-start justify-center p-4 pt-8" onclick="this.classList.add('hidden');this.classList.remove('flex');">
    <div class="bg-gray-900 rounded-xl border border-gray-700 max-w-4xl w-full" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center p-4 border-b border-gray-800">
            <h3 id="preview-title" class="text-lg font-bold text-brand-light truncate"></h3>
            <button onclick="document.getElementById('preview-overlay').classList.add('hidden');document.getElementById('preview-overlay').classList.remove('flex');" class="text-gray-500 hover:text-white text-2xl">&times;</button>
        </div>
        <div class="p-4">
            <img id="preview-img" src="" class="w-full rounded-lg bg-gray-800 mb-4" />
            <div id="preview-ocr" class="bg-gray-800 rounded-lg px-3 pb-4 pt-2 text-sm text-gray-300 whitespace-pre-wrap h-[5.5rem] overflow-y-auto" style="-webkit-mask-image:linear-gradient(to bottom,black 70%,transparent 100%);mask-image:linear-gradient(to bottom,black 70%,transparent 100%);"></div>
            <div class="mt-3 flex gap-4 text-xs text-gray-600">
                <span id="preview-scene"></span>
                <span id="preview-fp" class="font-mono"></span>
                <span id="preview-time"></span>
            </div>
        </div>
    </div>
</div>

<!-- グリッド (Live / Final) -->
<div id="grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 mt-4 pb-10">
    <div class="col-span-full text-center text-gray-600 py-12">読み込み中...</div>
</div>

<!-- Merge タブ用コンテナ -->
<div id="merge-container" class="hidden"></div>

<!-- 固定フッター (画面数) -->
<div id="dashboard-footer" class="fixed bottom-0 left-0 right-0 z-30 bg-gray-900/90 border-t border-gray-800 py-1.5">
    <div class="max-w-7xl mx-auto px-4 flex justify-end">
        <span id="stats" class="text-xs text-gray-500"></span>
    </div>
</div>

<!-- モーダル -->
<div id="modal" class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center p-4">
    <div class="flex items-center gap-3 max-w-4xl w-full">
        <button id="modal-prev" class="flex-shrink-0 w-10 h-10 rounded-full bg-gray-700/80 hover:bg-gray-600 text-white text-xl flex items-center justify-center transition-colors" title="前へ (←)">&#8249;</button>
        <div class="bg-gray-900 rounded-xl flex-1 min-w-0 border border-gray-700" onclick="event.stopPropagation()">
            <div class="flex justify-between items-center p-4 border-b border-gray-800">
                <div class="flex items-center gap-3 min-w-0">
                    <span id="modal-counter" class="text-xs text-gray-500 flex-shrink-0"></span>
                    <span id="modal-scene-badge" class="inline-block px-2 py-0.5 text-xs font-medium rounded bg-gray-700 text-gray-400 flex-shrink-0"></span>
                    <h3 id="modal-title" class="text-lg font-bold text-brand-light truncate"></h3>
                </div>
                <button id="modal-close-btn" class="text-gray-500 hover:text-white text-2xl flex-shrink-0 ml-4">&times;</button>
            </div>
            <div class="p-4">
                <img id="modal-img" src="" class="w-full rounded-lg bg-gray-800 mb-4" />
                <div class="relative">
                    <div id="modal-ocr" class="bg-gray-800 rounded-lg px-3 py-2 pr-10 text-sm text-gray-300 whitespace-pre-wrap overflow-y-scroll leading-5 h-[3.5rem]"></div>
                    <button id="modal-ocr-copy" class="group absolute top-2 right-2 w-6 h-6 rounded bg-gray-700 hover:bg-gray-600 text-gray-400 hover:text-white text-xs flex items-center justify-center transition-colors">&#x2398;<span class="hidden group-hover:block absolute right-8 top-0 whitespace-nowrap bg-gray-900 text-gray-300 text-[10px] px-2 py-1 rounded shadow-lg border border-gray-700">クリップボードにコピー</span></button>
                </div>
                <div class="mt-3 flex gap-4 text-xs text-gray-600">
                    <span id="modal-scene"></span>
                    <span id="modal-fp" class="font-mono"></span>
                    <span id="modal-time"></span>
                </div>
                <!-- クラスタ兄弟 (Final タブのみ) -->
                <div id="modal-cluster" class="hidden mt-4">
                    <div class="flex items-center justify-between mb-2">
                        <h4 class="text-xs font-bold text-gray-400">同クラスタの画像</h4>
                        <button id="cluster-promote-btn" class="px-3 py-1 bg-green-700 hover:bg-green-600 text-white text-xs font-bold rounded transition-colors disabled:opacity-50 disabled:cursor-not-allowed hidden" disabled>変更</button>
                    </div>
                    <div id="modal-cluster-grid" class="grid grid-cols-4 sm:grid-cols-6 gap-2 min-h-[5rem]"></div>
                </div>
            </div>
        </div>
        <button id="modal-next" class="flex-shrink-0 w-10 h-10 rounded-full bg-gray-700/80 hover:bg-gray-600 text-white text-xl flex items-center justify-center transition-colors" title="次へ (→)">&#8250;</button>
    </div>
</div>

<script>
(function() {
    // グローバルヘッダーを Dashboard sticky 内に移動（一体化）
    const _gh = document.getElementById('global-header');
    const _ds = document.getElementById('dashboard-sticky');
    if (_gh && _ds) { _ds.insertBefore(_gh, _ds.firstChild); }

    const POLL_INTERVAL = 3000;
    const API_BASE = 'api/search.php';
    const grid = document.getElementById('grid');
    const stats = document.getElementById('stats');
    const modal = document.getElementById('modal');
    let allScreens = [];
    let filteredScreens = [];  // フィルタ済み配列 (モーダルナビもこれを使う)
    let maxId = 0;
    let currentTab = 'live';
    let pollTimer = null;
    let currentSessionId = '';  // 空=最新セッション
    let pollCount = 0;
    const FULL_REFRESH_EVERY = 5;  // 5回に1回フルリフレッシュ (ステータス更新反映)
    let knownSessions = [];
    let pendingChanges = {};  // Final タブ: master_fp → target user_excluded
    let selectedForGroup = new Set();  // Final タブ: 統合選択中の master_fp
    const filterSelect = document.getElementById('filter-select');
    const sessionSelect = document.getElementById('session-select');
    const sortSelect = document.getElementById('sort-select');
    filterSelect.addEventListener('change', renderAll);
    sortSelect.addEventListener('change', renderAll);
    sessionSelect.addEventListener('change', function() {
        currentSessionId = this.value;
        allScreens = [];
        maxId = 0;
        fetchLiveInitial();
    });

    function getGameParam() {
        return new URLSearchParams(window.location.search).get('game') || '';
    }

    function imgUrl(path) {
        if (!path) return '';
        return 'img.php?path=' + encodeURIComponent(path);
    }

    function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function renderCard(s, idx) {
        const thumb = s.thumbnail_path ? imgUrl(s.thumbnail_path) : (s.screenshot_path ? imgUrl(s.screenshot_path) : '');
        const ocrPreview = (s.ocr_text || '').substring(0, 80);
        const sceneBadge = s.category && s.category !== 'depth=0'
            ? `<span class="inline-block px-1.5 py-0.5 text-[9px] rounded bg-gray-800 text-gray-400">${escapeHtml(s.category)}</span>`
            : '';
        const isThinned = s.cluster_id !== null && s.cluster_id !== undefined && !s.is_representative;
        const dots = [];
        if (isThinned) dots.push('<span class="w-1.5 h-1.5 rounded-full bg-gray-500" title="不採用"></span>');
        if (s.has_hq_ocr) dots.push('<span class="w-1.5 h-1.5 rounded-full bg-sky-500" title="HQ OCR済"></span>');
        if (s.is_representative) dots.push('<span class="w-1.5 h-1.5 rounded-full bg-emerald-500" title="採用"></span>');
        const statusDots = dots.length ? `<span class="flex gap-0.5 items-center">${dots.join('')}</span>` : '';
        const dimClass = (isThinned && filterSelect.value === 'all') ? ' opacity-40' : '';
        // ペンディング変更を考慮した表示状態
        const hasPending = s.master_fp && (s.master_fp in pendingChanges);
        const effectiveExcluded = hasPending ? pendingChanges[s.master_fp] : s.user_excluded;
        const pendingMark = hasPending ? ' ring-2 ring-yellow-500/50' : '';
        const isGroupSelected = currentTab === 'final' && s.master_fp && selectedForGroup.has(s.master_fp);
        const groupSelectMark = isGroupSelected ? ' ring-2 ring-blue-500' : '';
        const excludedBorder = '';
        const excludedOpacity = effectiveExcluded ? ' opacity-30' : '';
        return `
            <div class="bg-gray-900 border border-gray-800 rounded-lg overflow-hidden cursor-pointer relative
                        hover:border-brand/50 hover:shadow-lg hover:shadow-brand/10 transition-all${dimClass}${excludedBorder}${pendingMark}${groupSelectMark}"
                 data-idx="${idx}">
                <div class="${excludedOpacity}">
                ${thumb
                    ? `<img src="${thumb}" class="w-full aspect-video object-cover bg-gray-800" loading="lazy" />`
                    : `<div class="w-full aspect-video bg-gray-800 flex items-center justify-center text-3xl">📱</div>`
                }
                <div class="p-2">
                    <p class="text-xs font-semibold text-gray-200 truncate">${escapeHtml(s.name && s.name !== '(UNKNOWN)' ? s.name : '')}</p>
                    <p class="text-[10px] text-gray-500 truncate mt-0.5">${escapeHtml(ocrPreview)}</p>
                    <div class="flex items-center justify-between mt-1">
                        <div class="flex items-center gap-1.5">${sceneBadge}${statusDots}</div>
                        <span class="text-[10px] text-gray-600">${escapeHtml(s.last_seen_at || '')}</span>
                    </div>
                </div>
                </div>
            </div>
        `;
    }

    function renderAll() {
        const filter = filterSelect.value;
        let filtered = allScreens;
        if (currentTab === 'final') {
            // Final: 除外済みはフィルタで切替
            if (!showExcluded) {
                filtered = allScreens.filter(s => !s.user_excluded);
            }
        } else if (filter === 'reps') {
            filtered = allScreens.filter(s => s.is_representative || s.cluster_id === null || s.cluster_id === undefined);
        } else if (filter === 'thinned') {
            filtered = allScreens.filter(s => s.cluster_id !== null && s.cluster_id !== undefined && !s.is_representative);
        } else if (filter === 'pending') {
            filtered = allScreens.filter(s => (s.cluster_id === null || s.cluster_id === undefined) || (s.is_representative && !s.has_hq_ocr));
        }
        // ソート: Live は API が降順(新しい順)、Final は API が昇順(古い順)
        const wantDesc = sortSelect.value === 'desc';
        if (currentTab === 'final' && wantDesc) {
            filtered = [...filtered].reverse();
        } else if (currentTab === 'final' && !wantDesc) {
            // そのまま (API が昇順)
        } else if (currentTab === 'live' && !wantDesc) {
            filtered = [...filtered].reverse();
        }
        // Live + desc → そのまま (API が降順)
        filteredScreens = filtered;
        if (filtered.length === 0) {
            const msg = currentTab === 'live'
                ? 'まだスクリーンが記録されていません。<br><code class="text-brand-light">auto_pilot.py -S</code> で起動してください。'
                : 'まだ決定版がありません。<br>バッチプロセッサを実行してください。';
            grid.innerHTML = `<div class="col-span-full text-center text-gray-600 py-12">${msg}</div>`;
            return;
        }
        grid.innerHTML = filtered.map((s, i) => renderCard(s, i)).join('');
        const repsCount = allScreens.filter(s => s.is_representative).length;
        stats.textContent = filter === 'all'
            ? `${allScreens.length} 画面 (代表 ${repsCount})`
            : `${filtered.length} 画面`;
    }

    // --- セッション一覧取得 ---
    async function fetchSessions() {
        const game = getGameParam();
        const params = new URLSearchParams({ action: 'get_sessions' });
        if (game) params.set('game', game);
        try {
            const res = await fetch(API_BASE + '?' + params);
            const data = await res.json();
            knownSessions = (data.sessions || []).map(s => s.session_dir);
            sessionSelect.innerHTML = '<option value="">最新セッション</option>';
            const older = (data.sessions || []).slice(1); // 最新を除外
            for (const s of older) {
                const label = s.session_dir.replace('ap_', '').replace(/_/g, ' ');
                sessionSelect.innerHTML += `<option value="${escapeHtml(s.session_dir)}">${escapeHtml(label)}</option>`;
            }
        } catch (e) {}
    }

    // --- Live タブ ---
    async function fetchLiveInitial() {
        await fetchSessions();
        // 「最新セッション」(value='') → 最新セッションIDで API を呼ぶ
        const sid = currentSessionId || (knownSessions.length > 0 ? knownSessions[0] : '');
        const game = getGameParam();
        const params = new URLSearchParams({ action: 'get_recent_screens', limit: '10000' });
        if (game) params.set('game', game);
        if (sid) params.set('session_id', sid);
        try {
            const res = await fetch(API_BASE + '?' + params);
            const data = await res.json();
            allScreens = data.screens || [];
            if (allScreens.length > 0) {
                maxId = Math.max(...allScreens.map(s => s.id));
            }
            renderAll();
        } catch (e) {
            grid.innerHTML = '<div class="col-span-full text-center text-red-500 py-12">API エラー</div>';
        }
    }

    async function pollLive() {
        pollCount++;
        // 新しいセッションが始まったか確認
        const game = getGameParam();
        const sessParams = new URLSearchParams({ action: 'get_sessions' });
        if (game) sessParams.set('game', game);
        try {
            const sessRes = await fetch(API_BASE + '?' + sessParams);
            const sessData = await sessRes.json();
            const latestSessions = (sessData.sessions || []).map(s => s.session_dir);
            if (latestSessions.length > 0 && latestSessions[0] !== knownSessions[0]) {
                knownSessions = latestSessions;
                sessionSelect.innerHTML = '<option value="">最新セッション</option>';
                const olderPoll = (sessData.sessions || []).slice(1);
                for (const s of olderPoll) {
                    const label = s.session_dir.replace('ap_', '').replace(/_/g, ' ');
                    sessionSelect.innerHTML += `<option value="${escapeHtml(s.session_dir)}">${escapeHtml(label)}</option>`;
                }
                currentSessionId = '';
                sessionSelect.value = '';
                allScreens = [];
                maxId = 0;
                pollCount = 0;
                fetchLiveInitial();
                return;
            }
        } catch (e) {}

        // 定期フルリフレッシュ: バックグラウンド処理のステータス変更を反映
        if (pollCount % FULL_REFRESH_EVERY === 0) {
            const sid = currentSessionId || (knownSessions.length > 0 ? knownSessions[0] : '');
            const fullParams = new URLSearchParams({ action: 'get_recent_screens', limit: '10000' });
            if (game) fullParams.set('game', game);
            if (sid) fullParams.set('session_id', sid);
            try {
                const _modalScreenId = modalIdx >= 0 && filteredScreens[modalIdx] ? filteredScreens[modalIdx].id : null;
                const res = await fetch(API_BASE + '?' + fullParams);
                const data = await res.json();
                allScreens = data.screens || [];
                if (allScreens.length > 0) {
                    maxId = Math.max(...allScreens.map(s => s.id));
                }
                renderAll();
                // モーダル表示中は画面IDで位置を復元
                if (_modalScreenId !== null) {
                    const restored = filteredScreens.findIndex(s => s.id === _modalScreenId);
                    if (restored >= 0) {
                        modalIdx = restored;
                        document.getElementById('modal-counter').textContent =
                            (filteredScreens.length - modalIdx) + ' / ' + filteredScreens.length;
                        updateModalNav();
                    }
                }
            } catch (e) {}
            return;
        }

        // 差分ポーリング: 新規画像のみ取得
        const sid = currentSessionId || (knownSessions.length > 0 ? knownSessions[0] : '');
        const params = new URLSearchParams({
            action: 'get_recent_screens',
            limit: '100',
            after_id: String(maxId),
        });
        if (game) params.set('game', game);
        if (sid) params.set('session_id', sid);
        try {
            const res = await fetch(API_BASE + '?' + params);
            const data = await res.json();
            const newScreens = data.screens || [];
            if (newScreens.length > 0) {
                allScreens = newScreens.concat(allScreens);
                maxId = Math.max(maxId, Math.max(...newScreens.map(s => s.id)));
                if (modalIdx >= 0) {
                    // 画面IDで位置を復元 (参照が変わっても追跡可能)
                    const _curId = filteredScreens[modalIdx] ? filteredScreens[modalIdx].id : null;
                    renderAll();
                    if (_curId !== null) {
                        const newIdx = filteredScreens.findIndex(s => s.id === _curId);
                        if (newIdx >= 0) {
                            modalIdx = newIdx;
                            document.getElementById('modal-counter').textContent =
                                (filteredScreens.length - modalIdx) + ' / ' + filteredScreens.length;
                            updateModalNav();
                        }
                    }
                    return;
                }
                renderAll();
            }
        } catch (e) {}
    }


    // --- Final タブ ---
    let showExcluded = false;
    async function fetchFinal() {
        const game = getGameParam();
        const params = new URLSearchParams({ action: 'get_final_screens_all', limit: '10000' });
        if (game) params.set('game', game);
        try {
            const res = await fetch(API_BASE + '?' + params);
            const data = await res.json();
            allScreens = data.screens || [];
            renderAll();
        } catch (e) {
            grid.innerHTML = '<div class="col-span-full text-center text-red-500 py-12">API エラー</div>';
        }
    }


    // --- タブ切り替え ---
    window.switchTab = function(tab) {
        currentTab = tab;
        allScreens = [];
        maxId = 0;
        // URL hash にタブを保存
        const url = new URL(window.location);
        url.searchParams.set('tab', tab);
        history.replaceState(null, '', url);

        // タブボタンのスタイル更新
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.remove('border-brand', 'text-brand-light');
            btn.classList.add('border-transparent', 'text-gray-500');
        });
        const activeBtn = document.getElementById('tab-' + tab);
        activeBtn.classList.remove('border-transparent', 'text-gray-500');
        activeBtn.classList.add('border-brand', 'text-brand-light');

        // ステータス表示切り替え
        const statusDot = document.getElementById('status-dot');
        const statusText = document.getElementById('status-text');

        // ポーリング制御
        if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }

        const mergeContainer = document.getElementById('merge-container');
        const finalActions = document.getElementById('final-actions');
        pendingChanges = {};
        selectedForGroup.clear();
        updateFinalActionBar();
        if (tab === 'live') {
            finalActions.classList.add('hidden');
            statusDot.classList.remove('hidden');
            statusText.textContent = '自動更新中';
            filterSelect.classList.remove('hidden');
            filterSelect.innerHTML = '<option value="reps" selected>採用</option><option value="all">すべて</option><option value="thinned">不採用</option><option value="pending">未処理</option>';
            filterSelect.onchange = renderAll;
            sessionSelect.classList.remove('hidden');
            sortSelect.classList.remove('hidden');
            grid.classList.remove('hidden');
            mergeContainer.classList.add('hidden');
            grid.innerHTML = '<div class="col-span-full text-center text-gray-600 py-12">読み込み中...</div>';
            fetchLiveInitial();
            pollTimer = setInterval(pollLive, POLL_INTERVAL);
        } else if (tab === 'final') {
            finalActions.classList.remove('hidden');
            statusDot.classList.add('hidden');
            statusText.textContent = '';
            filterSelect.classList.remove('hidden');
            filterSelect.innerHTML = '<option value="adopted" selected>採用</option><option value="all">すべて</option>';
            filterSelect.onchange = function() { showExcluded = this.value === 'all'; renderAll(); };
            sessionSelect.classList.add('hidden');
            sortSelect.classList.remove('hidden');
            grid.classList.remove('hidden');
            mergeContainer.classList.add('hidden');
            grid.innerHTML = '<div class="col-span-full text-center text-gray-600 py-12">読み込み中...</div>';
            updateGroupSelectUI();
            fetchFinal();
        } else if (tab === 'merge') {
            finalActions.classList.add('hidden');
            statusDot.classList.add('hidden');
            statusText.textContent = '';
            stats.textContent = '';
            filterSelect.classList.add('hidden');
            sessionSelect.classList.add('hidden');
            sortSelect.classList.add('hidden');
            grid.classList.add('hidden');
            mergeContainer.classList.remove('hidden');
            fetchMergeTab();
        }
    };

    // --- Merge タブ ---
    async function fetchMergeTab() {
        const mc = document.getElementById('merge-container');
        mc.innerHTML = '<div class="text-center text-gray-600 py-12">読み込み中...</div>';
        try {
            const res = await fetch(API_BASE + '?action=get_pending_merges');
            const data = await res.json();
            const pending = data.pending || [];
            const merged = data.merged || [];
            let html = '<div class="space-y-6">';
            // 未マージセッション
            html += '<div><h3 class="text-lg font-bold text-brand-light mb-3">未マージセッション</h3>';
            if (pending.length === 0) {
                html += '<p class="text-gray-500 text-sm">マージ待ちのセッションはありません</p>';
            } else {
                html += '<div class="space-y-2">';
                for (const s of pending) {
                    html += `<div class="bg-gray-900 border border-gray-800 rounded-lg p-4 flex items-center justify-between">
                        <div>
                            <span class="text-sm font-mono text-gray-300">${escapeHtml(s.session_id)}</span>
                            <span class="text-xs text-gray-500 ml-3">${s.node_count} ノード / ${s.edge_count} エッジ</span>
                            <span class="text-xs text-gray-600 ml-3">${escapeHtml(s.built_at || '')}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button class="merge-preview-btn px-3 py-1.5 bg-brand/20 hover:bg-brand/40 text-brand-light text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}">プレビュー</button>
                            <button class="delete-session-btn px-2 py-1 bg-red-900/50 hover:bg-red-800 text-red-400 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" data-node-count="${s.node_count}">削除</button>
                        </div>
                    </div>`;
                }
                html += '</div>';
            }
            html += '</div>';
            // マージ済み
            html += '<div><h3 class="text-lg font-bold text-gray-400 mb-3">マージ済み</h3>';
            if (merged.length === 0) {
                html += '<p class="text-gray-600 text-sm">まだマージされたセッションはありません</p>';
            } else {
                html += '<div class="space-y-2">';
                for (const s of merged) {
                    html += `<div class="bg-gray-900/50 border border-gray-800/50 rounded-lg p-3 flex items-center justify-between">
                        <div>
                            <span class="text-sm font-mono text-gray-500">${escapeHtml(s.session_id)}</span>
                            <span class="text-xs text-gray-600 ml-3">${s.mapped_nodes} ノードマッピング済</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-xs text-green-700">完了</span>
                            <button class="delete-session-btn px-2 py-1 bg-red-900/50 hover:bg-red-800 text-red-400 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" data-node-count="${s.mapped_nodes}">削除</button>
                        </div>
                    </div>`;
                }
                html += '</div>';
            }
            html += '</div>';
            // 不要データ整理
            html += '<div><h3 class="text-lg font-bold text-gray-400 mb-3">データ整理</h3>';
            html += '<div id="merge-cleanup-area" class="text-sm text-gray-500">確認中...</div>';
            html += '</div>';
            html += '</div>';
            mc.innerHTML = html;
            // プレビューボタン
            mc.querySelectorAll('.merge-preview-btn').forEach(btn => {
                btn.addEventListener('click', () => showMergePreview(btn.dataset.sessionId));
            });
            // 削除ボタン
            mc.querySelectorAll('.delete-session-btn').forEach(btn => {
                btn.addEventListener('click', () => confirmDeleteSession(btn.dataset.sessionId, btn.dataset.nodeCount));
            });
            // 不要データ整理の件数確認
            checkCleanableInMerge();
        } catch (e) {
            mc.innerHTML = '<div class="text-center text-red-500 py-12">API エラー</div>';
        }
    }

    async function showMergePreview(sessionId) {
        const mc = document.getElementById('merge-container');
        mc.innerHTML = '<div class="text-center text-gray-600 py-12">プレビュー計算中...</div>';
        try {
            const res = await fetch(API_BASE + '?action=preview_merge&session_id=' + encodeURIComponent(sessionId));
            const data = await res.json();
            if (data.error) { mc.innerHTML = `<div class="text-red-500 py-12">${escapeHtml(data.error)}</div>`; return; }
            let html = '<div class="space-y-6">';
            html += `<div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-bold text-brand-light">マージプレビュー: ${escapeHtml(sessionId)}</h3>
                    <p class="text-sm text-gray-400 mt-1">セッション画面: ${data.session_screens} / マスター現状: ${data.master_nodes_before} ノード</p>
                </div>
                <div class="flex gap-2">
                    <button onclick="fetchMergeTab()" class="px-3 py-1.5 bg-gray-700 hover:bg-gray-600 text-gray-300 text-xs rounded">戻る</button>
                    <button id="execute-merge-btn" class="px-4 py-1.5 bg-green-700 hover:bg-green-600 text-white text-sm font-bold rounded">マージ実行</button>
                </div>
            </div>`;
            // サマリー
            const sm = data.summary;
            html += `<div class="flex gap-4 text-sm">
                <span class="px-2 py-1 bg-blue-900/50 rounded text-blue-300">anchor: ${sm.anchor}</span>
                <span class="px-2 py-1 bg-purple-900/50 rounded text-purple-300">k-hop: ${sm.k_hop}</span>
                <span class="px-2 py-1 bg-yellow-900/50 rounded text-yellow-300">transition: ${sm.transition}</span>
                <span class="px-2 py-1 bg-green-900/50 rounded text-green-300">新規: ${sm.new}</span>
            </div>`;
            // マッチ一覧
            if (data.matches.length > 0) {
                html += '<h4 class="text-sm font-bold text-gray-300 mt-4">マッチ一覧</h4>';
                html += '<div class="space-y-3 max-h-[50vh] overflow-auto">';
                for (const m of data.matches) {
                    const methodColor = m.method === 'anchor' ? 'text-blue-400' : m.method === 'k_hop' ? 'text-purple-400' : 'text-yellow-400';
                    html += `<div class="bg-gray-900 border border-gray-800 rounded-lg p-3">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="text-xs font-bold ${methodColor}">${m.method}</span>
                            <span class="text-xs text-gray-500">score: ${m.score}</span>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <p class="text-[10px] text-gray-500 mb-1">セッション</p>
                                <div class="flex items-center gap-2">
                                    ${m.session_thumb ? `<img src="${imgUrl(m.session_thumb)}" class="w-20 h-12 object-cover rounded bg-gray-800" />` : ''}
                                    <span class="text-xs text-gray-300 truncate">${escapeHtml(m.session_title)}</span>
                                </div>
                                ${renderNeighbors(m.session_neighbors)}
                            </div>
                            <div>
                                <p class="text-[10px] text-gray-500 mb-1">マスター</p>
                                <div class="flex items-center gap-2">
                                    ${m.master_thumb ? `<img src="${imgUrl(m.master_thumb)}" class="w-20 h-12 object-cover rounded bg-gray-800" />` : ''}
                                    <span class="text-xs text-gray-300 truncate">${escapeHtml(m.master_title)}</span>
                                </div>
                                ${renderNeighbors(m.master_neighbors)}
                            </div>
                        </div>
                    </div>`;
                }
                html += '</div>';
            }
            // 新規ノード
            if (data.new_nodes.length > 0) {
                html += '<h4 class="text-sm font-bold text-green-400 mt-4">新規追加ノード</h4>';
                html += '<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">';
                for (const n of data.new_nodes) {
                    html += `<div class="bg-gray-900 border border-green-900/50 rounded-lg p-2">
                        ${n.thumb ? `<img src="${imgUrl(n.thumb)}" class="w-full aspect-video object-cover rounded bg-gray-800 mb-1" />` : ''}
                        <p class="text-xs text-gray-300 truncate">${escapeHtml(n.title)}</p>
                        ${renderNeighbors(n.neighbors)}
                    </div>`;
                }
                html += '</div>';
            }
            html += '</div>';
            mc.innerHTML = html;
            document.getElementById('execute-merge-btn').addEventListener('click', () => executeMerge(sessionId));
        } catch (e) {
            mc.innerHTML = '<div class="text-red-500 py-12">プレビュー失敗</div>';
        }
    }

    function renderNeighbors(neighbors) {
        if (!neighbors || neighbors.length === 0) return '';
        const items = neighbors.slice(0, 4).map(n => {
            const arrow = n.direction === 'to' ? '→' : '←';
            return `<span class="text-[9px] text-gray-500">${arrow} ${escapeHtml((n.title || n.fp || '').substring(0, 20))}</span>`;
        });
        return `<div class="flex flex-wrap gap-1 mt-1">${items.join('')}</div>`;
    }

    async function executeMerge(sessionId) {
        const btn = document.getElementById('execute-merge-btn');
        btn.disabled = true;
        btn.textContent = '実行中...';
        try {
            const res = await fetch(API_BASE + '?action=execute_merge&session_id=' + encodeURIComponent(sessionId));
            const data = await res.json();
            if (data.ok) {
                btn.textContent = '完了!';
                btn.classList.replace('bg-green-700', 'bg-gray-700');
                setTimeout(() => fetchMergeTab(), 1500);
            } else {
                btn.textContent = 'エラー: ' + (data.error || '不明');
            }
        } catch (e) {
            btn.textContent = 'エラー';
        }
    }

    function confirmDeleteSession(sessionId, nodeCount) {
        const html = `
            <p class="text-sm text-gray-300 mb-2">セッション <code class="text-brand-light">${escapeHtml(sessionId)}</code> を削除しますか？</p>
            <ul class="text-xs text-gray-400 space-y-1 ml-4 list-disc">
                <li>不採用の画像・スクリーンショットファイルを物理削除</li>
                <li>遷移データ・グループ情報を削除</li>
                <li>採用済み画像（マスターノード参照）は保持</li>
            </ul>
            <p class="text-xs text-red-400 mt-3">この操作は取り消せません。</p>`;
        showConfirmDialog(html, async function() {
            hideConfirmDialog();
            await executeDeleteSession(sessionId);
        });
    }

    async function executeDeleteSession(sessionId) {
        const mc = document.getElementById('merge-container');
        mc.innerHTML = '<div class="text-center text-gray-600 py-12">削除中...</div>';
        try {
            const res = await fetch(API_BASE + '?action=delete_session&session_id=' + encodeURIComponent(sessionId));
            const data = await res.json();
            if (data.ok) {
                mc.innerHTML = `<div class="text-center text-green-500 py-12">
                    削除完了: ${data.deleted_screens} 画面削除, ${data.deleted_files} ファイル削除, ${data.kept_screens} 画面保持
                </div>`;
                setTimeout(() => fetchMergeTab(), 2000);
            } else {
                mc.innerHTML = `<div class="text-center text-red-500 py-12">エラー: ${escapeHtml(data.error || '不明')}</div>`;
            }
        } catch (e) {
            mc.innerHTML = '<div class="text-center text-red-500 py-12">削除失敗</div>';
        }
    }

    async function checkCleanableInMerge() {
        const area = document.getElementById('merge-cleanup-area');
        if (!area) return;
        try {
            const res = await fetch(API_BASE + '?action=get_cleanable_excluded');
            const data = await res.json();
            if (data.count > 0) {
                area.innerHTML = `<div class="flex items-center justify-between bg-gray-900 border border-gray-800 rounded-lg p-4">
                    <div>
                        <span class="text-gray-300">Final で除外済み＋セッション削除済みの画像が ${data.count} 件あります</span>
                        <p class="text-xs text-gray-500 mt-1">マスターノード・エッジ・画像ファイルを完全に削除できます</p>
                    </div>
                    <button id="merge-cleanup-btn" class="px-3 py-1.5 bg-red-900/50 hover:bg-red-800 text-red-400 text-xs rounded transition-colors">削除</button>
                </div>`;
                document.getElementById('merge-cleanup-btn').addEventListener('click', confirmCleanupExcluded);
            } else {
                area.innerHTML = '<p class="text-gray-600 text-sm">整理対象のデータはありません</p>';
            }
        } catch (e) {
            area.innerHTML = '<p class="text-gray-600 text-sm">確認できませんでした</p>';
        }
    }

    async function confirmCleanupExcluded() {
        const res = await fetch(API_BASE + '?action=get_cleanable_excluded');
        const data = await res.json();
        const items = data.items || [];
        if (items.length === 0) return;
        let html = `<p class="text-sm text-gray-300 mb-3">除外済み＋セッション削除済みの ${items.length} 件を完全削除しますか？</p>`;
        html += '<div class="flex flex-wrap justify-center gap-3 max-h-[22rem] overflow-y-auto p-1 confirm-img-area">';
        for (const item of items) {
            const thumb = item.thumbnail_path ? imgUrl(item.thumbnail_path) : '';
            html += _thumbCard(thumb, item.title || '');
        }
        html += '</div>';
        html += '<p class="text-xs text-red-400 mt-3">マスターノード・エッジ・画像ファイルを物理削除します。<br>この操作は取り消せません。</p>';
        showConfirmDialog(html, async function() {
            hideConfirmDialog();
            try {
                const r = await fetch(API_BASE + '?action=cleanup_excluded');
                const result = await r.json();
                if (result.ok) await fetchMergeTab();
            } catch (e) {}
        });
    }

    // --- ハートビート ---
    function heartbeat() {
        fetch(API_BASE + '?action=heartbeat').catch(function() {});
    }

    // --- 初期化 ---
    const initialTab = new URLSearchParams(window.location.search).get('tab') || 'live';
    switchTab(initialTab);
    heartbeat();
    setInterval(heartbeat, 10000);

    // --- モーダル ---
    // allScreens は新しい順（idx=0 が最新）。
    // ← = 古い方向 (idx+1)、→ = 新しい方向 (idx-1)
    let modalIdx = -1;

    function showModal(idx) {
        if (idx < 0 || idx >= filteredScreens.length) return;
        modalIdx = idx;
        const s = filteredScreens[idx];
        const chronoPos = filteredScreens.length - idx;
        const isThinned = s.cluster_id !== null && s.cluster_id !== undefined && !s.is_representative;
        const titlePrefix = isThinned ? '[不採用] ' : '';
        const scene = s.category || 'UNKNOWN';
        const badge = document.getElementById('modal-scene-badge');
        badge.textContent = scene;
        const rawTitle = s.name || '';
        const displayTitle = rawTitle === '(UNKNOWN)' ? '' : rawTitle;
        document.getElementById('modal-title').textContent = titlePrefix + displayTitle;
        document.getElementById('modal-img').src = s.screenshot_path ? imgUrl(s.screenshot_path) : '';
        document.getElementById('modal-ocr').textContent = s.ocr_text || '';
        document.getElementById('modal-scene').textContent = s.category || '';
        document.getElementById('modal-fp').textContent = 'fp: ' + (s.screen_hash || '');
        document.getElementById('modal-time').textContent = s.last_seen_at || '';
        document.getElementById('modal-counter').textContent = chronoPos + ' / ' + filteredScreens.length;
        updateModalNav();
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        // Final タブ: クラスタ兄弟を表示
        const clusterDiv = document.getElementById('modal-cluster');
        const clusterGrid = document.getElementById('modal-cluster-grid');
        if (currentTab === 'final' && s.id) {
            clusterDiv.classList.remove('hidden');
            clusterGrid.innerHTML = '<span class="text-xs text-gray-600">読み込み中...</span>';
            fetchClusterSiblings(s.id, s.master_fp);
        } else {
            clusterDiv.classList.add('hidden');
            clusterGrid.innerHTML = '';
        }
    }

    let _clusterSiblings = [];
    let _clusterSelectedId = null;
    let _clusterOriginalRepId = null;
    let _clusterMasterFp = null;

    async function fetchClusterSiblings(screenId, masterFp) {
        const clusterGrid = document.getElementById('modal-cluster-grid');
        const promoteBtn = document.getElementById('cluster-promote-btn');
        _clusterMasterFp = masterFp;
        _clusterSelectedId = null;
        promoteBtn.disabled = true;
        promoteBtn.classList.add('hidden');
        try {
            const res = await fetch(API_BASE + '?action=get_cluster_siblings&screen_id=' + screenId);
            const data = await res.json();
            _clusterSiblings = data.siblings || [];
            if (_clusterSiblings.length <= 1) {
                clusterGrid.innerHTML = '<span class="text-xs text-gray-600 whitespace-nowrap">クラスタ内に他の画像はありません</span>';
                return;
            }
            _clusterOriginalRepId = (_clusterSiblings.find(s => s.is_representative == 1) || {}).id || null;
            renderClusterGrid();
        } catch (e) {
            clusterGrid.innerHTML = '<span class="text-xs text-red-500">取得エラー</span>';
        }
    }

    function renderClusterGrid() {
        const clusterGrid = document.getElementById('modal-cluster-grid');
        const promoteBtn = document.getElementById('cluster-promote-btn');
        const selectedId = _clusterSelectedId || _clusterOriginalRepId;
        clusterGrid.innerHTML = _clusterSiblings.map(sib => {
            const thumb = sib.thumbnail_path ? imgUrl(sib.thumbnail_path) : (sib.screenshot_path ? imgUrl(sib.screenshot_path) : '');
            const isSelected = sib.id == selectedId;
            const border = isSelected ? 'border-2 border-emerald-500' : 'border border-gray-700 hover:border-brand/50 cursor-pointer';
            return `<div class="cluster-sib ${border} rounded overflow-hidden bg-gray-900" data-sib-id="${sib.id}">
                ${thumb ? `<img src="${thumb}" class="w-full aspect-video object-cover bg-gray-800" loading="lazy" />` : '<div class="w-full aspect-video bg-gray-800"></div>'}
            </div>`;
        }).join('');
        // 選択が代表と異なればボタン有効化
        const isChanged = _clusterSelectedId && _clusterSelectedId != _clusterOriginalRepId;
        promoteBtn.disabled = !isChanged;
        promoteBtn.classList.remove('hidden');
        // タップで選択
        clusterGrid.querySelectorAll('.cluster-sib').forEach(el => {
            el.addEventListener('click', (e) => {
                e.stopPropagation();
                const sibId = parseInt(el.dataset.sibId);
                _clusterSelectedId = sibId;
                // モーダルのメイン画像を選択した画像に切替
                const sib = _clusterSiblings.find(s => s.id == sibId);
                if (sib) {
                    document.getElementById('modal-img').src = sib.screenshot_path ? imgUrl(sib.screenshot_path) : '';
                    document.getElementById('modal-ocr').textContent = sib.ocr_text_hq || sib.ocr_text || '';
                }
                renderClusterGrid();
            });
        });
    }

    document.getElementById('cluster-promote-btn').addEventListener('click', function() {
        if (!_clusterSelectedId || !_clusterMasterFp) return;
        const sib = _clusterSiblings.find(s => s.id == _clusterSelectedId);
        const origSib = _clusterSiblings.find(s => s.id == _clusterOriginalRepId);
        const html = `
            <p class="text-sm text-gray-300 mb-3">代表画像を変更しますか？</p>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-[10px] text-gray-500 mb-1">現在の代表</p>
                    ${origSib && origSib.thumbnail_path ? `<img src="${imgUrl(origSib.thumbnail_path)}" class="w-full aspect-video object-cover rounded bg-gray-800" />` : ''}
                </div>
                <div>
                    <p class="text-[10px] text-emerald-400 mb-1">新しい代表</p>
                    ${sib && sib.thumbnail_path ? `<img src="${imgUrl(sib.thumbnail_path)}" class="w-full aspect-video object-cover rounded bg-gray-800" />` : ''}
                </div>
            </div>`;
        showConfirmDialog(html, async function() {
            hideConfirmDialog();
            try {
                const res = await fetch(API_BASE + '?action=promote_representative&master_fp=' + encodeURIComponent(_clusterMasterFp) + '&screen_id=' + _clusterSelectedId);
                const result = await res.json();
                if (result.ok) {
                    await fetchFinal();
                    if (modalIdx >= 0 && modalIdx < filteredScreens.length) showModal(modalIdx);
                }
            } catch (e) {}
        });
    });

    function updateModalNav() {
        if (modalIdx < 0) return;
        document.getElementById('modal-prev').style.visibility = modalIdx < filteredScreens.length - 1 ? 'visible' : 'hidden';
        document.getElementById('modal-next').style.visibility = modalIdx > 0 ? 'visible' : 'hidden';
    }

    function closeModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modalIdx = -1;
    }

    // --- 除外トグル (ペンディング方式) ---
    function updateFinalActionBar() {
        const adoptBtn = document.getElementById('final-adopt-btn');
        const excludeBtn = document.getElementById('final-exclude-btn');
        const resetBtn = document.getElementById('final-reset-btn');
        const hasSelection = selectedForGroup.size > 0;
        adoptBtn.disabled = !hasSelection;
        excludeBtn.disabled = !hasSelection;
        resetBtn.disabled = !hasSelection;
    }

    function togglePending(masterFp) {
        const item = allScreens.find(s => s.master_fp === masterFp);
        if (!item) return;
        const currentExcluded = item.user_excluded;
        if (masterFp in pendingChanges) {
            // 既にペンディング → 取り消し
            delete pendingChanges[masterFp];
        } else {
            // 反転をペンディングに追加
            pendingChanges[masterFp] = !currentExcluded;
        }
        renderAll();
        updateFinalActionBar();
    }

    function resetPending() {
        pendingChanges = {};
        renderAll();
        updateFinalActionBar();
    }

    // 確認ダイアログの OK ハンドラを設定するユーティリティ
    function showConfirmDialog(bodyHtml, onOk) {
        document.getElementById('confirm-body').innerHTML = bodyHtml;
        const popup = document.getElementById('confirm-popup');
        const okBtn = document.getElementById('confirm-ok');
        // 既存ハンドラをクリア
        const prev = okBtn._currentHandler;
        if (prev) okBtn.removeEventListener('click', prev);
        okBtn._currentHandler = onOk;
        okBtn.addEventListener('click', onOk);
        popup.classList.remove('hidden');
        popup.classList.add('flex');
        // スクロール有無でフェード切替
        requestAnimationFrame(() => {
            document.querySelectorAll('.confirm-img-area').forEach(el => {
                const fade = 'linear-gradient(to bottom,black 85%,transparent 100%)';
                if (el.scrollHeight > el.clientHeight) {
                    el.style.maskImage = fade;
                    el.style.webkitMaskImage = fade;
                } else {
                    el.style.maskImage = 'none';
                    el.style.webkitMaskImage = 'none';
                }
            });
        });
    }

    function hideConfirmDialog() {
        const popup = document.getElementById('confirm-popup');
        popup.classList.add('hidden');
        popup.classList.remove('flex');
    }

    function _thumbCard(thumb, title, opts) {
        const clickable = opts && opts.clickable;
        const dataAttr = opts && opts.dataFp ? ` data-master-fp="${escapeHtml(opts.dataFp)}"` : '';
        const clickCls = clickable ? ' cursor-pointer hover:ring-2 hover:ring-brand/50 confirm-preview-card' : '';
        return `<div class="bg-gray-800 rounded overflow-hidden w-40 flex-shrink-0 transition-all${clickCls}"${dataAttr}>
            ${thumb ? `<img src="${thumb}" class="w-full aspect-video object-cover" />` : '<div class="w-full aspect-video bg-gray-700"></div>'}
            <p class="text-[10px] text-gray-500 p-1.5 truncate">${escapeHtml(title)}</p>
        </div>`;
    }

    function _confirmCard(fp) {
        const item = allScreens.find(s => s.master_fp === fp);
        const thumb = item && item.thumbnail_path ? imgUrl(item.thumbnail_path) : '';
        return _thumbCard(thumb, item ? (item.name || '') : '', { clickable: true, dataFp: fp });
    }

    function showPreviewOverlay(masterFp) {
        const item = allScreens.find(s => s.master_fp === masterFp);
        if (!item) return;
        document.getElementById('preview-title').textContent = item.name || '';
        document.getElementById('preview-img').src = item.screenshot_path ? imgUrl(item.screenshot_path) : '';
        document.getElementById('preview-ocr').textContent = item.ocr_text || '';
        document.getElementById('preview-scene').textContent = item.category || '';
        document.getElementById('preview-fp').textContent = 'fp: ' + (item.screen_hash || '');
        document.getElementById('preview-time').textContent = item.last_seen_at || '';
        const overlay = document.getElementById('preview-overlay');
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
    }

    function showBulkConfirm(action) {
        if (selectedForGroup.size === 0) return;
        const fps = [...selectedForGroup];
        const label = action === 'adopt' ? '採用' : '不採用';
        let html = `<p class="text-sm text-gray-300 mb-2">${fps.length} 件を${label}にします</p>`;
        html += '<div class="flex flex-wrap justify-center gap-3 max-h-[22rem] overflow-y-auto p-1 confirm-img-area">';
        for (const fp of fps) html += _confirmCard(fp);
        html += '</div>';
        showConfirmDialog(html, async function() {
            hideConfirmDialog();
            for (const fp of fps) {
                const item = allScreens.find(s => s.master_fp === fp);
                if (!item) continue;
                const targetExcluded = action === 'exclude';
                if (item.user_excluded !== targetExcluded) {
                    try {
                        await fetch(API_BASE + '?action=toggle_exclude&master_fp=' + encodeURIComponent(fp));
                        item.user_excluded = targetExcluded;
                    } catch (e) {}
                }
            }
            selectedForGroup.clear();
            pendingChanges = {};
            renderAll();
            updateGroupSelectUI();
            updateFinalActionBar();
        });
        document.querySelectorAll('.confirm-preview-card').forEach(card => {
            card.addEventListener('click', function(e) {
                e.stopPropagation();
                showPreviewOverlay(this.dataset.masterFp);
            });
        });
    }

    document.getElementById('final-adopt-btn').addEventListener('click', () => showBulkConfirm('adopt'));
    document.getElementById('final-exclude-btn').addEventListener('click', () => showBulkConfirm('exclude'));
    document.getElementById('final-reset-btn').addEventListener('click', function() {
        resetPending();
        selectedForGroup.clear();
        renderAll();
        updateGroupSelectUI();
        updateFinalActionBar();
    });
    document.getElementById('final-merge-group-btn').addEventListener('click', showMergeGroupDialog);

    function updateGroupSelectUI() {
        const countEl = document.getElementById('final-select-count');
        const mergeBtn = document.getElementById('final-merge-group-btn');
        if (selectedForGroup.size >= 2) {
            countEl.textContent = `${selectedForGroup.size} 件選択中`;
            mergeBtn.disabled = false;
        } else if (selectedForGroup.size === 1) {
            countEl.textContent = '1 件選択中';
            mergeBtn.disabled = true;
        } else {
            countEl.textContent = 'Shift+クリックで選択';
            mergeBtn.disabled = true;
        }
        countEl.classList.remove('hidden');
    }

    function showMergeGroupDialog() {
        if (selectedForGroup.size < 2) return;
        const fps = [...selectedForGroup];
        let html = `<p class="text-sm text-gray-300 mb-3">${fps.length} 件を統合します。代表を選択してください。</p>`;
        html += '<div class="flex flex-wrap justify-center gap-3 max-h-[22rem] overflow-y-auto p-1">';
        for (const fp of fps) {
            const item = allScreens.find(s => s.master_fp === fp);
            const thumb = item && item.thumbnail_path ? imgUrl(item.thumbnail_path) : '';
            html += `<div class="bg-gray-800 rounded overflow-hidden w-40 flex-shrink-0 cursor-pointer hover:ring-2 hover:ring-emerald-500 transition-all group-rep-card" data-master-fp="${escapeHtml(fp)}">
                ${thumb ? `<img src="${thumb}" class="w-full aspect-video object-cover" />` : '<div class="w-full aspect-video bg-gray-700"></div>'}
                <p class="text-[10px] text-gray-500 p-1.5 truncate">${escapeHtml(item ? (item.name || '') : '')}</p>
            </div>`;
        }
        html += '</div>';
        html += '<p class="text-xs text-gray-500 mt-3">クリックで代表を選択</p>';
        showConfirmDialog(html, function() {});  // OK は代表選択後に動的設定
        // 代表選択のクリックハンドラ
        document.querySelectorAll('.group-rep-card').forEach(card => {
            card.addEventListener('click', function(e) {
                e.stopPropagation();
                const repFp = this.dataset.masterFp;
                // 選択状態の表示
                document.querySelectorAll('.group-rep-card').forEach(c => c.classList.remove('ring-2', 'ring-emerald-500'));
                this.classList.add('ring-2', 'ring-emerald-500');
                // OK ハンドラを設定
                const okBtn = document.getElementById('confirm-ok');
                const prev = okBtn._currentHandler;
                if (prev) okBtn.removeEventListener('click', prev);
                const handler = async function() {
                    hideConfirmDialog();
                    const params = new URLSearchParams({
                        action: 'merge_manual_group',
                        master_fps: JSON.stringify(fps),
                        representative_fp: repFp,
                    });
                    try {
                        const res = await fetch(API_BASE + '?' + params);
                        const result = await res.json();
                        if (result.ok) {
                            selectedForGroup.clear();
                            updateGroupSelectUI();
                            await fetchFinal();
                        }
                    } catch (e) {}
                };
                okBtn._currentHandler = handler;
                okBtn.addEventListener('click', handler);
            });
        });
    }
    document.getElementById('confirm-cancel').addEventListener('click', hideConfirmDialog);
    document.getElementById('confirm-popup').addEventListener('click', function(e) {
        if (e.target === this) hideConfirmDialog();
    });

    // グリッドカード外クリックで選択リセット
    document.addEventListener('click', function(e) {
        if (currentTab !== 'final' || selectedForGroup.size === 0) return;
        if (e.target.closest('[data-idx]') || e.target.closest('#final-actions') || e.target.closest('#confirm-popup') || e.target.closest('#modal') || e.target.closest('#preview-overlay')) return;
        selectedForGroup.clear();
        pendingChanges = {};
        renderAll();
        updateGroupSelectUI();
        updateFinalActionBar();
    });

    grid.addEventListener('click', function(e) {
        const card = e.target.closest('[data-idx]');
        if (!card) return;
        // Shift+クリック: 統合選択モード (Final タブのみ)
        if (e.shiftKey && currentTab === 'final') {
            const idx = parseInt(card.dataset.idx, 10);
            const s = filteredScreens[idx];
            if (s && s.master_fp) {
                if (selectedForGroup.has(s.master_fp)) {
                    selectedForGroup.delete(s.master_fp);
                } else {
                    selectedForGroup.add(s.master_fp);
                }
                renderAll();
                updateGroupSelectUI();
                updateFinalActionBar();
            }
            return;
        }
        showModal(parseInt(card.dataset.idx, 10));
    });

    // ← 古い画像へ (idx が大きい方)
    document.getElementById('modal-prev').addEventListener('click', function(e) {
        e.stopPropagation();
        if (modalIdx < filteredScreens.length - 1) showModal(modalIdx + 1);
    });
    // → 新しい画像へ (idx が小さい方)
    document.getElementById('modal-next').addEventListener('click', function(e) {
        e.stopPropagation();
        if (modalIdx > 0) showModal(modalIdx - 1);
    });

    modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
    });
    document.getElementById('modal-close-btn').addEventListener('click', closeModal);
    document.getElementById('modal-ocr-copy').addEventListener('click', function() {
        const text = document.getElementById('modal-ocr').textContent;
        navigator.clipboard.writeText(text);
    });
    document.addEventListener('keydown', function(e) {
        if (!modal.classList.contains('flex')) return;
        if (e.key === 'Escape') closeModal();
        // ← 古い方向、→ 新しい方向
        if (e.key === 'ArrowLeft' && modalIdx < filteredScreens.length - 1) showModal(modalIdx + 1);
        if (e.key === 'ArrowRight' && modalIdx > 0) showModal(modalIdx - 1);
    });
})();
</script>
{% endblock %}
