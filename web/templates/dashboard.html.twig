    window.navigateToFinalSession = async function(sessionId) {
        _debugFilterSession = sessionId;
        switchTab('final');
        // fetchFinal() が switchTab 内で呼ばれ allScreens が設定される。
        // switchTab は非同期ではないが fetchFinal を内部で呼ぶので少し待つ。
        await fetchFinal();
        filterSelect.value = 'session';
        showExcluded = false;
        _debugBuildSessionList();
        _debugFilterSession = sessionId;
        _debugSessionIdx = _debugSessionList.indexOf(sessionId);
        _updateDebugSessionSelect();
        if (_debugSessionSelect) _debugSessionSelect.value = sessionId;
        renderAll();
        syncUrlParams();
    };

