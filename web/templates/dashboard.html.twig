            autoRefreshPaused = false;
            finalActions.classList.add('hidden');
            statusDot.classList.remove('hidden');
            statusDot.classList.remove('bg-gray-500');
            statusDot.classList.add('bg-green-500', 'animate-pulse');
            statusText.textContent = '自動更新中';
            filterSelect.classList.remove('hidden');
            filterSelect.innerHTML = '<option value="reps">採用</option><option value="thinned">不採用</option><option value="pending">未処理</option><option value="all">すべて</option>';
            filterSelect.value = restoreFromUrl ? getUrlParam('filter', 'reps') : 'reps';
            filterSelect.onchange = function() { renderAll(); syncUrlParams(); };
            sessionSelect.classList.remove('hidden');
            sortToggle.classList.remove('hidden');
            grid.classList.remove('hidden');
            mergeContainer.classList.add('hidden');
            grid.innerHTML = '<div class="col-span-full text-center text-gray-600 py-12">読み込み中...</div>';
            syncUrlParams();
            fetchLiveInitial();
            pollTimer = setInterval(pollLive, POLL_INTERVAL);
        } else if (tab === 'final') {
            finalActions.classList.remove('hidden');
