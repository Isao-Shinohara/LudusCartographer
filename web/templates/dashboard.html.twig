    // --- Merge タブ ---
    window.fetchMergeTab = fetchMergeTab;
    const _MERGE_PAGE_SIZE = 5;
    const _mergePages = {};
    function _renderMergeSection(id, items, renderFn) {
        const page = _mergePages[id] || 0;
        const total = items.length;
        const totalPages = Math.ceil(total / _MERGE_PAGE_SIZE);
        const start = page * _MERGE_PAGE_SIZE;
        const pageItems = items.slice(start, start + _MERGE_PAGE_SIZE);
        // ページングが発生する場合のみ高さ固定 (カード約48px + gap 8px = 56px/件)
        const _minH = totalPages > 1 ? ` style="min-height:${_MERGE_PAGE_SIZE * 56}px"` : '';
        let h = `<div id="merge-section-${id}" class="space-y-2"${_minH}>`;
        for (const s of pageItems) h += renderFn(s);
        h += '</div>';
        if (totalPages > 1) {
            h += `<div class="flex items-center mt-2 text-xs">`;
            h += `<div class="flex-1"></div><div class="flex items-center gap-1.5">`;
            h += `<a href="#" class="merge-page-btn px-1.5 py-0.5 rounded ${page > 0 ? 'text-gray-300 hover:text-cyan-300' : 'text-gray-700 pointer-events-none'}" data-section="${id}" data-page="${page - 1}">prev</a>`;
            for (let p = 0; p < totalPages; p++) {
                if (totalPages > 7 && p > 2 && p < totalPages - 2 && Math.abs(p - page) > 1) {
                    if (p === 3 || p === totalPages - 3) h += '<span class="text-gray-600">..</span>';
                    continue;
                }
                h += `<a href="#" class="merge-page-btn px-1.5 py-0.5 rounded ${p === page ? 'bg-cyan-900/50 text-cyan-300' : 'text-gray-400 hover:text-cyan-300'}" data-section="${id}" data-page="${p}">${p + 1}</a>`;
            }
            h += `<a href="#" class="merge-page-btn px-1.5 py-0.5 rounded ${page < totalPages - 1 ? 'text-gray-300 hover:text-cyan-300' : 'text-gray-700 pointer-events-none'}" data-section="${id}" data-page="${page + 1}">next</a>`;
            h += `</div><div class="flex-1 text-right text-gray-600">${total} 件</div>`;
            h += '</div>';
        }
        return h;
    }
    async function fetchMergeTab() {
        const mc = document.getElementById('merge-container');
        mc.innerHTML = '<div class="text-center text-gray-600 py-12">読み込み中...</div>';
        try {
            const mergeParams = new URLSearchParams({ action: 'get_pending_merges' });
            if (_currentVersionId) mergeParams.set('version', _currentVersionId);
            const res = await fetch(API_BASE + '?' + mergeParams);
            const data = await res.json();
            const pending = data.pending || [];
            const merged = data.merged || [];
            const empty = data.empty || [];
            const running = data.running || [];
            const noTransition = data.no_transition || [];
            const bgPending = data.bg_pending || [];
            // 日時フォーマット: 2026/04/14 17:36:20
            const fmtDate = (iso) => {
                if (!iso) return '';
                const d = new Date(iso);
                if (isNaN(d)) return '';
                const Y = d.getFullYear(), M = String(d.getMonth()+1).padStart(2,'0'),
                      D = String(d.getDate()).padStart(2,'0'), h = String(d.getHours()).padStart(2,'0'),
                      m = String(d.getMinutes()).padStart(2,'0'), s = String(d.getSeconds()).padStart(2,'0');
                return `${Y}/${M}/${D} ${h}:${m}:${s}`;
            };
            // completion_type バッジ (完走時はバッジなし、未完走時のみ表示)
            const completionBadge = (ct) => {
                if (ct === 'manual_stop') return '<span class="px-1.5 py-0.5 text-[10px] rounded bg-cyan-900/30 text-cyan-700" title="手動停止（Ctrl+C等）">未完走</span>';
                if (ct === 'orphaned') return '<span class="px-1.5 py-0.5 text-[10px] rounded bg-red-900/30 text-red-600" title="プロセス異常終了">未完走（異常終了）</span>';
                return '';
            };
            let html = '<div class="space-y-6">';
            // 1. マージ完了
            html += '<div><h3 class="text-lg font-bold text-emerald-400 mb-3">✓ マージ完了</h3>';
            if (merged.length === 0) {
                html += '<p class="text-gray-600 text-sm">まだマージされたセッションはありません</p>';
            } else {
                html += _renderMergeSection('merged', merged, (s) => `<div class="bg-gray-900/50 border border-gray-800/50 rounded-lg p-3 flex items-center justify-between">
                        <div>
                            <a href="#" class="text-sm font-mono text-gray-500 hover:text-emerald-300 transition-colors cursor-pointer" onclick="navigateToFinalSession('${escapeHtml(s.session_id)}');return false;">${_currentVersionName ? escapeHtml(_currentVersionName) + ' ' : ''}${escapeHtml(s.session_id)}</a>
                            <span class="text-xs text-gray-400 ml-3">新規 ${s.new_nodes || 0} / アンカー ${s.anchor_nodes || 0}</span>
                            ${completionBadge(s.completion_type)}
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-[11px] text-gray-600">開始 ${fmtDate(s.started_at)}　マージ完了 ${fmtDate(s.built_at)}</span>
                            <button class="unmerge-btn px-3 py-1 bg-cyan-900/50 hover:bg-cyan-800/60 text-cyan-300 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" title="マージを解除して未マージ状態に戻す">Undo</button>
                            <button class="delete-session-btn px-2 py-1 bg-red-900/50 hover:bg-red-800 text-red-400 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" data-node-count="${s.mapped_nodes}">${TRASH_ICON}</button>
                        </div>
                    </div>`);
            }
            html += '</div>';
            // 2. マージ待ち
            // マージ待ちより古いセッションが前工程にあるか検出
            const pendingOldest = pending.length > 0 ? pending[0].started_at : null;
            const olderIncomplete = [];
            if (pendingOldest) {
                for (const s of [...bgPending, ...running, ...noTransition]) {
                    if (s.started_at && s.started_at < pendingOldest) {
                        olderIncomplete.push(s.session_id);
                    }
                }
            }
            html += '<div><div class="flex items-center gap-3 mb-3"><h3 class="text-lg font-bold text-blue-400">マージ待ち</h3>';
            if (olderIncomplete.length > 0) {
                html += `<span class="text-xs text-amber-400">⚠ 古いセッションが未完了: ${olderIncomplete.map(s => escapeHtml(s)).join(', ')}</span>`;
            }
            html += '</div>';
            if (pending.length === 0) {
                html += '<p class="text-gray-500 text-sm">マージ待ちのセッションはありません</p>';
            } else {
                html += _renderMergeSection('pending', pending, (s) => `<div class="bg-gray-900 border border-gray-800 rounded-lg p-4 flex items-center justify-between">
                        <div>
                            <a href="#" class="text-sm font-mono text-gray-300 hover:text-blue-300 transition-colors cursor-pointer" onclick="navigateToLiveSession('${escapeHtml(s.session_id)}');return false;">${_currentVersionName ? escapeHtml(_currentVersionName) + ' ' : ''}${escapeHtml(s.session_id)}</a>
                            <span class="text-xs text-gray-400 ml-3">${s.node_count} ノード / ${(s.tap_edge_count || s.auto_edge_count) ? s.tap_edge_count + ' tap / ' + s.auto_edge_count + ' auto' : s.edge_count + ' エッジ'}</span>
                            ${completionBadge(s.completion_type)}
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-[11px] text-gray-500">開始 ${fmtDate(s.started_at)}${s.built_at ? '　構築完了 ' + fmtDate(s.built_at) : ''}</span>
                            <button class="merge-preview-btn px-3 py-1.5 bg-cyan-900/50 hover:bg-cyan-800/60 text-cyan-300 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" title="マージプレビュー → 実行">マージ</button>
                            <button class="delete-session-btn px-2 py-1 bg-red-900/50 hover:bg-red-800 text-red-400 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" data-node-count="0">${TRASH_ICON}</button>
                        </div>
                    </div>`);
            }
            html += '</div>';
            // 3. バックグラウンド未完了 (古いセッションの後処理待ち)
            html += '<div><h3 class="text-lg font-bold text-slate-400 mb-3">バックグラウンド未完了</h3>';
            if (bgPending.length === 0) {
                html += '<p class="text-gray-600 text-sm">バックグラウンド処理が未完了のセッションはありません</p>';
            } else {
                html += '<p class="text-xs text-gray-500 mb-2">中断された後処理 (Gemini OCR / 間引き / グラフ構築) を「再開」で完了させる。画面なしは削除のみ可能。</p>';
                html += _renderMergeSection('bgPending', bgPending, (s) => {
                    const hasScreens = s.actual_screens > 0;
                    const hasTransitions = (s.transitions || 0) > 0;
                    const canResume = hasScreens && hasTransitions;
                    const noGraphBadge = (s.has_graph || 0) === 0
                        ? '<span class="text-xs text-amber-500 ml-2">グラフ未構築</span>' : '';
                    return `<div class="bg-gray-900/50 border border-slate-700/40 rounded-lg p-3 flex items-center justify-between">
                        <div>
                            <a href="#" class="text-sm font-mono text-slate-300 hover:text-blue-300 transition-colors cursor-pointer" onclick="navigateToLiveSession('${escapeHtml(s.session_id)}');return false;">${_currentVersionName ? escapeHtml(_currentVersionName) + ' ' : ''}${escapeHtml(s.session_id)}</a>
                            ${completionBadge(s.completion_type)}
                            <span class="text-xs text-gray-500 ml-3">画面 ${s.actual_screens} 件</span>
                            ${s.pending_gemini > 0 ? `<span class="text-xs text-amber-500 ml-2">OCR ${s.pending_gemini} 件</span>` : ''}
                            ${s.pending_dedup > 0 ? `<span class="text-xs text-emerald-500 ml-2">間引き ${s.pending_dedup} 件</span>` : ''}
                            ${noGraphBadge}
                        </div>
                        <div class="flex items-center gap-2">
                            ${canResume ? `<button class="bg-process-btn px-3 py-1 bg-cyan-900/50 hover:bg-cyan-800/60 text-cyan-300 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" title="後処理 (OCR + 間引き + グラフ構築) を再開">再開</button>` : ''}
                            <button class="delete-session-btn px-2 py-1 bg-red-900/50 hover:bg-red-800 text-red-400 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" data-node-count="0">${TRASH_ICON}</button>
                        </div>
                    </div>`;
                });
            }
            html += '</div>';
            // 4. 進行中セッション
            html += '<div><h3 class="text-lg font-bold text-violet-400 mb-3">進行中セッション</h3>';
            if (running.length === 0) {
                html += '<p class="text-gray-600 text-sm">実行中のセッションはありません</p>';
            } else {
                html += '<p class="text-xs text-gray-500 mb-2">auto_pilot 実行中のセッション。完了するとマージ待ちに移動。</p>';
                html += _renderMergeSection('running', running, (s) => `<div class="bg-gray-900/50 border border-violet-900/30 rounded-lg p-3 flex items-center justify-between">
                        <div>
                            <a href="#" class="text-sm font-mono text-violet-300 hover:text-blue-300 transition-colors cursor-pointer" onclick="navigateToLiveSession('${escapeHtml(s.session_id)}');return false;">${_currentVersionName ? escapeHtml(_currentVersionName) + ' ' : ''}${escapeHtml(s.session_id)}</a>
                            <span class="text-xs text-gray-500 ml-3">画面 ${s.actual_screens} 件</span>
                            <span class="text-xs text-gray-600 ml-3">${escapeHtml(s.started_at || '')}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="inline-block w-2 h-2 rounded-full bg-violet-400 animate-pulse" title="実行中"></span>
                            <button class="delete-session-btn px-2 py-1 bg-red-900/50 hover:bg-red-800 text-red-400 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" data-node-count="0" data-status="running">${TRASH_ICON}</button>
                        </div>
                    </div>`);
            }
            html += '</div>';
            // 5. 遷移データなし
            html += '<div><h3 class="text-lg font-bold text-gray-500 mb-3">遷移データなし</h3>';
            if (noTransition.length === 0) {
                html += '<p class="text-gray-600 text-sm">遷移データなしのセッションはありません</p>';
            } else {
                html += '<p class="text-xs text-gray-500 mb-2">画面記録はあるがタップ遷移が記録されていないため、グラフ構築・マージ不可。削除のみ可能。</p>';
                html += _renderMergeSection('noTransition', noTransition, (s) => `<div class="bg-gray-900/50 border border-gray-800/50 rounded-lg p-3 flex items-center justify-between">
                        <div>
                            <span class="text-sm font-mono text-gray-400">${_currentVersionName ? escapeHtml(_currentVersionName) + ' ' : ''}${escapeHtml(s.session_id)}</span>
                            ${completionBadge(s.completion_type)}
                            <span class="text-xs text-gray-500 ml-3">画面 ${s.actual_screens} 件・遷移 0 件</span>
                            <span class="text-xs text-gray-600 ml-3">${escapeHtml(s.started_at || '')}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button class="delete-session-btn px-2 py-1 bg-red-900/50 hover:bg-red-800 text-red-400 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" data-node-count="0">${TRASH_ICON}</button>
                        </div>
                    </div>`);
            }
            html += '</div>';
            html += '</div>';
            mc.innerHTML = html;
            // プレビューボタン
            mc.querySelectorAll('.merge-preview-btn').forEach(btn => {
                btn.addEventListener('click', () => showMergePreview(btn.dataset.sessionId));
