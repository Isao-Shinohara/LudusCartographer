    // --- Merge タブ ---
    async function fetchMergeTab() {
        const mc = document.getElementById('merge-container');
        mc.innerHTML = '<div class="text-center text-gray-600 py-12">読み込み中...</div>';
        try {
            const res = await fetch(API_BASE + '?action=get_pending_merges');
            const data = await res.json();
            const pending = data.pending || [];
            const merged = data.merged || [];
            const empty = data.empty || [];
            const running = data.running || [];
            const noTransition = data.no_transition || [];
            const bgPending = data.bg_pending || [];
            // 日時フォーマット: 2026/04/14 17:36:20
            const fmtDate = (iso) => {
                if (!iso) return '';
                const d = new Date(iso);
                if (isNaN(d)) return '';
                const Y = d.getFullYear(), M = String(d.getMonth()+1).padStart(2,'0'),
                      D = String(d.getDate()).padStart(2,'0'), h = String(d.getHours()).padStart(2,'0'),
                      m = String(d.getMinutes()).padStart(2,'0'), s = String(d.getSeconds()).padStart(2,'0');
                return `${Y}/${M}/${D} ${h}:${m}:${s}`;
            };
            // completion_type バッジ (完走時はバッジなし、未完走時のみ表示)
            const completionBadge = (ct) => {
                if (ct === 'manual_stop') return '<span class="px-1.5 py-0.5 text-[10px] rounded bg-cyan-900/30 text-cyan-700" title="手動停止（Ctrl+C等）">未完走</span>';
                if (ct === 'orphaned') return '<span class="px-1.5 py-0.5 text-[10px] rounded bg-red-900/30 text-red-600" title="プロセス異常終了">未完走（異常終了）</span>';
                return '';
            };
            let html = '<div class="space-y-6">';
            // 1. マージ完了
            html += '<div><h3 class="text-lg font-bold text-emerald-400 mb-3">✓ マージ完了</h3>';
            if (merged.length === 0) {
                html += '<p class="text-gray-600 text-sm">まだマージされたセッションはありません</p>';
            } else {
                html += '<div class="space-y-2">';
                for (const s of merged) {
                    html += `<div class="bg-gray-900/50 border border-gray-800/50 rounded-lg p-3 flex items-center justify-between">
                        <div>
                            <span class="text-sm font-mono text-gray-500">${escapeHtml(s.session_id)}</span>
                            <span class="text-xs text-gray-600 ml-3">${s.mapped_nodes} ノードマッピング済</span>
                            ${completionBadge(s.completion_type)}
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-[11px] text-gray-600">開始 ${fmtDate(s.started_at)}　マージ完了 ${fmtDate(s.built_at)}</span>
                            <button class="unmerge-btn px-3 py-1 bg-cyan-900/50 hover:bg-cyan-800/60 text-cyan-300 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" title="マージを解除して未マージ状態に戻す">Undo</button>
                            <button class="delete-session-btn px-2 py-1 bg-red-900/50 hover:bg-red-800 text-red-400 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" data-node-count="${s.mapped_nodes}">${TRASH_ICON}</button>
                        </div>
                    </div>`;
                }
                html += '</div>';
            }
            html += '</div>';
            // 2. マージ待ち
            html += '<div><h3 class="text-lg font-bold text-blue-400 mb-3">マージ待ち</h3>';
            if (pending.length === 0) {
                html += '<p class="text-gray-500 text-sm">マージ待ちのセッションはありません</p>';
            } else {
                html += '<div class="space-y-2">';
                for (const s of pending) {
                    html += `<div class="bg-gray-900 border border-gray-800 rounded-lg p-4 flex items-center justify-between">
                        <div>
                            <span class="text-sm font-mono text-gray-300">${escapeHtml(s.session_id)}</span>
                            <span class="text-xs text-gray-400 ml-3">${s.node_count} ノード / ${s.edge_count} エッジ</span>
                            ${completionBadge(s.completion_type)}
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-[11px] text-gray-500">開始 ${fmtDate(s.started_at)}　構築完了 ${fmtDate(s.built_at)}</span>
                            <button class="merge-preview-btn px-3 py-1.5 bg-cyan-900/50 hover:bg-cyan-800/60 text-cyan-300 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" title="マージプレビュー → 実行">マージ</button>
                            <button class="delete-session-btn px-2 py-1 bg-red-900/50 hover:bg-red-800 text-red-400 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" data-node-count="${s.node_count}">${TRASH_ICON}</button>
                        </div>
                    </div>`;
                }
                html += '</div>';
            }
            html += '</div>';
            // 3. バックグラウンド未完了 (古いセッションの後処理待ち)
            html += '<div><h3 class="text-lg font-bold text-slate-400 mb-3">バックグラウンド未完了</h3>';
            if (bgPending.length === 0) {
                html += '<p class="text-gray-600 text-sm">バックグラウンド処理が未完了のセッションはありません</p>';
            } else {
                html += '<p class="text-xs text-gray-500 mb-2">中断された後処理 (Gemini OCR / 間引き / グラフ構築) を「再開」で完了させる。画面なしは削除のみ可能。</p>';
                html += '<div class="space-y-2">';
                for (const s of bgPending) {
                    const hasScreens = s.actual_screens > 0;
                    const hasTransitions = (s.transitions || 0) > 0;
                    const canResume = hasScreens && hasTransitions;
                    const noGraphBadge = (s.has_graph || 0) === 0
                        ? '<span class="text-xs text-amber-500 ml-2">グラフ未構築</span>' : '';
                    html += `<div class="bg-gray-900/50 border border-slate-700/40 rounded-lg p-3 flex items-center justify-between">
                        <div>
                            <span class="text-sm font-mono text-slate-300">${escapeHtml(s.session_id)}</span>
                            ${completionBadge(s.completion_type)}
                            <span class="text-xs text-gray-500 ml-3">画面 ${s.actual_screens} 件</span>
                            ${s.pending_gemini > 0 ? `<span class="text-xs text-amber-500 ml-2">OCR ${s.pending_gemini} 件</span>` : ''}
                            ${s.pending_dedup > 0 ? `<span class="text-xs text-emerald-500 ml-2">間引き ${s.pending_dedup} 件</span>` : ''}
                            ${noGraphBadge}
                        </div>
                        <div class="flex items-center gap-2">
                            ${canResume ? `<button class="bg-process-btn px-3 py-1 bg-cyan-900/50 hover:bg-cyan-800/60 text-cyan-300 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" title="後処理 (OCR + 間引き + グラフ構築) を再開">再開</button>` : ''}
                            <button class="delete-session-btn px-2 py-1 bg-red-900/50 hover:bg-red-800 text-red-400 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" data-node-count="0">${TRASH_ICON}</button>
                        </div>
                    </div>`;
                }
                html += '</div>';
            }
            html += '</div>';
            // 4. 進行中セッション
            html += '<div><h3 class="text-lg font-bold text-violet-400 mb-3">進行中セッション</h3>';
            if (running.length === 0) {
                html += '<p class="text-gray-600 text-sm">実行中のセッションはありません</p>';
            } else {
                html += '<p class="text-xs text-gray-500 mb-2">auto_pilot 実行中のセッション。完了するとマージ待ちに移動。</p>';
                html += '<div class="space-y-2">';
                for (const s of running) {
                    html += `<div class="bg-gray-900/50 border border-violet-900/30 rounded-lg p-3 flex items-center justify-between">
                        <div>
                            <span class="text-sm font-mono text-violet-300">${escapeHtml(s.session_id)}</span>
                            <span class="text-xs text-gray-500 ml-3">画面 ${s.actual_screens} 件</span>
                            <span class="text-xs text-gray-600 ml-3">${escapeHtml(s.started_at || '')}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="inline-block w-2 h-2 rounded-full bg-violet-400 animate-pulse" title="実行中"></span>
                        </div>
                    </div>`;
                }
                html += '</div>';
            }
            html += '</div>';
            // 5. 遷移データなし
            html += '<div><h3 class="text-lg font-bold text-gray-500 mb-3">遷移データなし</h3>';
            if (noTransition.length === 0) {
                html += '<p class="text-gray-600 text-sm">遷移データなしのセッションはありません</p>';
            } else {
                html += '<p class="text-xs text-gray-500 mb-2">画面記録はあるがタップ遷移が記録されていないため、グラフ構築・マージ不可。削除のみ可能。</p>';
                html += '<div class="space-y-2">';
                for (const s of noTransition) {
                    html += `<div class="bg-gray-900/50 border border-gray-800/50 rounded-lg p-3 flex items-center justify-between">
                        <div>
                            <span class="text-sm font-mono text-gray-400">${escapeHtml(s.session_id)}</span>
                            ${completionBadge(s.completion_type)}
                            <span class="text-xs text-gray-500 ml-3">画面 ${s.actual_screens} 件・遷移 0 件</span>
                            <span class="text-xs text-gray-600 ml-3">${escapeHtml(s.started_at || '')}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button class="delete-session-btn px-2 py-1 bg-red-900/50 hover:bg-red-800 text-red-400 text-xs rounded transition-colors"
                                    data-session-id="${escapeHtml(s.session_id)}" data-node-count="0">${TRASH_ICON}</button>
                        </div>
                    </div>`;
                }
                html += '</div>';
            }
            html += '</div>';
            html += '</div>';
            mc.innerHTML = html;
            // プレビューボタン
            mc.querySelectorAll('.merge-preview-btn').forEach(btn => {
                btn.addEventListener('click', () => showMergePreview(btn.dataset.sessionId));
            });
            // 削除ボタン
            mc.querySelectorAll('.delete-session-btn').forEach(btn => {
                btn.addEventListener('click', () => confirmDeleteSession(btn.dataset.sessionId, btn.dataset.nodeCount));
            });
            // グラフ構築ボタン
            mc.querySelectorAll('.build-graph-btn').forEach(btn => {
                btn.addEventListener('click', () => buildSessionGraph(btn.dataset.sessionId));
            });
            // 後処理実行ボタン (バックグラウンド未完了)
            mc.querySelectorAll('.bg-process-btn').forEach(btn => {
                btn.addEventListener('click', () => processSessionBg(btn.dataset.sessionId));
            });
            // 未マージボタン: can_unmerge チェック → disabled 制御
            mc.querySelectorAll('.unmerge-btn').forEach(btn => {
                const sid = btn.dataset.sessionId;
                btn.disabled = true;
                btn.classList.add('opacity-60', 'cursor-not-allowed');
                fetch(API_BASE + '?action=can_unmerge&session_id=' + encodeURIComponent(sid))
                    .then(r => r.json())
                    .then(data => {
                        if (data.ok) {
                            btn.disabled = false;
                            btn.classList.remove('opacity-60', 'cursor-not-allowed');
                            btn.addEventListener('click', () => confirmUnmerge(sid));
                        } else {
                            btn.title = data.reason || '未マージ不可';
                        }
                    })
                    .catch(() => { btn.title = 'チェック失敗'; });
            });
            // 操作実行中ならボタンを再 disable
            if (_operationInProgress) _setOperationButtons(true);
        } catch (e) {
            mc.innerHTML = '<div class="text-center text-gray-500 py-12">準備中...</div>';
        }
    }

    function renderProgress(p) {
        if (!p) return '';
        const pct = p.total > 0 ? Math.round(p.current / p.total * 100) : 0;
        const eta = p.eta > 0 ? `残り約 ${Math.ceil(p.eta)}秒` : '';
        return `<div class="mt-3 max-w-md mx-auto">
            <div class="flex justify-between text-xs text-gray-500 mb-1">
                <span>${escapeHtml(p.stage)} (${p.current}/${p.total})</span>
                <span>${eta}</span>
            </div>
            <div class="w-full bg-gray-800 rounded-full h-2">
                <div class="bg-brand h-2 rounded-full transition-all" style="width:${pct}%"></div>
            </div>
            <div class="text-xs text-gray-600 mt-1 text-center">経過 ${Math.round(p.elapsed)}秒</div>
        </div>`;
    }

    async function pollMergeResult(mc, label) {
        return new Promise((resolve) => {
            const timer = setInterval(async () => {
                try {
                    const r = await fetch(API_BASE + '?action=merge_progress');
                    const d = await r.json();
                    if (d.progress) {
                        mc.innerHTML = `<div class="text-center text-gray-600 py-12">
                            <span class="animate-pulse">${label}...</span>${renderProgress(d.progress)}</div>`;
                    }
                    if (d.done) {
                        clearInterval(timer);
                        resolve(d.result);
                    }
                } catch (e) {}
            }, 1000);
        });
    }

    async function showMergePreview(sessionId) {
        return await withOperationLock('プレビュー', async () => {
            return await _showMergePreview(sessionId);
        });
    }
    async function _showMergePreview(sessionId) {
        const mc = document.getElementById('merge-container');
        const toastHandle = showToast('プレビュー計算中...', 'info', { sticky: true });
        try {
            await fetch(API_BASE + '?action=preview_merge&session_id=' + encodeURIComponent(sessionId));
            const data = await pollMergeResult(mc, 'プレビュー計算中');
            if (toastHandle) toastHandle.remove();
            if (!data || data.error) { mc.innerHTML = `<div class="text-red-500 py-12">${escapeHtml(data?.error || 'プレビュー失敗')}</div>`; return; }
            let html = '<div class="space-y-6">';
            html += `<div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-bold text-brand-light">マージプレビュー: ${escapeHtml(sessionId)}</h3>
                    <p class="text-sm text-gray-400 mt-1">新規追加ノード: ${(data.new_nodes || []).filter(n => n.insertable).length} / アンカー: ${data.matches.length} / セッション画面: ${data.session_screens} / マスター現状: ${data.master_nodes_before} ノード</p>
                </div>
                <div class="flex gap-2">
                    <button onclick="fetchMergeTab()" class="px-3 py-1.5 bg-gray-700 hover:bg-gray-600 text-gray-300 text-xs rounded">戻る</button>
                    <button id="execute-merge-btn" class="px-4 py-1.5 bg-cyan-900/50 hover:bg-cyan-800/60 text-cyan-300 text-sm font-bold rounded">マージ実行</button>
                </div>
            </div>`;
            const sm = data.summary;
            // プレビュー用アイテムリスト (モーダル表示用)
            const previewItems = [];
            const GRID_CLS = 'grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3';

            // 新規追加ノード (SafeInsert 判定済み)
            const insertableNodes = (data.new_nodes || []).filter(n => n.insertable);
            html += `<h4 class="text-sm font-bold text-lime-400 mt-4">新規追加ノード (${insertableNodes.length})</h4>`;
            if (insertableNodes.length > 0) {
                html += `<div class="${GRID_CLS}">`;
                for (const n of insertableNodes) {
                    const item = { thumb: n.thumb, title: n.title, scene: n.scene,
                                   discovered_at: n.discovered_at, ocr_text: n.ocr_text,
                                   screenshot: n.screenshot, fp: n.fp };
                    html += buildCard({
                        thumb: item.thumb ? imgUrl(item.thumb) : '', title: item.title,
                        ocrPreview: (item.ocr_text || '').substring(0, 80),
                        scene: item.scene, time: item.discovered_at || '',
                        dataAttr: `data-preview-idx="${previewItems.length}"`,
                    });
                    previewItems.push(item);
                }
                html += '</div>';
            } else {
                html += '<p class="text-gray-600 text-sm">新規追加ノードはありません</p>';
            }

            // アンカー一覧
            if (data.matches.length > 0) {
                html += `<div class="flex items-center justify-between mt-4"><h4 class="text-sm font-bold text-cyan-400">アンカー一覧 (${data.matches.length})</h4><div class="flex gap-3 text-xs"><span class="px-2 py-0.5 bg-blue-900/50 rounded text-blue-300">P1 テキスト+tap: ${sm.phase1_tap_text || 0}</span><span class="px-2 py-0.5 bg-purple-900/50 rounded text-purple-300">P2 テキスト+auto: ${sm.phase2_auto_text || 0}</span><span class="px-2 py-0.5 bg-yellow-900/50 rounded text-yellow-300">P3 phash: ${sm.phase3_tap_phash || 0}</span></div></div>`;
                html += `<div class="${GRID_CLS}">`;
                for (const m of data.matches) {
                    const color = m.method.includes('phase1') ? 'bg-blue-900/50 text-blue-300'
                        : m.method.includes('phase2') ? 'bg-purple-900/50 text-purple-300'
                        : 'bg-yellow-900/50 text-yellow-300';
                    const label = m.method.replace('phase1_tap_text','P1').replace('phase2_auto_text','P2').replace('phase3_tap_phash','P3');
                    const item = { thumb: m.session_thumb, title: m.session_title, scene: m.session_scene,
                                   discovered_at: m.session_discovered_at, ocr_text: m.session_ocr_text,
                                   screenshot: m.session_screenshot, fp: m.session_fp };
                    html += buildCard({
                        thumb: item.thumb ? imgUrl(item.thumb) : '', title: item.title,
                        ocrPreview: (item.ocr_text || '').substring(0, 80),
                        scene: item.scene, time: item.discovered_at || '',
                        badge: { color, label },
                        dataAttr: `data-preview-idx="${previewItems.length}"`,
                    });
                    previewItems.push(item);
                }
                html += '</div>';
            }
            html += '</div>';
            mc.innerHTML = html;
            // プレビューカードのクリックでモーダル表示
            mc.querySelectorAll('[data-preview-idx]').forEach(card => {
                card.addEventListener('click', () => {
                    const idx = parseInt(card.dataset.previewIdx, 10);
                    const item = previewItems[idx];
                    if (!item) return;
                    const badge = document.getElementById('modal-scene-badge');
                    badge.textContent = item.scene || '';
                    document.getElementById('modal-title').textContent = item.title || '';
                    document.getElementById('modal-img').src = item.screenshot ? imgUrl(item.screenshot) : (item.thumb ? imgUrl(item.thumb) : '');
                    document.getElementById('modal-ocr').textContent = item.ocr_text || '';
                    document.getElementById('modal-fp').textContent = 'fp: ' + (item.fp || '');
                    document.getElementById('modal-time').textContent = item.discovered_at || '';
                    document.getElementById('modal-counter').textContent = (idx + 1) + ' / ' + previewItems.length;
                    document.getElementById('modal-ocr-sources').innerHTML = '';
                    document.getElementById('modal-edit-area').classList.add('hidden');
                    document.getElementById('modal-edit-btn').style.display = 'none';
                    document.getElementById('modal-cluster').classList.add('hidden');
                    // ナビゲーション
                    const prevBtn = document.getElementById('modal-prev');
                    const nextBtn = document.getElementById('modal-next');
                    prevBtn.onclick = (e) => { e.stopPropagation(); if (idx > 0) card.closest('[data-preview-idx]') || mc.querySelector(`[data-preview-idx="${idx-1}"]`)?.click(); };
                    nextBtn.onclick = (e) => { e.stopPropagation(); if (idx < previewItems.length - 1) mc.querySelector(`[data-preview-idx="${idx+1}"]`)?.click(); };
                    prevBtn.classList.toggle('invisible', idx <= 0);
                    nextBtn.classList.toggle('invisible', idx >= previewItems.length - 1);
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                });
            });
            document.getElementById('execute-merge-btn').addEventListener('click', () => executeMerge(sessionId));
        } catch (e) {
            if (toastHandle) toastHandle.remove();
            mc.innerHTML = '<div class="text-red-500 py-12">プレビュー失敗</div>';
        }
    }

    function renderNeighbors(neighbors) {
        if (!neighbors || neighbors.length === 0) return '';
        const items = neighbors.slice(0, 4).map(n => {
            const arrow = n.direction === 'to' ? '→' : '←';
            return `<span class="text-[9px] text-gray-500">${arrow} ${escapeHtml((n.title || n.fp || '').substring(0, 20))}</span>`;
        });
        return `<div class="flex flex-wrap gap-1 mt-1">${items.join('')}</div>`;
    }

    async function executeMerge(sessionId) {
        await withOperationLock('マージ実行', async () => {
            await _executeMerge(sessionId);
        });
    }
    async function _executeMerge(sessionId) {
        const mc = document.getElementById('merge-container');
        mc.innerHTML = '<div class="text-center text-gray-600 py-12"><span class="animate-pulse">マージ実行中...</span></div>';
        try {
            await fetch(API_BASE + '?action=execute_merge&session_id=' + encodeURIComponent(sessionId));
            const data = await pollMergeResult(mc, 'マージ実行中');
            if (data && data.ok) {
                mc.innerHTML = `<div class="text-center text-green-500 py-12">マージ完了: ${data.new_nodes} 新規ノード追加</div>`;
                setTimeout(() => fetchMergeTab(), 1500);
            } else {
                mc.innerHTML = `<div class="text-center text-red-500 py-12">エラー: ${escapeHtml(data?.error || '不明')}</div>`;
            }
        } catch (e) {
            mc.innerHTML = '<div class="text-center text-red-500 py-12">マージ失敗</div>';
        }
    }

    function confirmDeleteSession(sessionId, nodeCount) {
        const html = `
            <p class="text-sm text-gray-300 mb-2">セッション <code class="text-brand-light">${escapeHtml(sessionId)}</code> を削除しますか？</p>
            <ul class="text-xs text-gray-400 space-y-1 ml-4 list-disc">
                <li>不採用の画像・スクリーンショットファイルを物理削除</li>
                <li>遷移データ・グループ情報を削除</li>
                <li>採用済み画像（マスターノード参照）は保持</li>
            </ul>
            <p class="text-xs text-red-400 mt-3">この操作は取り消せません。</p>`;
        showConfirmDialog(html, async function() {
            hideConfirmDialog();
            await executeDeleteSession(sessionId);
        }, { okLabel: '削除', danger: true });
    }

    async function executeDeleteSession(sessionId) {
        const mc = document.getElementById('merge-container');
        mc.innerHTML = '<div class="text-center text-gray-600 py-12">削除中...</div>';
        try {
            const res = await fetch(API_BASE + '?action=delete_session&session_id=' + encodeURIComponent(sessionId));
            const data = await res.json();
            if (data.ok) {
                mc.innerHTML = `<div class="text-center text-green-500 py-12">
                    削除完了: ${data.deleted_screens} 画面削除, ${data.deleted_files} ファイル削除, ${data.kept_screens} 画面保持
                </div>`;
                setTimeout(() => fetchMergeTab(), 2000);
            } else {
                mc.innerHTML = `<div class="text-center text-red-500 py-12">エラー: ${escapeHtml(data.error || '不明')}</div>`;
            }
        } catch (e) {
            mc.innerHTML = '<div class="text-center text-red-500 py-12">削除失敗</div>';
        }
    }

    async function checkCleanableInMerge() {
        const area = document.getElementById('merge-cleanup-area');
        if (!area) return;
        try {
            const res = await fetch(API_BASE + '?action=get_cleanable_excluded');
            const data = await res.json();
            if (data.count > 0) {
                area.innerHTML = `<div class="flex items-center justify-between bg-gray-900 border border-gray-800 rounded-lg p-4">
                    <div>
                        <span class="text-gray-300">Final で除外済み＋セッション削除済みの画像が ${data.count} 件あります</span>
                        <p class="text-xs text-gray-500 mt-1">マスターノード・エッジ・画像ファイルを完全に削除できます</p>
                    </div>
                    <button id="merge-cleanup-btn" class="px-3 py-1.5 bg-red-900/50 hover:bg-red-800 text-red-400 text-xs rounded transition-colors">${TRASH_ICON}</button>
                </div>`;
                document.getElementById('merge-cleanup-btn').addEventListener('click', confirmCleanupExcluded);
            } else {
                area.innerHTML = '<p class="text-gray-600 text-sm">整理対象のデータはありません</p>';
            }
        } catch (e) {
            area.innerHTML = '<p class="text-gray-600 text-sm">確認できませんでした</p>';
        }
    }

    async function confirmCleanupExcluded() {
        const res = await fetch(API_BASE + '?action=get_cleanable_excluded');
        const data = await res.json();
        const items = data.items || [];
        if (items.length === 0) return;
        let html = `<p class="text-sm text-gray-300 mb-3">除外済み＋セッション削除済みの ${items.length} 件を完全削除しますか？</p>`;
        html += '<div class="flex flex-wrap justify-center gap-3 max-h-[22rem] overflow-y-auto p-1 confirm-img-area">';
        for (const item of items) {
            const thumb = item.thumbnail_path ? imgUrl(item.thumbnail_path) : '';
            html += _thumbCard(thumb, item.title || '');
        }
        html += '</div>';
        html += '<p class="text-xs text-red-400 mt-3">マスターノード・エッジ・画像ファイルを物理削除します。<br>この操作は取り消せません。</p>';
        showConfirmDialog(html, async function() {
            hideConfirmDialog();
            try {
                const r = await fetch(API_BASE + '?action=cleanup_excluded');
                const result = await r.json();
                if (result.ok) await fetchMergeTab();
            } catch (e) {}
        }, { okLabel: '削除', danger: true });
    }

    // --- 修正ルール (Phase 2) ---
    async function checkCorrectionRules() {
        const area = document.getElementById('correction-rules-area');
        if (!area) return;
        try {
            const res = await fetch(API_BASE + '?action=get_correction_candidates');
            const data = await res.json();
            const candidates = data.candidates || [];
            if (candidates.length === 0) {
                area.innerHTML = `<p class="text-gray-600 text-sm">適用可能な修正ルールはありません (登録済み: ${data.total_rules || 0} 件)</p>`;
                return;
            }
            let html = `<p class="text-xs text-gray-500 mb-2">${candidates.length} 件のルールが他のノードに適用可能です</p>`;
            html += '<div class="space-y-2">';
            for (const c of candidates) {
                const r = c.rule;
                html += `<div class="bg-gray-900 border border-gray-800 rounded-lg p-3">
                    <div class="flex items-center justify-between mb-2">
                        <div class="text-xs">
                            <span class="text-red-400">${escapeHtml(r.before_text.substring(0, 60))}</span>
                            <span class="text-gray-500 mx-2">→</span>
                            <span class="text-emerald-400">${escapeHtml(r.after_text.substring(0, 60))}</span>
                        </div>
                        <button class="apply-rule-btn px-3 py-1 bg-emerald-900/50 hover:bg-emerald-800/60 text-emerald-300 text-xs rounded transition-colors"
                                data-rule-id="${r.id}"
                                data-master-fps='${JSON.stringify(c.matches.map(m => m.master_fp))}'>
                            ${c.count} 回
                        </button>
                    </div>
                </div>`;
            }
            html += '</div>';
            area.innerHTML = html;
            area.querySelectorAll('.apply-rule-btn').forEach(btn => {
                btn.addEventListener('click', () => applyCorrectionRule(btn.dataset.ruleId, btn.dataset.masterFps));
            });
        } catch (e) {
            area.innerHTML = '<p class="text-gray-600 text-sm">ルール取得エラー</p>';
        }
    }

    async function applyCorrectionRule(ruleId, masterFpsJson) {
        await withOperationLock('ルール適用', async () => {
            await _applyCorrectionRule(ruleId, masterFpsJson);
        });
    }
    async function _applyCorrectionRule(ruleId, masterFpsJson) {
        try {
            const params = new URLSearchParams({ rule_id: ruleId, master_fps: masterFpsJson });
            const res = await fetch(API_BASE + '?action=apply_correction_rule&' + params);
            const data = await res.json();
            if (data.ok) {
                checkCorrectionRules();
            } else {
                alert('適用失敗: ' + (data.error || '不明'));
            }
        } catch (e) {
            alert('適用失敗: ' + e.message);
        }
    }

    // --- 操作ロック (排他制御) ---
    // 同時に1つの長時間操作のみ実行可能
    let _operationInProgress = false;

    function _setOperationButtons(disabled) {
        const selectors = ['.unmerge-btn', '.build-graph-btn', '.merge-preview-btn',
                           '#execute-merge-btn', '.apply-rule-btn', '.bg-process-btn'];
        document.querySelectorAll(selectors.join(',')).forEach(btn => {
            btn.disabled = disabled;
            if (disabled) {
                btn.classList.add('opacity-50', 'cursor-not-allowed');
                btn.dataset.lockedTitle = btn.title || '';
                btn.title = '他の作業実行中のため操作不可';
            } else {
                btn.classList.remove('opacity-50', 'cursor-not-allowed');
                if (btn.dataset.lockedTitle !== undefined) {
                    btn.title = btn.dataset.lockedTitle;
                    delete btn.dataset.lockedTitle;
                }
            }
        });
    }

    async function withOperationLock(label, fn) {
        if (_operationInProgress) {
            showToast(`他の作業実行中のため「${label}」を開始できません`, 'error');
            return null;
        }
        _operationInProgress = true;
        _setOperationButtons(true);
        try {
            return await fn();
        } finally {
            _operationInProgress = false;
            _setOperationButtons(false);
        }
    }

    // --- トースト通知 ---
    // sticky=true で消えない通知 (戻り値の .remove() で消去)
    function showToast(message, type = 'info', opts = {}) {
        const container = document.getElementById('toast-container');
        if (!container) return null;
        const colors = {
            info:    'bg-gray-800 border-gray-600 text-gray-200',
            success: 'bg-emerald-900 border-emerald-700 text-emerald-200',
            error:   'bg-red-900 border-red-700 text-red-200',
        };
        const cls = colors[type] || colors.info;
        const toast = document.createElement('div');
        toast.className = `${cls} border rounded-lg px-4 py-2 shadow-lg pointer-events-auto text-sm transition-opacity opacity-0 flex items-center gap-2`;
        if (opts.sticky) {
            toast.innerHTML = `<span class="inline-block w-3 h-3 rounded-full border-2 border-current border-t-transparent animate-spin"></span><span class="toast-msg">${escapeHtml(message)}</span>`;
        } else {
            toast.textContent = message;
        }
        container.appendChild(toast);
        requestAnimationFrame(() => toast.classList.replace('opacity-0', 'opacity-100'));
        const handle = {
            update(newMsg) {
                const span = toast.querySelector('.toast-msg');
                if (span) span.textContent = newMsg;
                else toast.textContent = newMsg;
            },
            remove() {
                toast.classList.replace('opacity-100', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            },
        };
        if (!opts.sticky) {
            setTimeout(() => handle.remove(), 4000);
        }
        return handle;
    }

    // --- グラフ構築 (バックグラウンド) ---
    async function processSessionBg(sessionId) {
        await withOperationLock('後処理実行', async () => {
            const sticky = showToast(`後処理実行中: ${sessionId} (Gemini OCR + 間引き + グラフ構築)`, 'info', { sticky: true });
            const startTime = Date.now();
            const elapsedTimer = setInterval(async () => {
                const elapsed = Math.floor((Date.now() - startTime) / 1000);
                try {
                    const pr = await fetch(API_BASE + '?action=merge_progress');
                    const pd = await pr.json();
                    if (pd.progress) {
                        const p = pd.progress;
                        const phase = p.phase || 'OCR';
                        if (phase === 'graph') {
                            sticky.update(`グラフ構築中: ${sessionId} (${elapsed}秒経過)`);
                        } else {
                            sticky.update(`後処理実行中: ${sessionId} — OCR ${p.ocr_done || 0}/${p.ocr_total || '?'} (${elapsed}秒経過)`);
                        }
                    } else {
                        sticky.update(`後処理実行中: ${sessionId} (${elapsed}秒経過)`);
                    }
                } catch (e) {
                    sticky.update(`後処理実行中: ${sessionId} (${elapsed}秒経過)`);
                }
            }, 2000);
            try {
                await fetch(API_BASE + '?action=process_session_bg&session_id=' + encodeURIComponent(sessionId));
                const result = await new Promise((resolve) => {
                    const timer = setInterval(async () => {
                        try {
                            const r = await fetch(API_BASE + '?action=merge_progress');
                            const d = await r.json();
                            if (d.done) {
                                clearInterval(timer);
                                resolve(d.result);
                            }
                        } catch (e) {}
                    }, 2000);
                });
                clearInterval(elapsedTimer);
                if (sticky) sticky.remove();
                if (result && result.ok) {
                    showToast(`後処理完了: ${sessionId} (${result.sccs} SCC) → マージ待ちへ移動`, 'success');
                    fetchMergeTab();
                } else {
                    showToast(`後処理失敗: ${result?.error || '不明'}`, 'error');
                }
            } catch (e) {
                clearInterval(elapsedTimer);
                if (sticky) sticky.remove();
                showToast(`後処理エラー: ${e.message}`, 'error');
            }
        });
    }

    async function buildSessionGraph(sessionId) {
        await withOperationLock('グラフ構築', async () => {
            const sticky = showToast(`グラフ構築中: ${sessionId}`, 'info', { sticky: true });
            const startTime = Date.now();
            // 経過時間を更新するタイマー
            const elapsedTimer = setInterval(() => {
                const elapsed = Math.floor((Date.now() - startTime) / 1000);
                if (sticky) sticky.update(`グラフ構築中: ${sessionId} (${elapsed}秒経過)`);
            }, 1000);
            try {
                await fetch(API_BASE + '?action=build_session_graph&session_id=' + encodeURIComponent(sessionId));
                // 完了をポーリング
                const result = await new Promise((resolve) => {
                    const timer = setInterval(async () => {
                        try {
                            const r = await fetch(API_BASE + '?action=merge_progress');
                            const d = await r.json();
                            if (d.done) {
                                clearInterval(timer);
                                resolve(d.result);
                            }
                        } catch (e) {}
                    }, 1500);
                });
                clearInterval(elapsedTimer);
                if (sticky) sticky.remove();
                if (result && result.ok) {
                    showToast(`グラフ構築完了: ${sessionId} (${result.sccs} SCC) → マージ待ちに移動`, 'success');
                    fetchMergeTab();
                } else {
                    showToast(`グラフ構築失敗: ${result?.error || '不明'}`, 'error');
                }
            } catch (e) {
                clearInterval(elapsedTimer);
                if (sticky) sticky.remove();
                showToast(`グラフ構築エラー: ${e.message}`, 'error');
            }
        });
    }

    // --- 未マージ ---
    function confirmUnmerge(sessionId) {
        const html = `
            <p class="text-sm text-gray-300 mb-2">セッション <code class="text-brand-light">${escapeHtml(sessionId)}</code> を未マージに戻しますか？</p>
            <ul class="text-xs text-gray-400 space-y-1 ml-4 list-disc">
                <li>マスターグラフを全削除し、このセッションを除外して再構築します</li>
                <li>手動変更（採用/不採用・グループ統合・タイトル編集）は自動復元されます</li>
                <li>auto_pilot は再構築完了まで一時停止します</li>
            </ul>
