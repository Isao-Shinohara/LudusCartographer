            sortToggle.classList.add('hidden');
            versionSelect.classList.add('hidden');
            grid.classList.add('hidden');
            mergeContainer.classList.remove('hidden');
            document.getElementById('settings-container').classList.add('hidden');
            mergeContainer.innerHTML = '<div class="text-center text-gray-600 py-12">読み込み中...</div>';
