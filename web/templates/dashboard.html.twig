{% extends "layout.html.twig" %}

{% block title %}Dashboard — LudusCartographer{% endblock %}

{% block content %}
<!-- ヘッダー+タブ (sticky) -->
<div id="dashboard-sticky" class="sticky top-0 z-40 bg-gray-950 pb-2" style="margin: -2rem calc(-50vw + 50%) 0; padding: 1rem calc(50vw - 50%) 0;">
<div class="flex items-center justify-between mb-2">
    <h2 class="text-xl font-bold text-brand-light">Dashboard</h2>
</div>

<!-- タブ -->
<div class="flex items-center gap-1 mb-4 border-b border-gray-800">
    <button id="tab-live" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-brand text-brand-light"
            onclick="switchTab('live')">
        Live
    </button>
    <button id="tab-final" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-300"
            onclick="switchTab('final')">
        Final
    </button>
    <button id="tab-merge" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-300"
            onclick="switchTab('merge')">
        Merge
    </button>
    <button id="tab-rules" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-300"
            onclick="switchTab('rules')">
        Rules
    </button>
    <button id="tab-cleanup" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-300"
            onclick="switchTab('cleanup')">
        Cleanup
    </button>
    <button id="tab-cost" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-300"
            onclick="switchTab('cost')">
        Cost
    </button>
    <button id="tab-settings" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-300"
            onclick="switchTab('settings')">
        Settings
    </button>
    <select id="filter-select" class="ml-3 bg-gray-800 text-gray-300 text-xs rounded px-2 py-1 border border-gray-700 focus:border-brand outline-none">
        <option value="reps" selected>採用</option>
        <option value="thinned">不採用</option>
        <option value="pending">未処理</option>
        <option value="all">すべて</option>
    </select>
    <button id="sort-toggle" class="ml-1 bg-gray-800 text-gray-300 text-xs rounded px-2 py-1 border border-gray-700 hover:border-brand hover:text-brand-light transition-colors outline-none" data-sort="desc">降順</button>
    <select id="version-select" class="ml-1 bg-gray-800 text-gray-300 text-xs rounded px-2 py-1 border border-gray-700 focus:border-brand outline-none hidden">
    </select>
    <select id="session-select" class="ml-1 bg-gray-800 text-gray-300 text-xs rounded px-2 py-1 border border-gray-700 focus:border-brand outline-none">
        <option value="">最新セッション</option>
    </select>
    <select id="debug-session-select" class="ml-1 bg-gray-800 text-gray-300 text-xs rounded px-2 py-1 border border-gray-700 focus:border-brand outline-none hidden">
    </select>
    <!-- ステータス (右詰) -->
    <div class="ml-auto flex items-center gap-2">
        <div id="status" class="flex items-center gap-2 cursor-pointer select-none" onclick="toggleAutoRefresh()" title="クリックで自動更新を切り替え">
            <span id="status-dot" class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            <span id="status-text" class="text-xs text-gray-500">自動更新中</span>
        </div>
        <button id="debug-toggle" class="px-2 py-1 text-[10px] rounded transition-colors" onclick="toggleDebug()">Debug</button>
    </div>
</div>
<!-- Final 採用/不採用アクションバー (2段目) -->
<div id="final-actions" class="hidden flex items-center justify-end gap-2 pb-2">
    <span id="final-select-hint" class="text-xs text-gray-500">Shift+クリックで選択</span>
    <button id="final-merge-group-btn" class="px-3 py-1 bg-violet-900/60 hover:bg-violet-800/70 text-violet-200 text-xs rounded transition-colors disabled:opacity-60 disabled:cursor-not-allowed" disabled>⊕ 統合</button>
    <button id="final-adopt-btn" class="px-3 py-1 bg-emerald-900/70 hover:bg-emerald-800/80 text-emerald-200 text-xs rounded transition-colors disabled:opacity-60 disabled:cursor-not-allowed" disabled>✓ 採用</button>
    <button id="final-exclude-btn" class="px-3 py-1 bg-amber-900/50 hover:bg-amber-800/60 text-amber-300 text-xs rounded transition-colors disabled:opacity-60 disabled:cursor-not-allowed" disabled>✕ 不採用</button>
    <button id="final-reset-btn" class="px-3 py-1 bg-gray-800 hover:bg-gray-700 text-gray-300 text-xs rounded transition-colors disabled:opacity-60 disabled:cursor-not-allowed" disabled>リセット</button>
</div>
<!-- Live 採用/不採用アクションバー (2段目) -->
<div id="live-actions" class="hidden flex items-center justify-end gap-2 pb-2">
    <span class="text-xs text-gray-500">Shift+クリックで選択</span>
    <button id="live-adopt-btn" class="px-3 py-1 bg-emerald-900/70 hover:bg-emerald-800/80 text-emerald-200 text-xs rounded transition-colors disabled:opacity-60 disabled:cursor-not-allowed" disabled>✓ 採用</button>
    <button id="live-exclude-btn" class="px-3 py-1 bg-amber-900/50 hover:bg-amber-800/60 text-amber-300 text-xs rounded transition-colors disabled:opacity-60 disabled:cursor-not-allowed" disabled>✕ 不採用</button>
    <button id="live-reset-btn" class="px-3 py-1 bg-gray-800 hover:bg-gray-700 text-gray-300 text-xs rounded transition-colors disabled:opacity-60 disabled:cursor-not-allowed" disabled>リセット</button>
</div>
</div>

<!-- 確認ポップアップ -->
<div id="confirm-popup" class="fixed inset-0 bg-black/70 z-[60] hidden items-center justify-center p-4">
    <div id="confirm-inner" class="bg-gray-900 rounded-xl border border-gray-700 max-w-4xl min-w-[26rem] max-h-[80vh] overflow-auto p-6" onclick="event.stopPropagation()">
        <h3 class="text-lg font-bold text-brand-light mb-4">変更確認</h3>
        <div id="confirm-body" class="space-y-3 mb-6"></div>
        <div class="flex justify-end gap-3">
            <button id="confirm-cancel" class="px-4 py-1.5 bg-gray-700 hover:bg-gray-600 text-gray-300 text-sm rounded">キャンセル</button>
            <button id="confirm-ok" class="px-4 py-1.5 bg-green-700 hover:bg-green-600 text-white text-sm font-bold rounded">更新</button>
        </div>
    </div>
</div>

<!-- 画像プレビュー (確認ポップアップ上) -->
<div id="preview-overlay" class="fixed inset-0 bg-black/80 z-[70] hidden items-start justify-center p-4 pt-8" onclick="this.classList.add('hidden');this.classList.remove('flex');">
    <div class="bg-gray-900 rounded-xl border border-gray-700 max-w-4xl w-full" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center p-4 border-b border-gray-800">
            <h3 id="preview-title" class="text-lg font-bold text-brand-light truncate"></h3>
            <button onclick="document.getElementById('preview-overlay').classList.add('hidden');document.getElementById('preview-overlay').classList.remove('flex');" class="text-gray-500 hover:text-white text-2xl">&times;</button>
        </div>
        <div class="p-4">
            <img id="preview-img" src="" class="w-full rounded-lg bg-gray-800 mb-4" />
            <div id="preview-ocr" class="bg-gray-800 rounded-lg px-3 pb-4 pt-2 text-sm text-gray-300 whitespace-pre-wrap h-[5.5rem] overflow-y-auto" style="-webkit-mask-image:linear-gradient(to bottom,black 70%,transparent 100%);mask-image:linear-gradient(to bottom,black 70%,transparent 100%);"></div>
            <div class="mt-3 flex gap-4 text-xs text-gray-600">
                <span id="preview-scene"></span>
                <span id="preview-fp" class="font-mono"></span>
                <span id="preview-time"></span>
            </div>
        </div>
    </div>
</div>

<!-- グリッド (Live / Final) -->
<div id="grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 mt-4 pb-10">
    <div class="col-span-full text-center text-gray-600 py-12">読み込み中...</div>
</div>

<!-- Merge タブ用コンテナ -->
<div id="merge-container" class="hidden"></div>
<div id="settings-container" class="hidden"></div>

<!-- 固定フッター (画面数) -->
<div id="dashboard-footer" class="fixed bottom-0 left-0 right-0 z-30 bg-gray-900/90 border-t border-gray-800 py-1.5">
    <div class="max-w-7xl mx-auto px-4 flex items-center gap-6">
        <span id="debug-stats" class="text-xs hidden flex-1 min-w-0 truncate text-gray-400"></span>
        <span class="shrink-0 flex items-center gap-1.5 ml-auto">
            <span id="debug-anchor" class="text-xs hidden text-cyan-400"></span>
            <span id="debug-session-info" class="text-xs text-gray-400 hidden"></span>
            <span id="final-select-count" class="text-xs text-gray-500"></span>
            <span id="stats" class="text-xs text-emerald-400/70"></span>
        </span>
    </div>
</div>

<!-- 通知トースト -->
<div id="toast-container" class="fixed bottom-4 right-4 z-[80] space-y-2 pointer-events-none"></div>

<!-- リネームモーダル -->
<div id="rename-modal" class="fixed inset-0 bg-black/60 z-[60] hidden items-center justify-center">
    <div class="bg-gray-800 border border-gray-700 rounded-xl p-6 w-80 shadow-2xl">
        <h3 class="text-sm font-bold text-gray-200 mb-3">バージョン名の変更</h3>
        <input id="rename-input" type="text" class="w-full bg-gray-900 text-gray-200 text-sm rounded-lg px-3 py-2 border border-gray-600 focus:border-brand outline-none mb-4" />
        <input id="rename-vid" type="hidden" />
        <div class="flex justify-end gap-2">
            <button id="rename-cancel" class="px-4 py-1.5 text-sm bg-gray-700 hover:bg-gray-600 text-gray-300 rounded-lg transition-colors">キャンセル</button>
            <button id="rename-submit" class="px-4 py-1.5 text-sm bg-brand hover:bg-blue-600 text-white rounded-lg transition-colors">更新</button>
        </div>
    </div>
</div>

<!-- 削除確認モーダル -->
<div id="delete-modal" class="fixed inset-0 bg-black/60 z-[60] hidden items-center justify-center">
    <div class="bg-gray-800 border border-gray-700 rounded-xl p-6 w-96 shadow-2xl">
        <h3 class="text-sm font-bold text-red-400 mb-3">バージョンの削除</h3>
        <p id="delete-msg" class="text-sm text-gray-300 mb-4 whitespace-pre-line"></p>
        <input id="delete-vid" type="hidden" />
        <div class="flex justify-end gap-2">
            <button id="delete-cancel" class="px-4 py-1.5 text-sm bg-gray-700 hover:bg-gray-600 text-gray-300 rounded-lg transition-colors">キャンセル</button>
            <button id="delete-submit" class="px-4 py-1.5 text-sm bg-red-700 hover:bg-red-600 text-white rounded-lg transition-colors">削除</button>
        </div>
    </div>
</div>

<!-- モーダル -->
<div id="modal" class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center p-4">
    <div class="flex items-center gap-3 max-w-5xl w-full">
        <button id="modal-prev" class="flex-shrink-0 w-10 h-10 rounded-full bg-gray-700/80 hover:bg-gray-600 text-white text-xl flex items-center justify-center transition-colors" title="前へ (←)">&#8249;</button>
        <div class="bg-gray-900 rounded-xl flex-1 min-w-0 border border-gray-700 h-[90vh] flex flex-col" onclick="event.stopPropagation()">
            <!-- ヘッダー (全幅) -->
            <div class="flex justify-between items-center p-4 border-b border-gray-800 flex-shrink-0">
                <div class="flex items-center gap-3 min-w-0">
                    <span id="modal-counter" class="text-xs text-gray-500 flex-shrink-0"></span>
                    <span id="modal-scene-badge" class="inline-block px-2 py-0.5 text-xs font-medium rounded bg-gray-700 text-gray-400 flex-shrink-0"></span>
                    <h3 id="modal-title" class="text-lg font-bold text-brand-light truncate"></h3>
                </div>
                <button id="modal-close-btn" class="text-gray-500 hover:text-white text-2xl flex-shrink-0 ml-4">&times;</button>
            </div>
            <!-- ボディ (詳細 + 同一クラスタ横並び) -->
            <div class="flex flex-1 min-h-0 overflow-hidden">
                <!-- メインコンテンツ -->
                <div class="flex-1 min-w-0 p-4 overflow-hidden">
                    <img id="modal-img" src="" class="w-full rounded-lg bg-gray-800 mb-4" />
                    <div class="relative">
                        <div id="modal-ocr" class="bg-gray-800 rounded-lg px-3 py-2 pr-10 text-sm text-gray-300 whitespace-pre-wrap overflow-y-scroll leading-5 h-[5.6rem]"></div>
                        <button id="modal-ocr-copy" class="group absolute top-2 right-2 w-6 h-6 rounded bg-gray-700 hover:bg-gray-600 text-gray-400 hover:text-white text-xs flex items-center justify-center transition-colors">&#x2398;<span class="hidden group-hover:block absolute right-8 top-0 whitespace-nowrap bg-gray-900 text-gray-300 text-[10px] px-2 py-1 rounded shadow-lg border border-gray-700">クリップボードにコピー</span></button>
                    </div>
                    <!-- OCR ソース別 diff 表示 (Phase 3) -->
                    <div id="modal-ocr-sources" class="mt-2 space-y-1 text-xs"></div>
                    <!-- 手動編集 UI (Phase 1) -->
                    <div id="modal-edit-area" class="hidden mt-3 bg-gray-800/50 rounded-lg p-3 border border-gray-700">
                        <div class="flex items-center justify-between mb-2">
                            <label class="text-xs font-bold text-amber-400">手動編集</label>
                            <div class="flex gap-2">
                                <button id="modal-edit-cancel" class="px-2 py-0.5 text-xs bg-gray-700 hover:bg-gray-600 text-gray-300 rounded">キャンセル</button>
                                <button id="modal-edit-save" class="px-3 py-0.5 text-xs bg-emerald-700 hover:bg-emerald-600 text-white rounded">保存</button>
                            </div>
                        </div>
                        <textarea id="modal-edit-text" class="w-full bg-gray-900 text-gray-200 text-sm rounded p-2 border border-gray-700 focus:border-brand outline-none" rows="3"></textarea>
                    </div>
                    <div class="mt-2 flex items-center gap-2 justify-end">
                        <button id="modal-edit-btn" class="px-2 py-0.5 text-xs bg-amber-900/50 hover:bg-amber-800/60 text-amber-300 rounded transition-colors">✎ 編集</button>
                        <button id="modal-adopt-btn" class="hidden px-2 py-0.5 text-xs bg-emerald-900/70 hover:bg-emerald-800 text-emerald-200 rounded transition-colors">✓ 採用する</button>
                        <button id="modal-exclude-btn" class="hidden px-2 py-0.5 text-xs bg-amber-900/50 hover:bg-amber-800/60 text-amber-300 rounded transition-colors">✕ 不採用にする</button>
                    </div>
                    <div class="mt-3 flex gap-4 text-xs text-gray-600">
                        <span id="modal-scene"></span>
                        <span id="modal-fp" class="font-mono"></span>
                        <span id="modal-time"></span>
                    </div>
                </div>
                <!-- アンカー比較 (右サイド) -->
                <div id="modal-anchor-compare" class="hidden w-72 flex-shrink-0 border-l border-gray-800 flex flex-col">
                    <div class="flex items-center justify-between p-3 border-b border-gray-800 flex-shrink-0">
                        <h4 class="text-xs font-bold text-amber-400">マスターノード</h4>
                        <div class="flex gap-1">
                            <button id="anchor-adopt-btn" class="px-2 py-0.5 bg-emerald-900/70 hover:bg-emerald-800 text-emerald-200 text-[10px] font-bold rounded transition-colors">✓ 採用に変更</button>
                            <button id="anchor-exclude-btn" class="px-2 py-0.5 bg-amber-900/50 hover:bg-amber-800/60 text-amber-300 text-[10px] font-bold rounded transition-colors">✕ 不採用に変更</button>
                        </div>
                    </div>
                    <div id="modal-anchor-content" class="flex flex-col gap-2 p-2 overflow-y-auto flex-1 min-h-0">
                        <img id="anchor-master-img" src="" class="w-full rounded-lg bg-gray-800" />
                        <div class="space-y-1">
                            <div id="anchor-master-ocr" class="bg-gray-800 rounded-lg px-3 py-2 text-xs text-gray-300 whitespace-pre-wrap max-h-24 overflow-y-auto"></div>
                            <div class="flex gap-2 text-[10px] text-gray-500">
                                <span id="anchor-phash" class="font-mono"></span>
                                <span id="anchor-textsim" class="font-mono"></span>
                            </div>
                            <div id="anchor-method-badge" class="inline-block px-2 py-0.5 text-[10px] font-medium rounded"></div>
                            <div id="anchor-discard-reason" class="hidden px-2 py-1 text-[10px] rounded bg-red-900/40 text-red-300 mt-1"></div>
                            <div id="anchor-master-fp" class="text-[10px] text-gray-600 font-mono"></div>
                        </div>
                    </div>
                </div>
                <!-- 同一クラスタ (右サイド) -->
                <div id="modal-cluster" class="hidden w-64 flex-shrink-0 border-l border-gray-800 flex flex-col">
                    <div class="flex items-center justify-between p-3 border-b border-gray-800 flex-shrink-0">
                        <h4 class="text-xs font-bold text-gray-400">同一クラスタ</h4>
                        <button id="cluster-promote-btn" class="px-2 py-0.5 bg-green-700 hover:bg-green-600 text-white text-[10px] font-bold rounded transition-colors disabled:opacity-50 disabled:cursor-not-allowed hidden" disabled>変更</button>
                    </div>
                    <div id="modal-cluster-grid" class="flex flex-col gap-2 p-2 overflow-y-auto flex-1 min-h-0"></div>
                </div>
            </div>
        </div>
        <button id="modal-next" class="flex-shrink-0 w-10 h-10 rounded-full bg-gray-700/80 hover:bg-gray-600 text-white text-xl flex items-center justify-center transition-colors" title="次へ (→)">&#8250;</button>
    </div>
</div>

<script>
(function() {
    // グローバルヘッダーを Dashboard sticky 内に移動（一体化）
    const _gh = document.getElementById('global-header');
    const _ds = document.getElementById('dashboard-sticky');
    if (_gh && _ds) { _ds.insertBefore(_gh, _ds.firstChild); }

    const POLL_INTERVAL = 3000;
    const API_BASE = 'api/search.php';
    const grid = document.getElementById('grid');
    const stats = document.getElementById('stats');
    const modal = document.getElementById('modal');
    let allScreens = [];
    let filteredScreens = [];  // フィルタ済み配列 (モーダルナビもこれを使う)
    let maxId = 0;
    let currentTab = 'live';
    let pollTimer = null;
    let currentSessionId = '';  // 空=最新セッション
    let pollCount = 0;
    const FULL_REFRESH_EVERY = 5;  // 5回に1回フルリフレッシュ (ステータス更新反映)
    let knownSessions = [];
    let pendingChanges = {};  // Final タブ: master_fp → target user_excluded
    let selectedForGroup = new Set();  // Final タブ: 統合選択中の master_fp
    let selectedLiveScreens = new Set();  // Live タブ: 選択中の screen id
    let _previewModalIdx = -1;  // プレビュー用モーダルインデックス
    let _previewModalItems = [];  // プレビュー用アイテムリスト
    let _previewModalShow = null;  // プレビュー用モーダル表示関数
    let geminiEnabled = false;  // GEMINI_API_KEY が設定されているか (API レスポンスで更新)
    let autoRefreshPaused = false;  // 自動更新一時停止フラグ
    let _debugMode = localStorage.getItem('lc_debug') !== '0';  // デバッグモード (デフォルト有効)
    const TRASH_ICON = '<svg class="w-3.5 h-3.5 inline" viewBox="0 0 16 16" fill="currentColor"><path d="M11 1.75V3h2.25a.75.75 0 010 1.5H2.75a.75.75 0 010-1.5H5V1.75C5 .784 5.784 0 6.75 0h2.5C10.216 0 11 .784 11 1.75zM6.5 1.75a.25.25 0 01.25-.25h2.5a.25.25 0 01.25.25V3h-3V1.75zM4.496 6.675a.75.75 0 10-1.492.15l.66 6.6A1.75 1.75 0 005.405 15h5.19a1.75 1.75 0 001.741-1.575l.66-6.6a.75.75 0 00-1.492-.15l-.66 6.6a.25.25 0 01-.249.225h-5.19a.25.25 0 01-.249-.225l-.66-6.6z"/></svg>';
    const filterSelect = document.getElementById('filter-select');
    const sessionSelect = document.getElementById('session-select');
    const sortToggle = document.getElementById('sort-toggle');

    // URL パラメータ同期
    function syncUrlParams() {
        const url = new URL(window.location);
        url.searchParams.set('tab', currentTab);
        url.searchParams.set('filter', filterSelect.value);
        url.searchParams.set('sort', sortToggle.dataset.sort);
        if (currentSessionId) {
            url.searchParams.set('session', currentSessionId);
        } else {
            url.searchParams.delete('session');
        }
        history.replaceState(null, '', url);
    }

    function getUrlParam(key, fallback) {
        return new URLSearchParams(window.location.search).get(key) || fallback;
    }

    filterSelect.addEventListener('change', function() { renderAll(); syncUrlParams(); });
    sortToggle.addEventListener('click', function() {
        const cur = this.dataset.sort;
        const next = cur === 'desc' ? 'asc' : 'desc';
        this.dataset.sort = next;
        this.textContent = next === 'desc' ? '降順' : '昇順';
        renderAll();
        syncUrlParams();
    });
    sessionSelect.addEventListener('change', function() {
        currentSessionId = this.value;
        allScreens = [];
        maxId = 0;
        syncUrlParams();
        fetchLiveInitial();
    });

    function getGameParam() {
        return new URLSearchParams(window.location.search).get('game') || '';
    }

    function imgUrl(path) {
        if (!path) return '';
        return 'img.php?path=' + encodeURIComponent(path);
    }

    function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    // --- 日時短縮フォーマット (ISO/長い日時 → YYYY/MM/DD HH:MM:SS) ---
    function fmtShort(t) {
        if (!t) return '';
        const d = new Date(t.replace(' ', 'T'));
        if (isNaN(d)) return t.length > 19 ? t.substring(0, 19) : t;
        return `${d.getFullYear()}/${String(d.getMonth()+1).padStart(2,'0')}/${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}:${String(d.getSeconds()).padStart(2,'0')}`;
    }

    // --- 共通カード生成 (Live / Final / マージプレビュー) ---
    function buildCard(opts) {
        // opts: { thumb, title, ocrPreview, scene, time, badge, dots, dimClass, extraClass, dataAttr }
        const thumb = opts.thumb || '';
        const title = opts.title || '';
        const ocrPreview = opts.ocrPreview || '';
        const scene = opts.scene || '';
        const time = fmtShort(opts.time || '');
        const sceneBadge = scene && scene !== 'depth=0'
            ? `<span class="inline-block px-1.5 py-0.5 text-[9px] rounded bg-gray-800 text-gray-400">${escapeHtml(scene)}</span>`
            : '';
        const badgeHtml = opts.badge
            ? `<span class="px-1 py-0.5 text-[9px] rounded font-bold ${opts.badge.color}">${opts.badge.label}</span>`
            : '';
        const dotsHtml = (opts.dots && opts.dots.length) ? `<span class="flex gap-0.5 items-center">${opts.dots.join('')}</span>` : '';
        const dimClass = opts.dimClass || '';
        const extraClass = opts.extraClass || '';
        const dataAttr = opts.dataAttr || '';
        const extraHtml = opts.extraHtml || '';
        return `<div class="bg-gray-900 border border-gray-800 rounded-lg overflow-hidden cursor-pointer relative hover:border-brand/50 hover:shadow-lg hover:shadow-brand/10 transition-all${dimClass}${extraClass}" ${dataAttr}>
            <div>
                ${thumb ? `<img src="${thumb}" class="w-full aspect-video object-cover bg-gray-800" loading="lazy" />` : '<div class="w-full aspect-video bg-gray-800 flex items-center justify-center text-3xl">📱</div>'}
            </div>
            <div class="p-2">
                <p class="text-xs font-semibold text-gray-200 truncate">${escapeHtml(title)}</p>
                <p class="text-[10px] text-gray-500 truncate mt-0.5">${escapeHtml(ocrPreview)}</p>
                <div class="flex items-center justify-between mt-1">
                    <div class="flex items-center gap-1.5">${sceneBadge}${dotsHtml}${badgeHtml}</div>
                    <span class="text-[10px] text-gray-600">${escapeHtml(time)}</span>
                </div>
            </div>
            ${extraHtml}
        </div>`;
    }

    function renderCard(s, idx) {
        const thumb = s.thumbnail_path ? imgUrl(s.thumbnail_path) : (s.screenshot_path ? imgUrl(s.screenshot_path) : '');
        const isThinned = s.cluster_id !== null && s.cluster_id !== undefined && !s.is_representative;
        const dots = [];
        if (s.is_artifact === 1) dots.push('<span class="w-1.5 h-1.5 rounded-full bg-red-500" title="Gemini不採用"></span>');
        if (s.is_artifact === 2) dots.push('<span class="w-1.5 h-1.5 rounded-full bg-orange-500" title="ユーザー不採用"></span>');
        if (isThinned && !s.is_artifact) dots.push('<span class="w-1.5 h-1.5 rounded-full bg-gray-500" title="非代表"></span>');
        if (s.has_hq_ocr) dots.push('<span class="w-1.5 h-1.5 rounded-full bg-sky-500" title="HQ OCR済"></span>');
        if (s.is_representative) dots.push('<span class="w-1.5 h-1.5 rounded-full bg-emerald-500" title="採用"></span>');
        if (s.has_gemini) dots.push('<span class="w-1.5 h-1.5 rounded-full bg-amber-500" title="Gemini OCR済"></span>');
        if (s.has_manual) dots.push('<span class="w-1.5 h-1.5 rounded-full bg-pink-500" title="手動編集済"></span>');
        if (_debugMode && s.anchor_info && _debugAnchorMatchesSession(s.anchor_info, _debugFilterSession)) {
            const phaseLabel = _debugGetPhaseForSession(s.anchor_info, _debugFilterSession) || 'A';
            dots.push('<span class="px-1 rounded text-[9px] font-bold bg-cyan-400/80 text-black" title="アンカー: ' + escapeHtml(s.anchor_info) + '">' + phaseLabel + '</span>');
        }
        const isExcluded = (currentTab === 'final' && s.user_excluded) || (currentTab === 'live' && s.is_artifact > 0);
        const dimClass = (filterSelect.value === 'all' && (isThinned || isExcluded)) ? ' opacity-40' : '';
        const hasPending = s.master_fp && (s.master_fp in pendingChanges);
        const pendingMark = hasPending ? ' ring-2 ring-yellow-500/50' : '';
        const isGroupSelected = (currentTab === 'final' && s.master_fp && selectedForGroup.has(s.master_fp))
            || (currentTab === 'live' && s.id && selectedLiveScreens.has(s.id));
        const groupSelectMark = isGroupSelected ? ' ring-2 ring-blue-500' : '';
        // グループ選択中はアンカー枠を非表示（青枠を優先）
        const anchorMark = isGroupSelected ? '' : ((_debugMode && _debugFilterSession)
            ? (_debugAnchorMatchesSession(s.anchor_info, _debugFilterSession) ? ' ring-2 ring-cyan-400'
               : (s.all_mapping_info && s.all_mapping_info.includes('new:' + _debugFilterSession)) ? ' ring-2 ring-lime-400' : '')
            : '');
        return buildCard({
            thumb, title: s.name && s.name !== '(UNKNOWN)' ? s.name : '',
            ocrPreview: (s.ocr_text || '').substring(0, 80),
            scene: s.category, time: s.last_seen_at || '',
            dots, dimClass,
            extraClass: pendingMark + groupSelectMark + anchorMark,
            dataAttr: `data-idx="${idx}"`,
        });
    }

    function renderAll() {
        const filter = filterSelect.value;
        let filtered = allScreens;
        if (currentTab === 'final') {
            if (filter === 'excluded') {
                filtered = allScreens.filter(s => s.user_excluded);
            } else if (filter === 'adopted') {
                filtered = allScreens.filter(s => !s.user_excluded);
            } else if (filter === 'session') {
                // デバッグセッションで追加されたアンカー+新規のみ
                const fs = _debugFilterSession;
                if (fs) {
                    filtered = allScreens.filter(s =>
                        s.all_mapping_info && s.all_mapping_info.includes(fs)
                    );
                }
            }
            // 'all' はそのまま全件
        } else if (filter === 'reps') {
            filtered = allScreens.filter(s => (s.is_representative || s.cluster_id === null || s.cluster_id === undefined) && !s.is_artifact);
        } else if (filter === 'excluded') {
            filtered = allScreens.filter(s => s.is_artifact > 0);
        } else if (filter === 'thinned') {
            filtered = allScreens.filter(s => s.cluster_id !== null && s.cluster_id !== undefined && !s.is_representative);
        } else if (filter === 'pending') {
            filtered = allScreens.filter(s => (s.cluster_id === null || s.cluster_id === undefined) || (s.is_representative && !s.has_hq_ocr && !s.has_gemini));
        }
        // ソート: Live は API が降順(新しい順)、Final は API が昇順(古い順)
        const wantDesc = sortToggle.dataset.sort === 'desc';
        if (currentTab === 'final' && wantDesc) {
            filtered = [...filtered].reverse();
        } else if (currentTab === 'final' && !wantDesc) {
            // そのまま (API が昇順)
        } else if (currentTab === 'live' && !wantDesc) {
            filtered = [...filtered].reverse();
        }
        // Live + desc → そのまま (API が降順)
        filteredScreens = filtered;
        if (filtered.length === 0) {
            let msg;
            if (currentTab === 'live') {
                const f = filterSelect.value;
                if (allScreens.length === 0) {
                    msg = 'まだスクリーンが記録されていません。<br><code class="text-brand-light">auto_pilot.py -S</code> で起動してください。';
                } else if (f === 'reps') {
                    msg = '採用画面はありません。';
                } else if (f === 'excluded') {
                    msg = '不採用画面はありません。';
                } else if (f === 'thinned') {
                    msg = '非代表画面はありません。';
                } else if (f === 'pending') {
                    msg = '未処理の画面はありません。';
                } else {
                    msg = '該当する画面はありません。';
                }
            } else {
                msg = 'セッションをマージ後表示されます。';
            }
            grid.innerHTML = `<div class="col-span-full text-center text-gray-600 py-12">${msg}</div>`;
            return;
        }
        grid.innerHTML = filtered.map((s, i) => renderCard(s, i)).join('');
        const repsCount = allScreens.filter(s => s.is_representative).length;
        stats.textContent = filter === 'all'
            ? `全${allScreens.length}枚 (代表 ${repsCount})`
            : `全${filtered.length}枚`;
        // デバッグ統計
        const debugStats = document.getElementById('debug-stats');
        if (_debugMode && currentTab === 'final') {
            if (_debugSessionList.length === 0) _debugBuildSessionList();
            // デフォルトセッション設定
            if (!_debugFilterSession && _debugSessionList.length > 0) {
                _debugSessionIdx = 0;
                _debugFilterSession = _debugSessionList[0];
            }
            const fs = _debugFilterSession;
            const anchors = allScreens.filter(s => _debugAnchorMatchesSession(s.anchor_info, fs));
            const inserted = allScreens.filter(s => s.last_match_method === 'new');
            const p1 = anchors.filter(s => s.anchor_info && s.anchor_info.includes('phase1')).length;
            const p2 = anchors.filter(s => s.anchor_info && s.anchor_info.includes('phase2')).length;
            const p3 = anchors.filter(s => s.anchor_info && s.anchor_info.includes('phase3')).length;
            const p4 = anchors.filter(s => s.anchor_info && s.anchor_info.includes('phase4')).length;
            const p5 = anchors.filter(s => s.anchor_info && s.anchor_info.includes('phase5')).length;
            const p6 = anchors.filter(s => s.anchor_info && s.anchor_info.includes('phase6')).length;
            // セッション情報
            const sessionLabel = fs
                ? `${fs} (${_debugSessionIdx + 1}/${_debugSessionList.length})`
                : (_debugSessionList.length > 0 ? `↑↓でセッション切替 (${_debugSessionList.length}件)` : '');
            debugStats.textContent = `${sessionLabel}  P1:${p1} P2:${p2} P3:${p3} P4:${p4} P5:${p5} P6:${p6} 挿入:${inserted.length}`;
            debugStats.classList.remove('hidden');
            // フッターにセッション情報表示
            const dsi = document.getElementById('debug-session-info');
            dsi.textContent = fs || '';
            dsi.classList.remove('hidden');
        } else {
            debugStats.classList.add('hidden');
            document.getElementById('debug-session-info').classList.add('hidden');
        }
        _updateDebugSessionSelect();
    }

    // 昇順で末尾に画像追加時のスクロール追従
    function isNearBottom() {
        const threshold = 200;
        return (window.innerHeight + window.scrollY) >= (document.body.scrollHeight - threshold);
    }

    function scrollToBottom() {
        requestAnimationFrame(() => {
            window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
        });
    }

    // --- セッション一覧取得 ---
    async function fetchSessions() {
        const game = getGameParam();
        const params = new URLSearchParams({ action: 'get_sessions' });
        if (game) params.set('game', game);
        if (_currentVersionId) params.set('version', _currentVersionId);
        try {
            const res = await fetch(API_BASE + '?' + params);
            const data = await res.json();
            knownSessions = (data.sessions || []).map(s => s.session_dir);
            sessionSelect.innerHTML = '<option value="">最新セッション</option>';
            const older = (data.sessions || []).slice(1); // 最新を除外
            for (const s of older) {
                sessionSelect.innerHTML += `<option value="${escapeHtml(s.session_dir)}">${escapeHtml(s.session_dir)}</option>`;
            }
            // ドロップダウン再構築後に選択状態を復元
            sessionSelect.value = currentSessionId;
        } catch (e) {}
    }

    // --- Live タブ ---
    async function fetchLiveInitial() {
        await fetchSessions();
        // 「最新セッション」(value='') → 最新セッションIDで API を呼ぶ
        const sid = currentSessionId || (knownSessions.length > 0 ? knownSessions[0] : '');
        const game = getGameParam();
        const params = new URLSearchParams({ action: 'get_recent_screens', limit: '10000' });
        if (game) params.set('game', game);
        if (sid) params.set('session_id', sid);
        if (_currentVersionId) params.set('version', _currentVersionId);
        try {
            const res = await fetch(API_BASE + '?' + params);
            const data = await res.json();
            allScreens = data.screens || [];
            if (data.gemini_enabled !== undefined) geminiEnabled = data.gemini_enabled;
            if (allScreens.length > 0) {
                maxId = Math.max(...allScreens.map(s => s.id));
            }
            renderAll();
        } catch (e) {
            grid.innerHTML = '<div class="col-span-full text-center text-gray-500 py-12">準備中...</div>';
        }
    }

    async function pollLive() {
        pollCount++;
        // 新しいセッションが始まったか確認
        const game = getGameParam();
        const sessParams = new URLSearchParams({ action: 'get_sessions' });
        if (game) sessParams.set('game', game);
        if (_currentVersionId) sessParams.set('version', _currentVersionId);
        try {
            const sessRes = await fetch(API_BASE + '?' + sessParams);
            const sessData = await sessRes.json();
            const latestSessions = (sessData.sessions || []).map(s => s.session_dir);
            if (latestSessions.length > 0 && latestSessions[0] !== knownSessions[0]) {
                knownSessions = latestSessions;
                sessionSelect.innerHTML = '<option value="">最新セッション</option>';
                const olderPoll = (sessData.sessions || []).slice(1);
                for (const s of olderPoll) {
                    sessionSelect.innerHTML += `<option value="${escapeHtml(s.session_dir)}">${escapeHtml(s.session_dir)}</option>`;
                }
                currentSessionId = '';
                sessionSelect.value = '';
                allScreens = [];
                maxId = 0;
                pollCount = 0;
                syncUrlParams();
                fetchLiveInitial();
                return;
            }
        } catch (e) {}

        // 定期フルリフレッシュ: バックグラウンド処理のステータス変更を反映
        if (pollCount % FULL_REFRESH_EVERY === 0) {
            const sid = currentSessionId || (knownSessions.length > 0 ? knownSessions[0] : '');
            const fullParams = new URLSearchParams({ action: 'get_recent_screens', limit: '10000' });
            if (game) fullParams.set('game', game);
            if (sid) fullParams.set('session_id', sid);
            if (_currentVersionId) fullParams.set('version', _currentVersionId);
            try {
                const _modalScreenId = modalIdx >= 0 && filteredScreens[modalIdx] ? filteredScreens[modalIdx].id : null;
                const res = await fetch(API_BASE + '?' + fullParams);
                const data = await res.json();
                allScreens = data.screens || [];
                if (allScreens.length > 0) {
                    maxId = Math.max(...allScreens.map(s => s.id));
                }
                renderAll();
                // モーダル表示中は画面IDで位置を復元
                if (_modalScreenId !== null) {
                    const restored = filteredScreens.findIndex(s => s.id === _modalScreenId);
                    if (restored >= 0) {
                        modalIdx = restored;
                        document.getElementById('modal-counter').textContent =
                            (modalIdx + 1) + ' / ' + filteredScreens.length;
                        updateModalNav();
                    }
                }
            } catch (e) {}
            return;
        }

        // 差分ポーリング: 新規画像のみ取得
        const sid = currentSessionId || (knownSessions.length > 0 ? knownSessions[0] : '');
        const params = new URLSearchParams({
            action: 'get_recent_screens',
            limit: '100',
            after_id: String(maxId),
        });
        if (game) params.set('game', game);
        if (sid) params.set('session_id', sid);
        if (_currentVersionId) params.set('version', _currentVersionId);
        try {
            const res = await fetch(API_BASE + '?' + params);
            const data = await res.json();
            const newScreens = data.screens || [];
            if (newScreens.length > 0) {
                const shouldFollow = sortToggle.dataset.sort === 'asc' && isNearBottom();
                allScreens = newScreens.concat(allScreens);
                maxId = Math.max(maxId, Math.max(...newScreens.map(s => s.id)));
                if (modalIdx >= 0) {
                    // 画面IDで位置を復元 (参照が変わっても追跡可能)
                    const _curId = filteredScreens[modalIdx] ? filteredScreens[modalIdx].id : null;
                    renderAll();
                    if (_curId !== null) {
                        const newIdx = filteredScreens.findIndex(s => s.id === _curId);
                        if (newIdx >= 0) {
                            modalIdx = newIdx;
                            document.getElementById('modal-counter').textContent =
                                (modalIdx + 1) + ' / ' + filteredScreens.length;
                            updateModalNav();
                        }
                    }
                    return;
                }
                renderAll();
                if (shouldFollow) scrollToBottom();
            }
        } catch (e) {}
    }


    // --- 自動更新トグル ---
    window.toggleAutoRefresh = function() {
        if (currentTab !== 'live') return;
        const statusDot = document.getElementById('status-dot');
        const statusText = document.getElementById('status-text');
        if (autoRefreshPaused) {
            autoRefreshPaused = false;
            pollTimer = setInterval(pollLive, POLL_INTERVAL);
            statusDot.classList.remove('bg-gray-500');
            statusDot.classList.add('bg-green-500', 'animate-pulse');
            statusText.textContent = '自動更新中';
        } else {
            autoRefreshPaused = true;
            if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
            statusDot.classList.remove('bg-green-500', 'animate-pulse');
            statusDot.classList.add('bg-gray-500');
            statusText.textContent = '自動更新停止';
        }
    };

    // --- デバッグモード ---
    let _debugAnchorIdx = -1;  // 選択中のアンカーインデックス (-1 = 未選択)
    let _debugAnchorIndices = [];  // filteredScreens 内のアンカーのインデックス列
    let _debugSessionList = [];   // マージ済みセッションID一覧 (seed除外、新しい順)
    let _debugSessionIdx = -1;    // 選択中のセッション (-1 = 最新セッション)
    let _debugFilterSession = null; // フィルタ中のセッションID (null = 最新)

    function _debugBuildSessionList() {
        // anchor_info からセッションIDを抽出 (seed/new 以外)
        const sessionSet = new Set();
        for (const s of allScreens) {
            if (!s.anchor_info) continue;
            for (const part of s.anchor_info.split(',')) {
                const m = part.match(/:(.+)$/);
                if (m) sessionSet.add(m[1]);
            }
        }
        _debugSessionList = Array.from(sessionSet).sort().reverse();
    }

    function _debugAnchorMatchesSession(anchorInfo, sessionId) {
        if (!anchorInfo || !sessionId) return !!anchorInfo;
        return anchorInfo.split(',').some(p => p.endsWith(':' + sessionId));
    }

    function _debugGetPhaseForSession(anchorInfo, sessionId) {
        if (!anchorInfo) return null;
        const parts = anchorInfo.split(',');
        for (const p of parts) {
            if (!sessionId || p.endsWith(':' + sessionId)) {
                const m = p.match(/phase(\d)/);
                if (m) return 'P' + m[1];
            }
        }
        return 'A';
    }

    function _debugNavigateSession(direction) {
        if (!_debugMode || currentTab !== 'final') return;
        if (_debugSessionList.length === 0) _debugBuildSessionList();
        if (_debugSessionList.length === 0) return;

        _debugSessionIdx += direction;
        if (_debugSessionIdx < 0) _debugSessionIdx = 0;
        if (_debugSessionIdx >= _debugSessionList.length) _debugSessionIdx = _debugSessionList.length - 1;

        _debugFilterSession = _debugSessionList[_debugSessionIdx];
        _debugAnchorIdx = -1;
        _updateDebugSessionSelect();
        renderAll();
    }

    window.toggleDebug = function() {
        _debugMode = !_debugMode;
        localStorage.setItem('lc_debug', _debugMode ? '1' : '0');
        _debugAnchorIdx = -1;
        _debugSessionIdx = -1;
        _debugFilterSession = null;
        _debugSessionList = [];
        _updateDebugBtn();
        _updateDebugSessionSelect();
        renderAll();
    };
    function _updateDebugBtn() {
        const btn = document.getElementById('debug-toggle');
        if (!btn) return;
        if (_debugMode) {
            btn.className = 'px-2 py-1 text-[10px] rounded transition-colors bg-cyan-900/60 text-cyan-300 border border-cyan-700';
        } else {
            btn.className = 'px-2 py-1 text-[10px] rounded transition-colors bg-gray-800 text-gray-500 border border-gray-700';
        }
    }
    _updateDebugBtn();

    // デバッグセッション選択セレクトボックス
    const _debugSessionSelect = document.getElementById('debug-session-select');
    function _updateDebugSessionSelect() {
        if (!_debugMode || currentTab !== 'final') {
            _debugSessionSelect.classList.add('hidden');
            return;
        }
        if (_debugSessionList.length === 0) _debugBuildSessionList();
        if (_debugSessionList.length === 0) {
            _debugSessionSelect.classList.add('hidden');
            return;
        }
        _debugSessionSelect.classList.remove('hidden');
        // デフォルト: 最新セッション（リストの先頭）
        if (!_debugFilterSession && _debugSessionList.length > 0) {
            _debugSessionIdx = 0;
            _debugFilterSession = _debugSessionList[0];
        }
        _debugSessionSelect.innerHTML = _debugSessionList.map(sid =>
            `<option value="${escapeHtml(sid)}"${sid === _debugFilterSession ? ' selected' : ''}>${escapeHtml(sid)}</option>`
        ).join('');
    }
    _debugSessionSelect.addEventListener('change', function() {
        _debugFilterSession = this.value;
        _debugSessionIdx = _debugSessionList.indexOf(this.value);
        _debugAnchorIdx = -1;
        renderAll();
    });

    function _debugNavigateAnchor(direction) {
        if (!_debugMode || currentTab !== 'final') return;
        // アンカーインデックス列を構築 (セッションフィルタ適用)
        _debugAnchorIndices = [];
        for (let i = 0; i < filteredScreens.length; i++) {
            if (_debugAnchorMatchesSession(filteredScreens[i].anchor_info, _debugFilterSession))
                _debugAnchorIndices.push(i);
        }
        if (_debugAnchorIndices.length === 0) return;

        if (_debugAnchorIdx === -1) {
            // 未選択 → 方向に応じて最初 or 最後
            _debugAnchorIdx = direction > 0 ? 0 : _debugAnchorIndices.length - 1;
        } else {
            _debugAnchorIdx += direction;
            if (_debugAnchorIdx < 0) _debugAnchorIdx = 0;
            if (_debugAnchorIdx >= _debugAnchorIndices.length) _debugAnchorIdx = _debugAnchorIndices.length - 1;
        }

        const screenIdx = _debugAnchorIndices[_debugAnchorIdx];
        // 枠の更新
        _updateDebugSelection(screenIdx);
        // スクロール
        const card = grid.querySelector(`[data-idx="${screenIdx}"]`);
        if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        // フッター更新
        const ds = document.getElementById('debug-stats');
        if (ds) {
            const s = filteredScreens[screenIdx];
            const label = s.name || s.ocr_text?.substring(0, 30) || '';
            ds.textContent = label;
            const da = document.getElementById('debug-anchor');
            if (da) { da.textContent = `Anchor ${_debugAnchorIdx + 1}/${_debugAnchorIndices.length}`; da.classList.remove('hidden'); }
        }
    }

    function _updateDebugSelection(selectedScreenIdx) {
        // 全カードの選択枠をリセット (ring-2 はアンカー枠と共有なので触らない)
        grid.querySelectorAll('.debug-selected').forEach(el => {
            el.classList.remove('debug-selected', 'ring-4', 'ring-orange-400');
            // アンカー/挿入枠がなければ ring-2 も外す
            if (!el.classList.contains('ring-cyan-400') && !el.classList.contains('ring-lime-400')) {
                el.classList.remove('ring-2');
            }
        });
        // 選択カードに枠を追加 (ring-4 でアンカー枠より太く)
        if (selectedScreenIdx >= 0) {
            const card = grid.querySelector(`[data-idx="${selectedScreenIdx}"]`);
            if (card) {
                card.classList.add('debug-selected', 'ring-4', 'ring-orange-400');
            }
        }
    }

    // --- Final タブ ---
    let showExcluded = false;
    async function fetchFinal() {
        const game = getGameParam();
        const params = new URLSearchParams({ action: 'get_final_screens_all', limit: '10000' });
        if (game) params.set('game', game);
        if (_currentVersionId) params.set('version', _currentVersionId);
        try {
            const res = await fetch(API_BASE + '?' + params);
            const data = await res.json();
            allScreens = data.screens || [];
            if (data.gemini_enabled !== undefined) geminiEnabled = data.gemini_enabled;
            renderAll();
        } catch (e) {
            grid.innerHTML = '<div class="col-span-full text-center text-gray-500 py-12">準備中...</div>';
        }
    }


    // --- バージョンセレクター (switchTab より前に宣言) ---
    let _currentVersionId = null;
    let _currentVersionName = '';
    const versionSelect = document.getElementById('version-select');

    // --- セッションナビゲーション ---
