            // 削除ボタン
            mc.querySelectorAll('.delete-session-btn').forEach(btn => {
                btn.addEventListener('click', () => confirmDeleteSession(btn.dataset.sessionId, btn.dataset.nodeCount, btn.dataset.status || ''));
            });
            // グラフ構築ボタン
            mc.querySelectorAll('.build-graph-btn').forEach(btn => {
                btn.addEventListener('click', () => buildSessionGraph(btn.dataset.sessionId));
            });
            // 後処理実行ボタン (バックグラウンド未完了)
            mc.querySelectorAll('.bg-process-btn').forEach(btn => {
                btn.addEventListener('click', () => processSessionBg(btn.dataset.sessionId));
            });
            // ページ切り替えリンク
            mc.querySelectorAll('.merge-page-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (this.classList.contains('pointer-events-none')) return;
                    _mergePages[this.dataset.section] = parseInt(this.dataset.page);
                    fetchMergeTab();
                });
            });
            // 未マージボタン: can_unmerge チェック → disabled 制御
            mc.querySelectorAll('.unmerge-btn').forEach(btn => {
                const sid = btn.dataset.sessionId;
                btn.disabled = true;
                btn.classList.add('opacity-60', 'cursor-not-allowed');
                fetch(API_BASE + '?action=can_unmerge&session_id=' + encodeURIComponent(sid))
                    .then(r => r.json())
                    .then(data => {
                        if (data.ok) {
                            btn.disabled = false;
                            btn.classList.remove('opacity-60', 'cursor-not-allowed');
                            btn.addEventListener('click', () => confirmUnmerge(sid));
                        } else {
                            btn.title = data.reason || '未マージ不可';
                        }
                    })
                    .catch(() => { btn.title = 'チェック失敗'; });
            });
            // 操作実行中ならボタンを再 disable
            if (_operationInProgress) _setOperationButtons(true);
        } catch (e) {
            mc.innerHTML = '<div class="text-center text-gray-500 py-12">準備中...</div>';
        }
    }


    async function pollMergeResult(mc, label, toastHandle) {
        return new Promise((resolve) => {
            const timer = setInterval(async () => {
                try {
                    const r = await fetch(API_BASE + '?action=merge_progress');
                    const d = await r.json();
                    if (d.error) console.warn('[pollMergeResult] server error:', d.error);
                    if (d.progress && toastHandle) {
                        const p = d.progress;
                        toastHandle.update(`${p.phase} (${p.anchors} / ${p.total})`);
                    }
                    if (d.done) {
                        clearInterval(timer);
                        resolve(d.result);
                    }
                } catch (e) {
                    console.error('[pollMergeResult] fetch/parse error:', e);
                }
            }, 2000);
        });
    }

    async function showMergePreview(sessionId) {
        return await withOperationLock('プレビュー', async () => {
            return await _showMergePreview(sessionId);
        });
    }
    async function _showMergePreview(sessionId) {
        const mc = document.getElementById('merge-container');
        const toastHandle = showToast('プレビュー計算中...', 'info', { sticky: true });
        try {
            await fetch(API_BASE + '?action=preview_merge&session_id=' + encodeURIComponent(sessionId));
            const data = await pollMergeResult(mc, 'プレビュー計算中', toastHandle);
            if (toastHandle) toastHandle.remove();
            if (!data || data.error) { mc.innerHTML = `<div class="text-red-500 py-12">${escapeHtml(data?.error || 'プレビュー失敗')}</div>`; return; }
            // フェーズ定義 (バックエンドから取得、フォールバック付き)
            const phaseDefs = data.phase_defs || {};
            function phaseColor(method) {
                const d = phaseDefs[method];
                return d ? `${d.color_bg} ${d.color_text}` : 'bg-gray-700 text-gray-400';
            }
            function phaseLabel(method) {
                const d = phaseDefs[method];
                return d ? d.label : method;
            }
            function phaseDesc(method) {
                const d = phaseDefs[method];
                return d ? `${d.label}: ${d.description}` : method;
            }
            let html = '<div class="space-y-6">';
            html += `<div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-bold text-brand-light">マージプレビュー: ${escapeHtml(sessionId)}</h3>
                    <p class="text-sm text-gray-400 mt-1">新規追加ノード: ${(data.new_nodes || []).filter(n => n.insertable).length} / アンカー: ${data.matches.filter(m => !m.excluded_match).length}${data.summary.excluded_match ? ' / 不採用一致: ' + data.summary.excluded_match : ''} / セッション画面: ${data.session_screens} / マスター現状: ${data.master_nodes_before} ノード</p>
                </div>
                <div class="flex items-center gap-2">
                    <span id="preview-select-hint" class="text-xs text-gray-500">Shift+クリックで選択</span>
                    <span id="preview-select-count" class="text-xs text-amber-300"></span>
                    <button id="preview-restore-btn" class="px-3 py-1 bg-emerald-900/70 hover:bg-emerald-800/80 text-emerald-200 text-xs rounded transition-colors disabled:opacity-60 disabled:cursor-not-allowed" disabled>✓ 採用</button>
                    <button id="preview-exclude-btn" class="px-3 py-1 bg-amber-900/50 hover:bg-amber-800/60 text-amber-300 text-xs rounded transition-colors disabled:opacity-60 disabled:cursor-not-allowed" disabled>✕ 不採用</button>
                    <button id="preview-recalc-btn" class="hidden px-3 py-1.5 bg-violet-900/60 hover:bg-violet-800/70 text-violet-200 text-xs rounded transition-colors">再計算</button>
                    <button onclick="fetchMergeTab()" class="px-3 py-1.5 bg-gray-700 hover:bg-gray-600 text-gray-300 text-xs rounded">戻る</button>
                    <button id="execute-merge-btn" class="px-4 py-1.5 bg-cyan-900/50 hover:bg-cyan-800/60 text-cyan-300 text-sm font-bold rounded">マージ実行</button>
                </div>
            </div>`;
            const sm = data.summary;
            // プレビュー用アイテムリスト (モーダル表示用)
            const previewItems = [];
            const GRID_CLS = 'grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3';

            // 新規追加ノード (SafeInsert 判定済み)
            const insertableNodes = (data.new_nodes || []).filter(n => n.insertable);
            html += `<h4 class="text-sm font-bold text-lime-400 mt-4">新規追加ノード (${insertableNodes.length} / ${data.session_screens})</h4>`;
            if (insertableNodes.length > 0) {
                html += `<div class="${GRID_CLS}">`;
                for (const n of insertableNodes) {
                    const item = { thumb: n.thumb, title: n.title, scene: n.scene,
                                   discovered_at: n.discovered_at, ocr_text: n.ocr_text,
                                   screenshot: n.screenshot, fp: n.fp };
                    html += buildCard({
                        thumb: item.thumb ? imgUrl(item.thumb) : '', title: item.title,
                        ocrPreview: (item.ocr_text || '').substring(0, 80),
                        scene: item.scene, time: item.discovered_at || '',
                        dataAttr: `data-preview-idx="${previewItems.length}"`,
                    });
                    previewItems.push(item);
                }
                html += '</div>';
            } else {
                html += '<p class="text-gray-600 text-sm">新規追加ノードはありません</p>';
            }

            // 不採用ノード一致セクション
            const excludedMatches = data.matches.filter(m => m.excluded_match);
            if (excludedMatches.length > 0) {
                html += `<h4 class="text-sm font-bold text-orange-400 mt-4">不採用ノード一致 (${excludedMatches.length})</h4>`;
                html += '<p class="text-xs text-gray-500 mb-2">不採用マスターノードに一致した画面 (重複防止用、アンカーには含まれない)</p>';
                html += `<div class="${GRID_CLS}">`;
                for (const m of excludedMatches) {
                    const item = { thumb: m.session_thumb, title: m.session_title, scene: m.session_scene,
                                   discovered_at: m.session_discovered_at, ocr_text: m.session_ocr_text,
                                   screenshot: m.session_screenshot, fp: m.session_fp,
                                   master_fp: m.master_fp, method: m.method, score: m.score,
                                   master_title: m.master_title, master_thumb: m.master_thumb,
                                   excluded_match: true };
                    previewItems.push(item);
                    const idx = previewItems.length - 1;
                    const thumb = m.session_thumb ? imgUrl(m.session_thumb) : '';
                    html += `<div class="preview-card border border-orange-900/50 rounded-lg overflow-hidden bg-gray-900/50 cursor-pointer hover:border-orange-700/70 transition-colors" data-preview-idx="${idx}" data-fp="${m.session_fp}">
                        ${thumb ? `<img src="${thumb}" class="w-full aspect-video object-cover bg-gray-800" loading="lazy" />` : '<div class="w-full aspect-video bg-gray-800"></div>'}
                        <div class="p-1.5"><p class="text-[10px] text-orange-300 truncate">${escapeHtml(m.session_title || '')}</p>
                        <span class="text-[9px] bg-orange-900/50 text-orange-300 px-1 rounded">${phaseLabel(m.method)}</span></div></div>`;
                }
                html += '</div>';
            }

            // アンカー一覧 (時系列順、採用+棄却混在、不採用ノード一致は除外)
            const activeCount = data.matches.filter(m => !m.discarded && !m.excluded_match).length;
            const discardedCount = data.matches.filter(m => m.discarded).length;
            // Phase ごとの棄却数を集計
            const discardedByPhase = {};
            data.matches.filter(m => m.discarded).forEach(m => {
                discardedByPhase[m.method] = (discardedByPhase[m.method] || 0) + 1;
            });
            if (data.matches.length > 0) {
                const phaseBtns = Object.entries(phaseDefs).sort((a,b) => a[1].order - b[1].order).map(([k,d]) => {
                    const adopted = sm[k] || 0;
                    const rejected = discardedByPhase[k] || 0;
                    const total = adopted + rejected;
                    const label = rejected > 0 ? `${d.label}: ${adopted}+${rejected}` : `${d.label}: ${adopted}`;
                    return `<button data-phase-btn="${k}" class="px-2 py-0.5 rounded transition-all ${d.color_bg} ${d.color_text} hover:brightness-125">${label}</button>`;
                }).join('');
                html += `<div class="flex items-center justify-between mt-4">
                    <div class="flex items-center gap-3">
                        <h4 class="text-sm font-bold text-cyan-400">アンカー一覧 (採用 ${activeCount} / ${data.session_screens}${discardedCount > 0 ? ', 不採用 ' + discardedCount : ''})</h4>
                    </div>
                    <div class="flex gap-1.5 text-xs items-center">${phaseBtns}<button id="phase-info-btn" class="ml-1 w-5 h-5 rounded-full bg-gray-700 hover:bg-gray-600 text-gray-400 hover:text-gray-200 text-xs font-bold italic transition-colors" title="Phase 説明">i</button></div>
                </div>`;
                // Phase 説明パネル
                html += `<div id="phase-info-panel" class="hidden mt-2 bg-gray-900 border border-gray-700 rounded-lg p-4 text-xs text-gray-300 space-y-2">
                    <div class="flex justify-between items-start">
                        <h5 class="text-sm font-bold text-gray-200 mb-2">アンカーマッチング Phase 説明</h5>
                        <button id="phase-info-close" class="text-gray-500 hover:text-gray-300">&times;</button>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div class="space-y-2">
                            <div><span class="${phaseDefs.phase1_tap_text?.color_bg} ${phaseDefs.phase1_tap_text?.color_text} px-1.5 py-0.5 rounded font-bold">P1</span> <b>tap + テキスト一致</b><br/>タップ遷移のテキストあり画面を完全一致・前方一致・あいまい一致で比較。最も信頼度が高い。</div>
                            <div><span class="${phaseDefs.phase2_auto_text?.color_bg} ${phaseDefs.phase2_auto_text?.color_text} px-1.5 py-0.5 rounded font-bold">P2</span> <b>auto + テキスト一致</b><br/>自動遷移の画面をP1と同じ手法で比較。P1アンカーとの相対位置で範囲を制限。</div>
                            <div><span class="${phaseDefs.phase3_tap_phash?.color_bg} ${phaseDefs.phase3_tap_phash?.color_text} px-1.5 py-0.5 rounded font-bold">P3</span> <b>tap + phash (テキスト空)</b><br/>テキストがない画面をphash（画像ハッシュ）のみで比較。前後にアンカーが必要。</div>
                        </div>
                        <div class="space-y-2">
                            <div><span class="${phaseDefs.phase4_gemini_text?.color_bg} ${phaseDefs.phase4_gemini_text?.color_text} px-1.5 py-0.5 rounded font-bold">P4</span> <b>Gemini テキスト判定</b><br/>P1〜P3で未マッチの画面のOCRテキストをGeminiに送信し同一画面か判定。画像なしのため安価。</div>
                            <div><span class="${phaseDefs.phase5_gemini_image?.color_bg} ${phaseDefs.phase5_gemini_image?.color_text} px-1.5 py-0.5 rounded font-bold">P5</span> <b>Gemini Flash-Lite 画像判定</b><br/>P3の検証 + P4棄却の再検証 + 新規候補の画像ペアをGemini Flash-Liteで判定。</div>
                            <div><span class="${phaseDefs.phase6_gemini_flash?.color_bg} ${phaseDefs.phase6_gemini_flash?.color_text} px-1.5 py-0.5 rounded font-bold">P6</span> <b>Gemini Flash 画像判定</b><br/>P5棄却の再審査（セカンドオピニオン）+ より広い範囲の新規候補をFlashで判定。P6棄却が最終棄却。</div>
                        </div>
                    </div>
                    <div class="mt-3 pt-2 border-t border-gray-800 text-gray-400 space-y-1">
                        <p><b>棄却の流れ:</b> P4棄却 → P5で画像再検証 → P5棄却 → P6で再審査 → P6棄却 = 最終棄却</p>
                        <p><b>キャッシュ:</b> 各Phaseの判定結果はDBにキャッシュされ、2回目以降はAPI呼び出し不要</p>
                        <p><b>ボタン操作:</b> 各Phaseボタンをクリックするとそのフェーズの結果を非表示にできます</p>
                    </div>
                </div>`;
                html += `<div id="anchor-grid" class="${GRID_CLS}">`;
                for (const m of data.matches.filter(m => !m.excluded_match)) {
                    const color = phaseColor(m.method);
                    let badgeLabel;
                    if (m.discarded) {
                        // 元フェーズ + P6取消線 (最終棄却は P6)
                        badgeLabel = `${phaseLabel(m.method)} <span class="${phaseColor('phase6_gemini_flash')} px-1 py-0.5 rounded"><s>${phaseLabel('phase6_gemini_flash')}</s></span>`;
                    } else {
                        badgeLabel = phaseLabel(m.method);
                    }
                    const item = { thumb: m.session_thumb, title: m.session_title, scene: m.session_scene,
                                   discovered_at: m.session_discovered_at, ocr_text: m.session_ocr_text,
                                   screenshot: m.session_screenshot, fp: m.session_fp,
                                   method: m.method, master_fp: m.master_fp,
                                   discarded: !!m.discarded, discard_reason: m.discard_reason || '' };
                    const scoreInfo = (m.phash_dist >= 0 ? `phash:${m.phash_dist}` : '') + (m.text_sim >= 0 ? ` sim:${m.text_sim}` : '');
                    const discardOverlay = m.discarded ? '<div class="excluded-overlay absolute inset-0 bg-black/40 flex items-start justify-end pointer-events-none p-1.5"><span class="text-red-400/80 font-bold text-xs bg-black/60 px-1.5 py-0.5 rounded">不採用</span></div>' : '';
                    html += buildCard({
                        thumb: item.thumb ? imgUrl(item.thumb) : '', title: item.title,
                        ocrPreview: scoreInfo ? scoreInfo + '  ' + (item.ocr_text || '').substring(0, 60) : (item.ocr_text || '').substring(0, 80),
                        scene: item.scene, time: item.discovered_at || '',
                        badge: { color, label: badgeLabel },
                        dataAttr: `data-preview-idx="${previewItems.length}" data-discarded="${m.discarded ? '1' : '0'}" data-phase="${m.method}"`,
                        extraClass: m.discarded ? ' relative' : '',
                        extraHtml: discardOverlay,
                    });
                    previewItems.push(item);
                }
                html += '</div>';
            }
            html += '</div>';
            mc.innerHTML = html;
            mc.scrollIntoView({ behavior: 'smooth', block: 'start' });
            // Phase 説明パネルのトグル
            const infoBtn = document.getElementById('phase-info-btn');
            const infoPanel = document.getElementById('phase-info-panel');
            const infoClose = document.getElementById('phase-info-close');
            if (infoBtn && infoPanel) {
                infoBtn.addEventListener('click', () => infoPanel.classList.toggle('hidden'));
                if (infoClose) infoClose.addEventListener('click', () => infoPanel.classList.add('hidden'));
            }
            // Phase ボタンフィルター (初期全ON、タップでそのPhaseをOFF、再タップでON)
            // _hiddenPhases: OFFにされたPhaseのSet (初期は空 = 全表示)
            const _hiddenPhases = new Set();
            function applyPhaseFilter() {
                const anchorGrid = document.getElementById('anchor-grid');
                if (!anchorGrid) return;
                anchorGrid.querySelectorAll('[data-phase]').forEach(card => {
                    const hidden = _hiddenPhases.has(card.dataset.phase);
                    card.style.display = hidden ? 'none' : '';
                });
                document.querySelectorAll('[data-phase-btn]').forEach(b => {
                    const hidden = _hiddenPhases.has(b.dataset.phaseBtn);
                    b.style.opacity = hidden ? '0.3' : '';
                });
            }
            document.querySelectorAll('[data-phase-btn]').forEach(btn => {
                btn.addEventListener('click', () => {
                    const phase = btn.dataset.phaseBtn;
                    if (_hiddenPhases.has(phase)) {
                        _hiddenPhases.delete(phase);
                    } else {
                        _hiddenPhases.add(phase);
                    }
                    applyPhaseFilter();
                });
            });
            // アンカー除外・復帰管理 (Shift+クリック選択方式)
            const excludedGeminiFps = new Set();    // 手動除外
            const restoredDiscardedFps = new Set(); // 棄却ノードの手動復帰
            const selectedPreviewFps = new Set();
            function updatePreviewActionBar() {
                const cnt = selectedPreviewFps.size;
                document.getElementById('preview-select-count').textContent = cnt > 0 ? `${cnt} 件選択中` : '';
                document.getElementById('preview-exclude-btn').disabled = cnt === 0;
                document.getElementById('preview-restore-btn').disabled = cnt === 0;
            }
            function renderPreviewSelection() {
                mc.querySelectorAll('[data-preview-idx]').forEach(card => {
                    const idx = parseInt(card.dataset.previewIdx, 10);
                    const item = previewItems[idx];
                    if (!item) return;
                    const isSelected = selectedPreviewFps.has(item.fp);
                    const isExcluded = excludedGeminiFps.has(item.fp);
                    card.classList.toggle('ring-2', isSelected);
                    card.classList.toggle('ring-cyan-400', isSelected);
                    // 不採用オーバーレイ
                    let overlay = card.querySelector('.excluded-overlay');
                    if (isExcluded && !overlay) {
                        overlay = document.createElement('div');
                        overlay.className = 'excluded-overlay absolute inset-0 bg-black/40 flex items-start justify-end pointer-events-none p-1.5';
                        overlay.innerHTML = '<span class="text-red-400/80 font-bold text-xs bg-black/60 px-1.5 py-0.5 rounded">不採用</span>';
                        card.style.position = 'relative';
                        card.appendChild(overlay);
                    } else if (!isExcluded && overlay) {
                        overlay.remove();
                    }
                });
            }
            // Shift+クリックでアンカー選択
            mc.addEventListener('click', (e) => {
                if (!e.shiftKey) return;
                const card = e.target.closest('[data-preview-idx]');
                if (!card) return;
                e.preventDefault();
                const idx = parseInt(card.dataset.previewIdx, 10);
                const item = previewItems[idx];
                if (!item || !item.master_fp) return; // アンカーのみ対象
                if (selectedPreviewFps.has(item.fp)) {
                    selectedPreviewFps.delete(item.fp);
                } else {
                    selectedPreviewFps.add(item.fp);
                }
                renderPreviewSelection();
                updatePreviewActionBar();
            });
            // 除外ボタン
            document.getElementById('preview-exclude-btn').addEventListener('click', () => {
                const fps = [...selectedPreviewFps];
                const items = fps.map(fp => previewItems.find(i => i.fp === fp)).filter(Boolean);
                let body = `<p class="text-sm text-gray-300 mb-3">${items.length} 件のアンカーを不採用にします。</p>`;
                body += '<div class="flex flex-wrap gap-2 max-h-48 overflow-y-auto">';
                for (const item of items) {
                    body += `<div class="w-28"><img src="${item.thumb ? imgUrl(item.thumb) : ''}" class="w-full rounded" /><p class="text-[9px] text-gray-500 truncate mt-1">${escapeHtml(item.title || '')}</p></div>`;
                }
                body += '</div>';
                showConfirmDialog(body, () => {
                    for (const fp of fps) excludedGeminiFps.add(fp);
                    selectedPreviewFps.clear();
                    renderPreviewSelection();
                    updatePreviewActionBar();
                    document.getElementById('confirm-popup').classList.add('hidden');
                    document.getElementById('confirm-popup').classList.remove('flex');
                    if (typeof showRecalcIfNeeded === 'function') showRecalcIfNeeded();
                }, { okLabel: '不採用', danger: true });
            });
            // 復帰ボタン (除外済み or 棄却ノード)
            document.getElementById('preview-restore-btn').addEventListener('click', () => {
                const fps = [...selectedPreviewFps].filter(fp => {
                    const item = previewItems.find(i => i.fp === fp);
                    return excludedGeminiFps.has(fp) || (item && item.discarded && !restoredDiscardedFps.has(fp));
                });
                if (fps.length === 0) { showToast('不採用または棄却済みのアンカーを選択してください', 'error'); return; }
                const items = fps.map(fp => previewItems.find(i => i.fp === fp)).filter(Boolean);
                let body = `<p class="text-sm text-gray-300 mb-3">${items.length} 件のアンカーを採用します。</p>`;
                body += '<div class="flex flex-wrap gap-2 max-h-48 overflow-y-auto">';
                for (const item of items) {
                    body += `<div class="w-28"><img src="${item.thumb ? imgUrl(item.thumb) : ''}" class="w-full rounded" /><p class="text-[9px] text-gray-500 truncate mt-1">${escapeHtml(item.title || '')}</p></div>`;
                }
                body += '</div>';
                showConfirmDialog(body, () => {
                    for (const fp of fps) {
                        excludedGeminiFps.delete(fp);
                        const item = previewItems.find(i => i.fp === fp);
                        if (item && item.discarded) restoredDiscardedFps.add(fp);
                    }
                    selectedPreviewFps.clear();
                    renderPreviewSelection();
                    updatePreviewActionBar();
                    document.getElementById('confirm-popup').classList.add('hidden');
                    document.getElementById('confirm-popup').classList.remove('flex');
                    if (typeof showRecalcIfNeeded === 'function') showRecalcIfNeeded();
                }, { okLabel: '採用' });
            });
            // プレビュー用モーダル表示
            _previewModalItems = previewItems;
            // Phase フィルター適用中の表示可能インデックスリスト
            function _visibleIndices() {
                if (_hiddenPhases.size === 0) return previewItems.map((_, i) => i);
                return previewItems.map((item, i) => {
                    // item.method が hiddenPhases に含まれていなければ表示
                    return (!item.method || !_hiddenPhases.has(item.method)) ? i : -1;
                }).filter(i => i >= 0);
            }
            function showPreviewModal(idx) {
                if (idx < 0 || idx >= previewItems.length) return;
                _previewModalIdx = idx;
                const item = previewItems[idx];
                document.getElementById('modal-scene-badge').textContent = item.scene || '';
                document.getElementById('modal-title').textContent = item.title || '';
                document.getElementById('modal-img').src = item.screenshot ? imgUrl(item.screenshot) : (item.thumb ? imgUrl(item.thumb) : '');
                document.getElementById('modal-ocr').textContent = item.ocr_text || '';
                document.getElementById('modal-fp').textContent = 'fp: ' + (item.fp || '');
                document.getElementById('modal-time').textContent = item.discovered_at || '';
                const vis = _visibleIndices();
                const visPos = vis.indexOf(idx);
                document.getElementById('modal-counter').textContent = (visPos + 1) + ' / ' + vis.length;
                document.getElementById('modal-ocr-sources').innerHTML = '';
                document.getElementById('modal-edit-area').classList.add('hidden');
                document.getElementById('modal-edit-btn').style.display = 'none';
                document.getElementById('modal-cluster').classList.add('hidden');
                // アンカー比較パネル
                const anchorPanel = document.getElementById('modal-anchor-compare');
                if (item.master_fp) {
                    const match = data.matches.find(m => m.session_fp === item.fp && m.master_fp === item.master_fp);
                    if (match) {
                        document.getElementById('anchor-master-img').src = match.master_screenshot ? imgUrl(match.master_screenshot) : (match.master_thumb ? imgUrl(match.master_thumb) : '');
                        document.getElementById('anchor-master-ocr').textContent = match.master_ocr_text || '(テキストなし)';
                        document.getElementById('anchor-phash').textContent = match.phash_dist >= 0 ? 'phash: ' + match.phash_dist : '';
                        document.getElementById('anchor-textsim').textContent = match.text_sim >= 0 ? 'sim: ' + match.text_sim : '';
                        document.getElementById('anchor-master-fp').textContent = 'master: ' + match.master_fp;
                        const badge = document.getElementById('anchor-method-badge');
                        badge.textContent = phaseDesc(match.method);
                        badge.className = 'inline-block px-2 py-0.5 text-[10px] font-medium rounded ' + phaseColor(match.method);
                        // 採用・不採用ボタン
                        const adoptBtn = document.getElementById('anchor-adopt-btn');
                        const excludeBtn = document.getElementById('anchor-exclude-btn');
                        const isExcluded = excludedGeminiFps.has(item.fp);
                        const isRestored = item.discarded && restoredDiscardedFps.has(item.fp);
                        const isActive = !item.discarded && !isExcluded || isRestored;
                        // 採用状態 → 不採用ボタン表示、不採用/棄却状態 → 採用ボタン表示
                        adoptBtn.style.display = isActive ? 'none' : '';
                        excludeBtn.style.display = isActive ? '' : 'none';
                        adoptBtn.onclick = () => {
                            const thumb = item.thumb ? imgUrl(item.thumb) : '';
                            showConfirmDialog(
                                `<p class="text-sm text-gray-300 mb-3">このアンカーを採用しますか？</p>
                                 <div class="w-32"><img src="${thumb}" class="w-full rounded" /><p class="text-[9px] text-gray-500 truncate mt-1">${escapeHtml(item.title || '')}</p></div>`,
                                () => {
                                    excludedGeminiFps.delete(item.fp);
                                    if (item.discarded) restoredDiscardedFps.add(item.fp);
                                    selectedPreviewFps.clear();
                                    renderPreviewSelection();
                                    updatePreviewActionBar();
                                    document.getElementById('confirm-popup').classList.add('hidden');
                                    document.getElementById('confirm-popup').classList.remove('flex');
                                    closeModal();
                                    if (typeof showRecalcIfNeeded === 'function') showRecalcIfNeeded();
                                }, { okLabel: '採用' }
                            );
                        };
                        excludeBtn.onclick = () => {
                            const thumb = item.thumb ? imgUrl(item.thumb) : '';
                            showConfirmDialog(
                                `<p class="text-sm text-gray-300 mb-3">このアンカーを不採用にしますか？</p>
                                 <div class="w-32"><img src="${thumb}" class="w-full rounded" /><p class="text-[9px] text-gray-500 truncate mt-1">${escapeHtml(item.title || '')}</p></div>`,
                                () => {
                                    excludedGeminiFps.add(item.fp);
                                    restoredDiscardedFps.delete(item.fp);
                                    selectedPreviewFps.clear();
                                    renderPreviewSelection();
                                    updatePreviewActionBar();
                                    document.getElementById('confirm-popup').classList.add('hidden');
                                    document.getElementById('confirm-popup').classList.remove('flex');
                                    closeModal();
                                    if (typeof showRecalcIfNeeded === 'function') showRecalcIfNeeded();
                                }, { okLabel: '不採用', danger: true }
                            );
                        };
                        // 棄却理由
                        const reasonEl = document.getElementById('anchor-discard-reason');
                        if (item.discarded && item.discard_reason) {
                            reasonEl.textContent = item.discard_reason;
                            reasonEl.classList.remove('hidden');
                        } else {
                            reasonEl.classList.add('hidden');
                        }
                        anchorPanel.classList.remove('hidden');
                        anchorPanel.classList.add('flex');
                    } else {
                        anchorPanel.classList.add('hidden');
                        anchorPanel.classList.remove('flex');
                    }
                } else {
                    anchorPanel.classList.add('hidden');
                    anchorPanel.classList.remove('flex');
                }
                const prevBtn = document.getElementById('modal-prev');
                const nextBtn = document.getElementById('modal-next');
                const prevIdx = visPos > 0 ? vis[visPos - 1] : -1;
                const nextIdx = visPos < vis.length - 1 ? vis[visPos + 1] : -1;
                prevBtn.onclick = (e) => { e.stopPropagation(); if (prevIdx >= 0) showPreviewModal(prevIdx); };
                nextBtn.onclick = (e) => { e.stopPropagation(); if (nextIdx >= 0) showPreviewModal(nextIdx); };
                prevBtn.classList.toggle('invisible', prevIdx < 0);
                nextBtn.classList.toggle('invisible', nextIdx < 0);
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
            _previewModalShow = showPreviewModal;
            mc.querySelectorAll('[data-preview-idx]').forEach(card => {
                card.addEventListener('click', (e) => {
                    if (e.shiftKey) return; // Shift+クリックは選択のみ
                    showPreviewModal(parseInt(card.dataset.previewIdx, 10));
                });
            });
            // 画像外クリックで選択解除
            document.addEventListener('click', function _previewDeselectHandler(e) {
                if (selectedPreviewFps.size === 0) return;
                if (e.target.closest('[data-preview-idx]') || e.target.closest('#preview-exclude-btn') || e.target.closest('#preview-restore-btn') || e.target.closest('#confirm-popup') || e.target.closest('#modal')) return;
                selectedPreviewFps.clear();
                renderPreviewSelection();
                updatePreviewActionBar();
            });
            document.getElementById('execute-merge-btn').addEventListener('click', () => executeMerge(sessionId, Array.from(excludedGeminiFps), Array.from(restoredDiscardedFps)));
            // 再計算ボタン: 採用/不採用変更後にプレビューを再実行
            const recalcBtn = document.getElementById('preview-recalc-btn');
            function showRecalcIfNeeded() {
                recalcBtn.classList.toggle('hidden', excludedGeminiFps.size === 0 && restoredDiscardedFps.size === 0);
            }
            recalcBtn.addEventListener('click', async () => {
                const excl = JSON.stringify(Array.from(excludedGeminiFps));
                const incl = JSON.stringify(Array.from(restoredDiscardedFps));
                const url = API_BASE + '?action=preview_merge&session_id=' + encodeURIComponent(sessionId)
                    + '&exclude_fps=' + encodeURIComponent(excl)
                    + '&include_fps=' + encodeURIComponent(incl);
                recalcBtn.disabled = true;
                recalcBtn.textContent = '再計算中...';
                try {
                    await fetch(url);
                    const newData = await pollMergeResult(mc, '再計算中');
                    if (newData && !newData.error) {
                        // 新規追加ノード数を更新
                        const newInsertable = (newData.new_nodes || []).filter(n => n.insertable).length;
                        const infoEl = mc.querySelector('p.text-sm.text-gray-400');
                        if (infoEl) {
                            infoEl.textContent = '新規追加ノード: ' + newInsertable + ' / アンカー: ' + newData.matches.length + ' / セッション画面: ' + newData.session_screens + ' / マスター現状: ' + newData.master_nodes_before + ' ノード';
                        }
                        showToast('再計算完了: 新規追加ノード ' + newInsertable + ' 件', 'success');
                    }
                } catch (e) {
                    showToast('再計算に失敗しました', 'error');
                }
                recalcBtn.disabled = false;
                recalcBtn.textContent = '再計算';
                recalcBtn.classList.add('hidden');
            });
        } catch (e) {
            if (toastHandle) toastHandle.remove();
            mc.innerHTML = '<div class="text-red-500 py-12">プレビュー失敗</div>';
        }
    }

    function renderNeighbors(neighbors) {
        if (!neighbors || neighbors.length === 0) return '';
        const items = neighbors.slice(0, 4).map(n => {
            const arrow = n.direction === 'to' ? '→' : '←';
            return `<span class="text-[9px] text-gray-500">${arrow} ${escapeHtml((n.title || n.fp || '').substring(0, 20))}</span>`;
        });
        return `<div class="flex flex-wrap gap-1 mt-1">${items.join('')}</div>`;
    }

    async function executeMerge(sessionId, excludeFps, includeFps) {
        await withOperationLock('マージ実行', async () => {
            await _executeMerge(sessionId, excludeFps, includeFps);
        });
    }
    async function _executeMerge(sessionId, excludeFps, includeFps) {
        const mc = document.getElementById('merge-container');
        mc.innerHTML = '<div class="text-center text-gray-300 py-12"><span class="animate-pulse">マージ実行中...</span></div>';
        try {
            const excludeParam = (excludeFps && excludeFps.length > 0) ? '&exclude_fps=' + encodeURIComponent(JSON.stringify(excludeFps)) : '';
            const includeParam = (includeFps && includeFps.length > 0) ? '&include_fps=' + encodeURIComponent(JSON.stringify(includeFps)) : '';
            await fetch(API_BASE + '?action=execute_merge&session_id=' + encodeURIComponent(sessionId) + excludeParam + includeParam);
            const data = await pollMergeResult(mc, 'マージ実行中');
            if (data && data.ok) {
                mc.innerHTML = `<div class="text-center text-green-400 py-12">マージ完了: 新規追加 ${data.new_nodes} / アンカー ${data.anchors || 0} / マスター合計 ${data.master_nodes || '?'} ノード</div>`;
                setTimeout(() => fetchMergeTab(), 1500);
            } else {
                mc.innerHTML = `<div class="text-center text-red-500 py-12">エラー: ${escapeHtml(data?.error || '不明')}</div>`;
            }
        } catch (e) {
            mc.innerHTML = '<div class="text-center text-red-500 py-12">マージ失敗</div>';
        }
    }

    function confirmDeleteSession(sessionId, nodeCount, status) {
        const isRunning = status === 'running';
        const isMerged = parseInt(nodeCount) > 0;
        let details;
        if (isRunning) {
            details = `<ul class="text-xs text-gray-400 space-y-1 ml-4 list-disc">
                <li>セッションを破棄（discarded）し、全画面を物理削除</li>
                <li>auto_pilot 実行中の場合、次の記録から新セッションが自動作成されます</li>
            </ul>`;
        } else if (isMerged) {
            details = `<ul class="text-xs text-gray-400 space-y-1 ml-4 list-disc">
                <li>不採用の画像・スクリーンショットファイルを物理削除</li>
                <li>遷移データ・グループ情報を削除</li>
                <li>採用済み画像（マスターノード参照）は保持</li>
            </ul>`;
        } else {
            details = `<ul class="text-xs text-gray-400 space-y-1 ml-4 list-disc">
                <li>全画面・スクリーンショットファイルを物理削除</li>
                <li>遷移データ・グループ情報を削除</li>
            </ul>`;
        }
        const html = `
            <p class="text-sm text-gray-300 mb-2">セッション <code class="text-brand-light">${escapeHtml(sessionId)}</code> を削除しますか？</p>
            ${details}
            <p class="text-xs text-red-400 mt-3">この操作は取り消せません。</p>`;
        showConfirmDialog(html, async function() {
            hideConfirmDialog();
            await executeDeleteSession(sessionId);
        }, { okLabel: '削除', danger: true });
    }

    async function executeDeleteSession(sessionId) {
        const mc = document.getElementById('merge-container');
        mc.innerHTML = '<div class="text-center text-gray-600 py-12">削除中...</div>';
        try {
            const res = await fetch(API_BASE + '?action=delete_session&session_id=' + encodeURIComponent(sessionId));
            const data = await res.json();
            if (data.ok) {
                const modeLabel = data.delete_mode === 'all' ? '全画面削除' : '非代表のみ削除';
                const statusLabel = data.new_status === 'discarded' ? '(セッション破棄)' : '';
                mc.innerHTML = `<div class="text-center text-green-500 py-12">
                    削除完了 ${statusLabel}: ${data.deleted_screens} 画面削除, ${data.deleted_files} ファイル削除${data.kept_screens > 0 ? `, ${data.kept_screens} 画面保持` : ''}
                </div>`;
                setTimeout(() => fetchMergeTab(), 2000);
            } else {
                mc.innerHTML = `<div class="text-center text-red-500 py-12">エラー: ${escapeHtml(data.error || '不明')}</div>`;
            }
        } catch (e) {
            mc.innerHTML = '<div class="text-center text-red-500 py-12">削除失敗</div>';
        }
    }

    // --- Cost タブ ---
    const COST_PRICING = {
        'gemini-2.5-flash':      { input: 0.15,  output: 0.60 },
        'gemini-2.5-flash-lite': { input: 0.075, output: 0.30 },
    };
    // USD→JPY 為替レート (リアルタイム取得)
    let _usdJpy = null;
    let _usdJpySource = '';
    const _usdJpyReady = (async () => {
        try {
            const r = await fetch('https://open.er-api.com/v6/latest/USD');
            const d = await r.json();
            if (d.rates && d.rates.JPY) {
                _usdJpy = d.rates.JPY;
                _usdJpySource = `¥/${d.rates.JPY.toFixed(2)}`;
            }
        } catch (e) {}
    })();
    function calcCost(model, inputTokens, outputTokens) {
        const p = COST_PRICING[model] || { input: 0.15, output: 0.60 };
        const usd = (inputTokens / 1e6) * p.input + (outputTokens / 1e6) * p.output;
        return _usdJpy ? usd * _usdJpy : usd;
    }
    function fmtCost(cost) {
        if (!_usdJpy) {
            return cost < 0.001 ? '< $0.001' : '$' + cost.toFixed(4);
        }
        if (cost < 1) return '< ¥1';
        return '¥' + Math.ceil(cost);
    }
    function fmtTokens(n) {
        if (n >= 1e6) return (n / 1e6).toFixed(2) + 'M';
        if (n >= 1e3) return (n / 1e3).toFixed(1) + 'K';
        return String(n);
    }
    const PURPOSE_LABELS = { 'hq_ocr': 'HQ OCR', 'anchor_judgment': 'Anchor Judgment', 'anchor_text_judgment': 'Anchor Text Judgment' };
    function _buildCostTable(rows, periodKey) {
        let h = '<table class="w-full text-sm"><thead><tr class="text-gray-500 text-xs border-b border-gray-800">';
        const label = periodKey === 'month' ? 'Month' : 'Date';
        h += `<th class="text-left py-1.5 px-2">${label}</th><th class="text-left py-1.5 px-2">Model</th><th class="text-left py-1.5 px-2">Purpose</th><th class="text-right py-1.5 px-2">Calls</th><th class="text-right py-1.5 px-2">Input</th><th class="text-right py-1.5 px-2">Output</th><th class="text-right py-1.5 px-2">Cost</th>`;
        h += '</tr></thead><tbody>';
        let prev = '';
        for (const row of rows) {
            const cost = calcCost(row.model, +row.input_tokens, +row.output_tokens);
            const period = row[periodKey];
            const show = period !== prev ? period : '';
            prev = period;
            h += `<tr class="border-b border-gray-800/50 text-gray-300${show ? ' border-t border-gray-700' : ''}">
                <td class="py-1.5 px-2 text-xs${show ? ' font-medium' : ' text-transparent'}">${show || period}</td>
                <td class="py-1.5 px-2 font-mono text-xs">${row.model}</td>
                <td class="py-1.5 px-2 text-xs">${PURPOSE_LABELS[row.purpose] || row.purpose}</td>
                <td class="py-1.5 px-2 text-right">${(+row.call_count).toLocaleString()}</td>
                <td class="py-1.5 px-2 text-right text-cyan-400/70">${fmtTokens(+row.input_tokens)}</td>
                <td class="py-1.5 px-2 text-right text-orange-400/70">${fmtTokens(+row.output_tokens)}</td>
                <td class="py-1.5 px-2 text-right text-emerald-400">${fmtCost(cost)}</td>
            </tr>`;
        }
        h += '</tbody></table>';
        return h;
    }

    async function fetchCostTab() {
        const mc = document.getElementById('merge-container');
        try {
            await _usdJpyReady;
            const res = await fetch(API_BASE + '?action=get_api_usage');
            const data = await res.json();

            const daily = data.daily || [];
            const monthly = data.monthly || [];
            const byModel = data.by_model || [];
            const byPurpose = data.by_purpose || [];
            const total = data.total || {};

            // 全体合計コスト計算
            let totalCost = 0;
            for (const row of byModel) {
                totalCost += calcCost(row.model, +row.input_tokens, +row.output_tokens);
            }

            if (+total.count === 0) {
                mc.innerHTML = '<div class="space-y-6"><h3 class="text-lg font-bold text-gray-300">API Cost</h3><p class="text-gray-600 text-sm">API 使用データがありません</p></div>';
                return;
            }

            let html = '<div class="space-y-6">';

            // 合計サマリー
            html += '<div class="grid grid-cols-3 gap-4">';
            html += `<div class="bg-gray-900 border border-gray-800 rounded-lg p-4 text-center">
                <div class="text-2xl font-bold text-emerald-400">${fmtCost(totalCost)}</div>
                <div class="text-xs text-gray-500 mt-1">Total Cost${_usdJpySource ? ` <span class="text-gray-600">(${_usdJpySource})</span>` : ''}</div>
            </div>`;
            html += `<div class="bg-gray-900 border border-gray-800 rounded-lg p-4 text-center">
                <div class="text-2xl font-bold text-cyan-400">${fmtTokens(+total.input_tokens + +total.output_tokens)}</div>
                <div class="text-xs text-gray-500 mt-1">Total Tokens</div>
            </div>`;
            html += `<div class="bg-gray-900 border border-gray-800 rounded-lg p-4 text-center">
                <div class="text-2xl font-bold text-gray-300">${(+total.count).toLocaleString()}</div>
                <div class="text-xs text-gray-500 mt-1">API Calls</div>
            </div>`;
            html += '</div>';

            // モデル別
            html += '<div><h3 class="text-sm font-bold text-gray-400 mb-2">Model</h3>';
            html += '<table class="w-full text-sm"><thead><tr class="text-gray-500 text-xs border-b border-gray-800">';
            html += '<th class="text-left py-1.5 px-2">Model</th><th class="text-right py-1.5 px-2">Calls</th><th class="text-right py-1.5 px-2">Input</th><th class="text-right py-1.5 px-2">Output</th><th class="text-right py-1.5 px-2">Cost</th>';
            html += '</tr></thead><tbody>';
            for (const row of byModel) {
                const cost = calcCost(row.model, +row.input_tokens, +row.output_tokens);
                html += `<tr class="border-b border-gray-800/50 text-gray-300">
                    <td class="py-1.5 px-2 font-mono text-xs">${row.model}</td>
                    <td class="py-1.5 px-2 text-right">${(+row.call_count).toLocaleString()}</td>
                    <td class="py-1.5 px-2 text-right text-cyan-400/70">${fmtTokens(+row.input_tokens)}</td>
                    <td class="py-1.5 px-2 text-right text-orange-400/70">${fmtTokens(+row.output_tokens)}</td>
                    <td class="py-1.5 px-2 text-right text-emerald-400">${fmtCost(cost)}</td>
                </tr>`;
            }
            html += '</tbody></table></div>';

            // 用途別
            html += '<div><h3 class="text-sm font-bold text-gray-400 mb-2">Purpose</h3>';
            html += '<table class="w-full text-sm"><thead><tr class="text-gray-500 text-xs border-b border-gray-800">';
            html += '<th class="text-left py-1.5 px-2">Purpose</th><th class="text-right py-1.5 px-2">Calls</th><th class="text-right py-1.5 px-2">Input</th><th class="text-right py-1.5 px-2">Output</th><th class="text-right py-1.5 px-2">Cost</th>';
            html += '</tr></thead><tbody>';
            for (const row of byPurpose) {
                let purposeCost = 0;
                // 用途別のコスト計算: daily データからモデル情報を取得
                for (const d of daily) {
                    if (d.purpose === row.purpose) {
                        purposeCost += calcCost(d.model, +d.input_tokens, +d.output_tokens);
                    }
                }
                html += `<tr class="border-b border-gray-800/50 text-gray-300">
                    <td class="py-1.5 px-2">${PURPOSE_LABELS[row.purpose] || row.purpose}</td>
                    <td class="py-1.5 px-2 text-right">${(+row.call_count).toLocaleString()}</td>
                    <td class="py-1.5 px-2 text-right text-cyan-400/70">${fmtTokens(+row.input_tokens)}</td>
                    <td class="py-1.5 px-2 text-right text-orange-400/70">${fmtTokens(+row.output_tokens)}</td>
                    <td class="py-1.5 px-2 text-right text-emerald-400">${fmtCost(purposeCost)}</td>
                </tr>`;
            }
            html += '</tbody></table></div>';

            // 日別/月別
            html += '<div><div class="flex items-center gap-2 mb-2"><h3 class="text-sm font-bold text-gray-400">Breakdown</h3>';
            html += '<button id="cost-daily-btn" class="px-2 py-0.5 text-xs rounded bg-cyan-900/50 text-cyan-300">Daily</button>';
            html += '<button id="cost-monthly-btn" class="px-2 py-0.5 text-xs rounded bg-gray-800 text-gray-500">Monthly</button></div>';
            html += '<div id="cost-daily-table">';
            html += _buildCostTable(daily, 'day');
            html += '</div>';
            html += '<div id="cost-monthly-table" class="hidden">';
            html += _buildCostTable(monthly, 'month');
            html += '</div></div>';

            html += '</div>';
            mc.innerHTML = html;
            // Daily/Monthly 切り替え
            const _cdBtn = document.getElementById('cost-daily-btn');
            const _cmBtn = document.getElementById('cost-monthly-btn');
            if (_cdBtn && _cmBtn) {
                _cdBtn.addEventListener('click', function() {
                    document.getElementById('cost-daily-table').classList.remove('hidden');
                    document.getElementById('cost-monthly-table').classList.add('hidden');
                    _cdBtn.className = 'px-2 py-0.5 text-xs rounded bg-cyan-900/50 text-cyan-300';
                    _cmBtn.className = 'px-2 py-0.5 text-xs rounded bg-gray-800 text-gray-500';
                });
                _cmBtn.addEventListener('click', function() {
                    document.getElementById('cost-daily-table').classList.add('hidden');
                    document.getElementById('cost-monthly-table').classList.remove('hidden');
                    _cmBtn.className = 'px-2 py-0.5 text-xs rounded bg-cyan-900/50 text-cyan-300';
                    _cdBtn.className = 'px-2 py-0.5 text-xs rounded bg-gray-800 text-gray-500';
                });
            }
        } catch (e) {
            mc.innerHTML = '<div class="space-y-6"><h3 class="text-lg font-bold text-gray-300">API Cost</h3><p class="text-red-400 text-sm">データの取得に失敗しました</p></div>';
        }
    }

    async function checkCleanableInMerge() {
        const area = document.getElementById('merge-cleanup-area');
        if (!area) return;
        try {
            const res = await fetch(API_BASE + '?action=get_cleanable_excluded');
            const data = await res.json();
            if (data.count > 0) {
                area.innerHTML = `<div class="flex items-center justify-between bg-gray-900 border border-gray-800 rounded-lg p-4">
                    <div>
                        <span class="text-gray-300">Final で除外済み＋セッション削除済みの画像が ${data.count} 件あります</span>
                        <p class="text-xs text-gray-500 mt-1">マスターノード・エッジ・画像ファイルを完全に削除できます</p>
                    </div>
                    <button id="merge-cleanup-btn" class="px-3 py-1.5 bg-red-900/50 hover:bg-red-800 text-red-400 text-xs rounded transition-colors">${TRASH_ICON}</button>
                </div>`;
                document.getElementById('merge-cleanup-btn').addEventListener('click', confirmCleanupExcluded);
            } else {
                area.innerHTML = '<p class="text-gray-600 text-sm">整理対象のデータはありません</p>';
            }
        } catch (e) {
            area.innerHTML = '<p class="text-gray-600 text-sm">確認できませんでした</p>';
        }
    }

    async function confirmCleanupExcluded() {
