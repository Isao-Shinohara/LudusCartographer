    // --- 修正ルール (Phase 2) ---
    async function checkCorrectionRules() {
        const area = document.getElementById('correction-rules-area');
        if (!area) return;
        try {
            const res = await fetch(API_BASE + '?action=get_correction_candidates');
            const data = await res.json();
            const candidates = data.candidates || [];
            if (candidates.length === 0) {
                area.innerHTML = `<p class="text-gray-600 text-sm">適用可能な修正ルールはありません (登録済み: ${data.total_rules || 0} 件)</p>`;
                return;
            }
            let html = `<p class="text-xs text-gray-500 mb-2">${candidates.length} 件のルールが他のノードに適用可能です</p>`;
            html += '<div class="space-y-2">';
            for (const c of candidates) {
                const r = c.rule;
                html += `<div class="bg-gray-900 border border-gray-800 rounded-lg p-3">
                    <div class="flex items-center justify-between mb-2">
                        <div class="text-xs">
                            <span class="text-red-400">${escapeHtml(r.before_text.substring(0, 60))}</span>
                            <span class="text-gray-500 mx-2">→</span>
                            <span class="text-emerald-400">${escapeHtml(r.after_text.substring(0, 60))}</span>
                        </div>
                        <button class="apply-rule-btn px-3 py-1 bg-emerald-900/50 hover:bg-emerald-800/60 text-emerald-300 text-xs rounded transition-colors"
                                data-rule-id="${r.id}"
                                data-master-fps='${JSON.stringify(c.matches.map(m => m.master_fp))}'>
                            ${c.count} 回
                        </button>
                    </div>
                </div>`;
            }
            html += '</div>';
            area.innerHTML = html;
            area.querySelectorAll('.apply-rule-btn').forEach(btn => {
                btn.addEventListener('click', () => applyCorrectionRule(btn.dataset.ruleId, btn.dataset.masterFps));
            });
        } catch (e) {
            area.innerHTML = '<p class="text-gray-600 text-sm">ルール取得エラー</p>';
        }
    }

    async function applyCorrectionRule(ruleId, masterFpsJson) {
        await withOperationLock('ルール適用', async () => {
            await _applyCorrectionRule(ruleId, masterFpsJson);
        });
    }
    // --- ノイズ語辞書 ---
    async function fetchNoiseWords() {
        const area = document.getElementById('noise-words-area');
        if (!area) return;
        try {
            const res = await fetch(API_BASE + '?action=get_noise_words');
            const data = await res.json();
            const words = data.words || [];
            if (words.length === 0) {
                area.innerHTML = '<p class="text-gray-600">ノイズ語はまだ登録されていません。auto_pilot でGemini OCRを実行すると自動的に蓄積されます。</p>';
                return;
            }
            let html = '<p class="text-xs text-gray-500 mb-2">アンカー比較時にOCRテキストから除去される単語（count≥2で有効）</p>';
            // 手動追加フォーム
            html += `<div class="flex gap-2 mb-3">
                <input id="add-noise-word" type="text" placeholder="単語を追加" class="bg-gray-800 text-gray-200 text-xs rounded px-2 py-1 border border-gray-700 focus:border-brand outline-none w-40" />
                <button id="add-noise-word-btn" class="px-3 py-1 bg-cyan-900/50 hover:bg-cyan-800/60 text-cyan-300 text-xs rounded transition-colors">追加</button>
            </div>`;
            html += '<div class="flex flex-wrap gap-2">';
            for (const w of words) {
                const active = w.count >= 2;
                const cls = active ? 'bg-cyan-900/40 text-cyan-300 border-cyan-800' : 'bg-gray-800 text-gray-500 border-gray-700';
                html += `<span class="inline-flex items-center gap-1 px-2 py-1 text-xs rounded border ${cls}">
                    ${escapeHtml(w.word)} <span class="text-[9px] opacity-60">×${w.count}</span>
                    <button class="delete-noise-word hover:text-red-400 ml-0.5" data-word="${escapeHtml(w.word)}" title="削除">×</button>
                </span>`;
            }
            html += '</div>';
            area.innerHTML = html;
            // 削除ハンドラ
            area.querySelectorAll('.delete-noise-word').forEach(btn => {
                btn.addEventListener('click', async () => {
                    await fetch(API_BASE + '?action=delete_noise_word&word=' + encodeURIComponent(btn.dataset.word));
                    fetchNoiseWords();
                });
            });
            // 追加ハンドラ
            document.getElementById('add-noise-word-btn')?.addEventListener('click', async () => {
                const input = document.getElementById('add-noise-word');
                const word = input.value.trim();
                if (!word) return;
                await fetch(API_BASE + '?action=add_noise_word&word=' + encodeURIComponent(word));
                input.value = '';
                fetchNoiseWords();
            });
        } catch (e) {
            area.innerHTML = '<p class="text-red-500">読み込みエラー</p>';
        }
    }

    async function _applyCorrectionRule(ruleId, masterFpsJson) {
