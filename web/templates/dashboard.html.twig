    function showModal(idx) {
        if (idx < 0 || idx >= filteredScreens.length) return;
        modalIdx = idx;
        const s = filteredScreens[idx];
        const chronoPos = idx + 1;
        const isThinned = s.cluster_id !== null && s.cluster_id !== undefined && !s.is_representative;
        const isExcluded = s.is_artifact > 0;
        const isGeminiExcluded = s.is_artifact === 1;
        const isUserExcluded = s.is_artifact === 2;
        const titlePrefix = isGeminiExcluded ? '[Gemini不採用] ' : isUserExcluded ? '[不採用] ' : isThinned ? '[非代表] ' : '';
        const scene = s.category || 'UNKNOWN';
        const badge = document.getElementById('modal-scene-badge');
        badge.textContent = scene;
        const rawTitle = s.name || '';
        const displayTitle = rawTitle === '(UNKNOWN)' ? '' : rawTitle;
        document.getElementById('modal-title').textContent = titlePrefix + displayTitle;
        document.getElementById('modal-img').src = s.screenshot_path ? imgUrl(s.screenshot_path) : '';
        document.getElementById('modal-ocr').textContent = s.ocr_text || '';
        document.getElementById('modal-scene').textContent = s.category || '';
        document.getElementById('modal-fp').textContent = 'fp: ' + (s.screen_hash || '');
        document.getElementById('modal-time').textContent = s.last_seen_at || '';
        document.getElementById('modal-counter').textContent = chronoPos + ' / ' + filteredScreens.length;
        // OCR ソース別表示 (Phase 3)
        renderOcrSources(s);
        // 編集 UI を閉じる
        document.getElementById('modal-edit-area').classList.add('hidden');
        // 編集ボタンは Final タブの代表のみ
        const editBtn = document.getElementById('modal-edit-btn');
        const modalAdoptBtn = document.getElementById('modal-adopt-btn');
        const modalExcludeBtn = document.getElementById('modal-exclude-btn');
        if (currentTab === 'final' && s.master_fp) {
            editBtn.style.display = 'inline-block';
            editBtn._currentMasterFp = s.master_fp;
            editBtn._currentText = s.ocr_text || '';
            // 採用/不採用ボタン: 現在の状態に応じて片方だけ表示
            if (s.user_excluded) {
                modalAdoptBtn.classList.remove('hidden');
                modalExcludeBtn.classList.add('hidden');
            } else {
                modalAdoptBtn.classList.add('hidden');
                modalExcludeBtn.classList.remove('hidden');
            }
            modalAdoptBtn._masterFp = s.master_fp;
            modalAdoptBtn._screenId = null;
            modalExcludeBtn._masterFp = s.master_fp;
            modalExcludeBtn._screenId = null;
        } else if (currentTab === 'live' && s.id && s.is_representative) {
            editBtn.style.display = 'none';
            // Live タブ: 代表画像のみ is_artifact で採用/不採用
            if (s.is_artifact > 0) {
                modalAdoptBtn.classList.remove('hidden');
                modalExcludeBtn.classList.add('hidden');
            } else {
                modalAdoptBtn.classList.add('hidden');
                modalExcludeBtn.classList.remove('hidden');
            }
            modalAdoptBtn._masterFp = null;
            modalAdoptBtn._screenId = s.id;
            modalExcludeBtn._masterFp = null;
            modalExcludeBtn._screenId = s.id;
        } else {
            editBtn.style.display = 'none';
            modalAdoptBtn.classList.add('hidden');
            modalExcludeBtn.classList.add('hidden');
        }
        updateModalNav();
        document.getElementById('modal-anchor-compare').classList.add('hidden');
        document.getElementById('modal-anchor-compare').classList.remove('flex');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        // Final タブ: クラスタ兄弟を表示
        const clusterDiv = document.getElementById('modal-cluster');
        const clusterGrid = document.getElementById('modal-cluster-grid');
        if ((currentTab === 'final' || currentTab === 'live') && s.id) {
            _clusterCurrentScreenId = s.id;
            clusterDiv.classList.remove('hidden');
            clusterGrid.innerHTML = '<span class="text-xs text-gray-600">読み込み中...</span>';
            fetchClusterSiblings(s.id, s.master_fp);
        } else {
            clusterDiv.classList.add('hidden');
            clusterGrid.innerHTML = '';
        }
    }

    let _clusterSiblings = [];
    let _clusterSelectedId = null;
    let _clusterOriginalRepId = null;
    let _clusterMasterFp = null;
    let _clusterCurrentScreenId = null;  // モーダルで表示中の画面ID

    async function fetchClusterSiblings(screenId, masterFp) {
        const clusterGrid = document.getElementById('modal-cluster-grid');
        const promoteBtn = document.getElementById('cluster-promote-btn');
        _clusterMasterFp = masterFp;
        _clusterSelectedId = screenId;  // 開いた画像を初期選択
        promoteBtn.disabled = true;
        promoteBtn.classList.add('hidden');
        try {
            let url = API_BASE + '?action=get_cluster_siblings&screen_id=' + screenId;
            if (currentTab === 'final' && masterFp) {
                url += '&master_fp=' + encodeURIComponent(masterFp);
            }
            const res = await fetch(url);
            const data = await res.json();
            _clusterSiblings = data.siblings || [];
            if (_clusterSiblings.length <= 1) {
                clusterGrid.innerHTML = '<span class="text-xs text-gray-600 whitespace-nowrap">クラスタ内に他の画像はありません</span>';
                return;
            }
            _clusterOriginalRepId = (_clusterSiblings.find(s => s.is_representative == 1) || {}).id || null;
            renderClusterGrid();
            // 選択中の画像が見えるようにスクロール
            requestAnimationFrame(() => {
                const selected = clusterGrid.querySelector('.cluster-sib.border-emerald-500, .cluster-sib.border-amber-700');
                if (selected) selected.scrollIntoView({ block: 'nearest', behavior: 'instant' });
            });
        } catch (e) {
            clusterGrid.innerHTML = '<span class="text-xs text-red-500">取得エラー</span>';
        }
    }

    function renderClusterGrid() {
        const clusterGrid = document.getElementById('modal-cluster-grid');
        const promoteBtn = document.getElementById('cluster-promote-btn');
        const selectedId = _clusterSelectedId || _clusterOriginalRepId;
        clusterGrid.innerHTML = _clusterSiblings.map(sib => {
            const thumb = sib.thumbnail_path ? imgUrl(sib.thumbnail_path) : (sib.screenshot_path ? imgUrl(sib.screenshot_path) : '');
            const isCurrent = sib.id == _clusterCurrentScreenId;
            const isRep = sib.is_representative == 1;
            const isSelected = _clusterSelectedId && sib.id == _clusterSelectedId;
            const border = isSelected ? 'border-2 border-emerald-500' : isCurrent ? 'border-2 border-amber-700' : 'border border-gray-700 hover:border-brand/50 cursor-pointer';
            const repBadge = isRep ? '<span class="absolute top-1 right-1 w-5 h-5 rounded-full bg-emerald-600/90 text-white text-[10px] font-bold flex items-center justify-center shadow" title="代表">★</span>' : '';
            return `<div class="cluster-sib relative ${border} rounded overflow-hidden bg-gray-900 flex-shrink-0" data-sib-id="${sib.id}">
                ${thumb ? `<img src="${thumb}" class="w-full aspect-video object-cover bg-gray-800" loading="lazy" />` : '<div class="w-full aspect-video bg-gray-800"></div>'}
                ${repBadge}
            </div>`;
        }).join('');
        // 選択が代表と異なればボタン有効化
        const isChanged = _clusterSelectedId && _clusterSelectedId != _clusterOriginalRepId;
        promoteBtn.disabled = !isChanged;
        promoteBtn.classList.remove('hidden');
        // タップで選択
        clusterGrid.querySelectorAll('.cluster-sib').forEach(el => {
            el.addEventListener('click', (e) => {
                e.stopPropagation();
                const sibId = parseInt(el.dataset.sibId);
                _clusterSelectedId = sibId;
                // モーダルのメイン画像を選択した画像に切替
                const sib = _clusterSiblings.find(s => s.id == sibId);
                if (sib) {
                    document.getElementById('modal-img').src = sib.screenshot_path ? imgUrl(sib.screenshot_path) : '';
                    document.getElementById('modal-ocr').textContent = sib.ocr_text_gemini || sib.ocr_text_hq || sib.ocr_text || '';
                }
                renderClusterGrid();
            });
        });
    }

    document.getElementById('cluster-promote-btn').addEventListener('click', function() {
        if (!_clusterSelectedId) return;
        // Live タブでは master_fp なし、Final タブでは master_fp あり
        if (currentTab === 'final' && !_clusterMasterFp) return;
        const sib = _clusterSiblings.find(s => s.id == _clusterSelectedId);
        const origSib = _clusterSiblings.find(s => s.id == _clusterOriginalRepId);
        const html = `
            <p class="text-sm text-gray-300 mb-3">代表画像を変更しますか？</p>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-[10px] text-gray-500 mb-1">現在の代表</p>
                    ${origSib && origSib.thumbnail_path ? `<img src="${imgUrl(origSib.thumbnail_path)}" class="w-full aspect-video object-cover rounded bg-gray-800" />` : ''}
                </div>
                <div>
                    <p class="text-[10px] text-emerald-400 mb-1">新しい代表</p>
                    ${sib && sib.thumbnail_path ? `<img src="${imgUrl(sib.thumbnail_path)}" class="w-full aspect-video object-cover rounded bg-gray-800" />` : ''}
                </div>
            </div>`;
        showConfirmDialog(html, async function() {
            hideConfirmDialog();
            try {
                let promoteUrl = API_BASE + '?action=promote_representative&screen_id=' + _clusterSelectedId;
                if (_clusterMasterFp) {
                    promoteUrl += '&master_fp=' + encodeURIComponent(_clusterMasterFp);
                }
                const res = await fetch(promoteUrl);
                const result = await res.json();
                if (result.ok) {
                    // 一覧のサムネイルを即座に差し替え（再取得前にプレビュー反映）
                    const newSib = _clusterSiblings.find(s => s.id == _clusterSelectedId);
                    if (newSib && modalIdx >= 0 && modalIdx < filteredScreens.length) {
                        const s = filteredScreens[modalIdx];
                        if (newSib.thumbnail_path) s.thumbnail_path = newSib.thumbnail_path;
                        if (newSib.screenshot_path) s.screenshot_path = newSib.screenshot_path;
                        // 一覧のカード画像を差し替え
                        const card = grid.querySelector(`[data-idx="${modalIdx}"] img`);
                        if (card) card.src = imgUrl(newSib.thumbnail_path || newSib.screenshot_path);
                    }
                    const _curId = filteredScreens[modalIdx]?.id;
                    if (currentTab === 'final') {
                        await fetchFinal();
                    } else {
                        await fetchLive();
                    }
                    // 再取得後にモーダルの位置を復元
                    const newIdx = filteredScreens.findIndex(s => s.id === _curId);
                    if (newIdx >= 0) showModal(newIdx);
                    else if (modalIdx >= 0 && modalIdx < filteredScreens.length) showModal(modalIdx);
                }
            } catch (e) {}
        }, { okLabel: '変更' });
    });

    // モーダル内 採用/不採用ボタン (Final: toggle_exclude / Live: toggle_screen_artifact)
    document.getElementById('modal-adopt-btn').addEventListener('click', async function() {
        try {
            if (this._masterFp) {
                // Final タブ
                const url = API_BASE + '?action=toggle_exclude&master_fp=' + encodeURIComponent(this._masterFp) + (_currentVersionId ? '&version=' + _currentVersionId : '');
                await fetch(url);
                const item = allScreens.find(s => s.master_fp === this._masterFp);
                if (item) item.user_excluded = false;
                renderAll();
                if (modalIdx >= 0 && modalIdx < filteredScreens.length) showModal(modalIdx);
                else closeModal();
            } else if (this._screenId) {
                // Live タブ: まず情報を取得してから確認ダイアログ
                const screenId = this._screenId;
                const item = allScreens.find(s => s.id === screenId);
                // マスターノードに含まれるか事前チェック
                const checkUrl = API_BASE + '?action=check_screen_master&screen_id=' + screenId;
                const checkRes = await fetch(checkUrl);
                const checkData = await checkRes.json();

                if (checkData.has_master && checkData.master_excluded) {
                    // マスターノードが除外中 → 確認ダイアログ + 再マージ
                    let msg = '<p class="text-sm text-gray-200 mb-2">採用するとマスターノードの再構築（unmerge + 再マージ）が実行されます。</p>';
                    if (checkData.is_seed) {
                        msg += '<p class="text-xs text-amber-400 mb-1">Seed セッションのため、全セッションの再構築が走ります。</p>';
                        msg += '<p class="text-xs text-amber-400">セッション数に応じて相当な時間がかかる場合があります。</p>';
                    } else {
                        msg += '<p class="text-xs text-gray-400">該当セッション (' + escapeHtml(checkData.session_id || '') + ') の unmerge + 再マージが実行されます。</p>';
                    }
                    showConfirmDialog(msg, async function() {
                        hideConfirmDialog();
                        closeModal();
                        // adopt_and_rebuild API: 採用 + バックグラウンド再マージ
                        const toastHandle = showToast('再構築を開始しています...', 'info', { sticky: true });
                        try {
                            const res = await fetch(API_BASE + '?action=adopt_and_rebuild&screen_id=' + screenId);
                            const data = await res.json();
                            if (!data.started) {
                                toastHandle.update('再構築の開始に失敗しました');
                                setTimeout(() => toastHandle.remove(), 3000);
                                return;
                            }
                            if (item) item.is_artifact = 0;
                            renderAll();
                            // merge_progress ポーリングで進捗表示 (merge_result.json 完了判定込み)
                            const pollTimer = setInterval(async () => {
                                try {
                                    const pr = await fetch(API_BASE + '?action=merge_progress');
                                    const pd = await pr.json();
                                    if (pd.done) {
                                        clearInterval(pollTimer);
                                        if (pd.result && pd.result.ok) {
                                            toastHandle.update('再構築完了');
                                        } else {
                                            toastHandle.update('再構築エラー: ' + (pd.result?.error || '不明'));
                                        }
                                        setTimeout(() => toastHandle.remove(), 4000);
                                        await fetchFinal();
                                    } else if (pd.progress) {
                                        toastHandle.update(pd.progress.phase || '処理中...');
                                    }
                                } catch (e) {}
                            }, 2000);
                        } catch (e) {
                            toastHandle.update('エラーが発生しました');
                            setTimeout(() => toastHandle.remove(), 3000);
                        }
                    }, { okLabel: '採用して再構築' });
                } else {
                    // マスターノードなし or 除外されていない → そのまま実行
                    const url = API_BASE + '?action=toggle_screen_artifact&screen_id=' + screenId;
                    const _res = await fetch(url);
                    const _data = await _res.json();
                    if (item) item.is_artifact = _data.is_artifact ?? 0;
                    renderAll();
                    if (modalIdx >= 0 && modalIdx < filteredScreens.length) showModal(modalIdx);
                    else closeModal();
                }
            }
        } catch (e) {}
    });
    document.getElementById('modal-exclude-btn').addEventListener('click', async function() {
        try {
            if (this._masterFp) {
                // Final タブ
                const url = API_BASE + '?action=toggle_exclude&master_fp=' + encodeURIComponent(this._masterFp) + (_currentVersionId ? '&version=' + _currentVersionId : '');
                await fetch(url);
                const item = allScreens.find(s => s.master_fp === this._masterFp);
                if (item) item.user_excluded = true;
            } else if (this._screenId) {
                // Live タブ
                const url = API_BASE + '?action=toggle_screen_artifact&screen_id=' + this._screenId;
                const _exRes = await fetch(url);
                const _exData = await _exRes.json();
                const item = allScreens.find(s => s.id === this._screenId);
                if (item) item.is_artifact = _exData.is_artifact ?? 2;
            }
            renderAll();
            if (modalIdx >= 0 && modalIdx < filteredScreens.length) showModal(modalIdx);
            else closeModal();
        } catch (e) {}
    });

    // ソート方向に応じた「新しい方向」「古い方向」のインデックス移動
    function newerIdx() { return sortToggle.dataset.sort === 'desc' ? modalIdx - 1 : modalIdx + 1; }
    function olderIdx() { return sortToggle.dataset.sort === 'desc' ? modalIdx + 1 : modalIdx - 1; }
    function canGoNewer() { const i = newerIdx(); return i >= 0 && i < filteredScreens.length; }
    function canGoOlder() { const i = olderIdx(); return i >= 0 && i < filteredScreens.length; }

    function updateModalNav() {
        if (modalIdx < 0) return;
        document.getElementById('modal-prev').style.visibility = canGoOlder() ? 'visible' : 'hidden';
        document.getElementById('modal-next').style.visibility = canGoNewer() ? 'visible' : 'hidden';
    }

    function closeModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.getElementById('modal-anchor-compare').classList.add('hidden');
        document.getElementById('modal-anchor-compare').classList.remove('flex');
        modalIdx = -1;
        _previewModalIdx = -1;
    }

    // --- 除外トグル (ペンディング方式) ---
    function updateFinalActionBar() {
        const adoptBtn = document.getElementById('final-adopt-btn');
        const excludeBtn = document.getElementById('final-exclude-btn');
        const resetBtn = document.getElementById('final-reset-btn');
        const hasSelection = selectedForGroup.size > 0;
        const filter = filterSelect.value;
        adoptBtn.disabled = !hasSelection || filter === 'adopted';
        excludeBtn.disabled = !hasSelection || filter === 'excluded';
        resetBtn.disabled = !hasSelection;
    }

    function togglePending(masterFp) {
        const item = allScreens.find(s => s.master_fp === masterFp);
        if (!item) return;
        const currentExcluded = item.user_excluded;
        if (masterFp in pendingChanges) {
            // 既にペンディング → 取り消し
            delete pendingChanges[masterFp];
        } else {
            // 反転をペンディングに追加
            pendingChanges[masterFp] = !currentExcluded;
        }
        renderAll();
        updateFinalActionBar();
    }

    function resetPending() {
        pendingChanges = {};
        renderAll();
        updateFinalActionBar();
    }

    // 確認ダイアログの OK ハンドラを設定するユーティリティ
    function showConfirmDialog(bodyHtml, onOk, opts = {}) {
        document.getElementById('confirm-body').innerHTML = bodyHtml;
        const popup = document.getElementById('confirm-popup');
        const okBtn = document.getElementById('confirm-ok');
        // 既存ハンドラをクリア
        const prev = okBtn._currentHandler;
        if (prev) okBtn.removeEventListener('click', prev);
        okBtn._currentHandler = onOk;
        okBtn.addEventListener('click', onOk);
        // OK ラベル + 色のカスタマイズ
        okBtn.textContent = opts.okLabel || '実行';
        // ボタン色をリセットして再適用
        okBtn.classList.remove('bg-green-700', 'hover:bg-green-600',
                               'bg-red-700', 'hover:bg-red-600');
        if (opts.danger) {
            okBtn.classList.add('bg-red-700', 'hover:bg-red-600');
        } else {
            okBtn.classList.add('bg-green-700', 'hover:bg-green-600');
        }
        popup.classList.remove('hidden');
        popup.classList.add('flex');
        // スクロール有無でフェード切替
        requestAnimationFrame(() => {
            document.querySelectorAll('.confirm-img-area').forEach(el => {
                const fade = 'linear-gradient(to bottom,black 85%,transparent 100%)';
                if (el.scrollHeight > el.clientHeight) {
                    el.style.maskImage = fade;
                    el.style.webkitMaskImage = fade;
                } else {
                    el.style.maskImage = 'none';
                    el.style.webkitMaskImage = 'none';
                }
            });
        });
    }

    function hideConfirmDialog() {
        const popup = document.getElementById('confirm-popup');
        popup.classList.add('hidden');
        popup.classList.remove('flex');
    }

    function _thumbCard(thumb, title, opts) {
        const clickable = opts && opts.clickable;
        const dataAttr = opts && opts.dataFp ? ` data-master-fp="${escapeHtml(opts.dataFp)}"` : '';
        const clickCls = clickable ? ' cursor-pointer hover:ring-2 hover:ring-brand/50 confirm-preview-card' : '';
        return `<div class="bg-gray-800 rounded overflow-hidden w-40 flex-shrink-0 transition-all${clickCls}"${dataAttr}>
            ${thumb ? `<img src="${thumb}" class="w-full aspect-video object-cover" />` : '<div class="w-full aspect-video bg-gray-700"></div>'}
            <p class="text-[10px] text-gray-500 p-1.5 truncate">${escapeHtml(title)}</p>
        </div>`;
    }

    function _confirmCard(fp) {
        const item = allScreens.find(s => s.master_fp === fp);
        const thumb = item && item.thumbnail_path ? imgUrl(item.thumbnail_path) : '';
        return _thumbCard(thumb, item ? (item.name || '') : '', { clickable: true, dataFp: fp });
    }

    function showPreviewOverlay(masterFp) {
        const item = allScreens.find(s => s.master_fp === masterFp);
        if (!item) return;
        document.getElementById('preview-title').textContent = item.name || '';
        document.getElementById('preview-img').src = item.screenshot_path ? imgUrl(item.screenshot_path) : '';
        document.getElementById('preview-ocr').textContent = item.ocr_text || '';
        document.getElementById('preview-scene').textContent = item.category || '';
        document.getElementById('preview-fp').textContent = 'fp: ' + (item.screen_hash || '');
        document.getElementById('preview-time').textContent = item.last_seen_at || '';
        const overlay = document.getElementById('preview-overlay');
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
    }

    function showBulkConfirm(action) {
        if (selectedForGroup.size === 0) return;
        const fps = [...selectedForGroup];
        const label = action === 'adopt' ? '採用' : '不採用';
        const isDanger = action !== 'adopt';
        let html = `<p class="text-sm text-gray-300 mb-2">${fps.length} 件を${label}にします</p>`;
        html += '<div class="flex flex-wrap justify-center gap-3 max-h-[22rem] overflow-y-auto p-1 confirm-img-area">';
        for (const fp of fps) html += _confirmCard(fp);
        html += '</div>';
        showConfirmDialog(html, async function() {
            hideConfirmDialog();
            for (const fp of fps) {
                const item = allScreens.find(s => s.master_fp === fp);
                if (!item) continue;
                const targetExcluded = action === 'exclude';
                if (item.user_excluded !== targetExcluded) {
                    try {
                        await fetch(API_BASE + '?action=toggle_exclude&master_fp=' + encodeURIComponent(fp));
                        item.user_excluded = targetExcluded;
                    } catch (e) {}
                }
            }
            selectedForGroup.clear();
            pendingChanges = {};
            renderAll();
            updateGroupSelectUI();
            updateFinalActionBar();
        }, { okLabel: label, danger: isDanger });
        document.querySelectorAll('.confirm-preview-card').forEach(card => {
            card.addEventListener('click', function(e) {
                e.stopPropagation();
                showPreviewOverlay(this.dataset.masterFp);
            });
        });
    }

    document.getElementById('final-adopt-btn').addEventListener('click', () => showBulkConfirm('adopt'));
    document.getElementById('final-exclude-btn').addEventListener('click', () => showBulkConfirm('exclude'));
    document.getElementById('final-reset-btn').addEventListener('click', function() {
        resetPending();
        selectedForGroup.clear();
        renderAll();
        updateGroupSelectUI();
        updateFinalActionBar();
    });
    document.getElementById('final-merge-group-btn').addEventListener('click', showMergeGroupDialog);

    // --- Live タブ: 複数選択 採用/不採用 ---
    function updateLiveActionBar() {
        const liveActions = document.getElementById('live-actions');
        const filter = filterSelect.value;
        const isRepsFilter = filter === 'reps';
        const isExcludedFilter = filter === 'excluded';
        // 採用 or 不採用フィルタ時のみアクションバー表示
        if (currentTab === 'live' && (isRepsFilter || isExcludedFilter)) {
            liveActions.classList.remove('hidden');
        } else {
            liveActions.classList.add('hidden');
        }
        const adoptBtn = document.getElementById('live-adopt-btn');
        const excludeBtn = document.getElementById('live-exclude-btn');
        const resetBtn = document.getElementById('live-reset-btn');
        const hasSelection = selectedLiveScreens.size > 0;
        if (isRepsFilter) {
            adoptBtn.classList.add('hidden');
            excludeBtn.classList.remove('hidden');
        } else if (isExcludedFilter) {
            adoptBtn.classList.remove('hidden');
            excludeBtn.classList.add('hidden');
        }
        adoptBtn.disabled = !hasSelection;
        excludeBtn.disabled = !hasSelection;
        resetBtn.disabled = !hasSelection;
        // フッターに選択数表示
        const countEl = document.getElementById('final-select-count');
        if (currentTab === 'live') {
            countEl.textContent = hasSelection ? `${selectedLiveScreens.size} 件選択中` : '';
        }
    }

    function _liveConfirmCard(screenId) {
        const item = allScreens.find(s => s.id === screenId);
        const thumb = item && item.thumbnail_path ? imgUrl(item.thumbnail_path) : '';
        return _thumbCard(thumb, item ? (item.name || '') : '', { clickable: false });
    }

    function showLiveBulkConfirm(action) {
        if (selectedLiveScreens.size === 0) return;
        const ids = [...selectedLiveScreens];
        const label = action === 'adopt' ? '採用' : '不採用';
        const isDanger = action !== 'adopt';
        let html = `<p class="text-sm text-gray-300 mb-2">${ids.length} 件を${label}にします</p>`;
        html += '<div class="flex flex-wrap justify-center gap-3 max-h-[22rem] overflow-y-auto p-1 confirm-img-area">';
        for (const id of ids) html += _liveConfirmCard(id);
        html += '</div>';
        showConfirmDialog(html, async function() {
            hideConfirmDialog();
            for (const id of ids) {
                const item = allScreens.find(s => s.id === id);
                if (!item) continue;
                const wantExclude = action === 'exclude';
                const isCurrentlyExcluded = item.is_artifact > 0;
                if (isCurrentlyExcluded !== wantExclude) {
                    try {
                        const res = await fetch(API_BASE + '?action=toggle_screen_artifact&screen_id=' + id);
                        const data = await res.json();
                        item.is_artifact = data.is_artifact ?? (wantExclude ? 2 : 0);
                    } catch (e) {}
                }
            }
            selectedLiveScreens.clear();
            renderAll();
            updateLiveActionBar();
        }, { okLabel: label, danger: isDanger });
    }

    document.getElementById('live-adopt-btn').addEventListener('click', () => showLiveBulkConfirm('adopt'));
    document.getElementById('live-exclude-btn').addEventListener('click', () => showLiveBulkConfirm('exclude'));
    document.getElementById('live-reset-btn').addEventListener('click', function() {
        selectedLiveScreens.clear();
        renderAll();
        updateLiveActionBar();
    });

    function updateGroupSelectUI() {
        const countEl = document.getElementById('final-select-count');
        const mergeBtn = document.getElementById('final-merge-group-btn');
        if (selectedForGroup.size >= 1) {
            countEl.textContent = `${selectedForGroup.size} 件選択中`;
        } else {
            countEl.textContent = '';
        }
        mergeBtn.disabled = selectedForGroup.size < 2;
    }

    function showMergeGroupDialog() {
        if (selectedForGroup.size < 2) return;
        const fps = [...selectedForGroup];
        let html = `<p class="text-sm text-gray-300 mb-3">${fps.length} 件を統合します。代表を選択してください。</p>`;
        html += '<div class="flex flex-wrap justify-center gap-3 max-h-[30rem] overflow-y-auto p-1">';
        for (const fp of fps) {
            const item = allScreens.find(s => s.master_fp === fp);
            const thumb = item && item.thumbnail_path ? imgUrl(item.thumbnail_path) : '';
            html += `<div class="bg-gray-800 rounded overflow-hidden w-56 flex-shrink-0 cursor-pointer hover:ring-2 hover:ring-emerald-500 transition-all group-rep-card" data-master-fp="${escapeHtml(fp)}">
                ${thumb ? `<img src="${thumb}" class="w-full aspect-video object-cover" />` : '<div class="w-full aspect-video bg-gray-700"></div>'}
                <p class="text-[10px] text-gray-500 p-1.5 truncate">${escapeHtml(item ? (item.name || '') : '')}</p>
            </div>`;
        }
        html += '</div>';
        html += '<p class="text-xs text-gray-500 mt-3">クリックで代表を選択</p>';
        showConfirmDialog(html, function() {}, { okLabel: '統合' });  // OK は代表選択後に動的設定
        // 代表選択のクリックハンドラ
        document.querySelectorAll('.group-rep-card').forEach(card => {
            card.addEventListener('click', function(e) {
                e.stopPropagation();
                const repFp = this.dataset.masterFp;
                // 選択状態の表示
                document.querySelectorAll('.group-rep-card').forEach(c => c.classList.remove('ring-2', 'ring-emerald-500'));
                this.classList.add('ring-2', 'ring-emerald-500');
                // OK ハンドラを設定
                const okBtn = document.getElementById('confirm-ok');
                const prev = okBtn._currentHandler;
                if (prev) okBtn.removeEventListener('click', prev);
                const handler = async function() {
                    hideConfirmDialog();
                    const params = new URLSearchParams({
                        action: 'merge_manual_group',
                        master_fps: JSON.stringify(fps),
                        representative_fp: repFp,
                    });
                    try {
                        const res = await fetch(API_BASE + '?' + params);
                        const result = await res.json();
                        if (result.ok) {
                            selectedForGroup.clear();
                            updateGroupSelectUI();
                            await fetchFinal();
                        }
                    } catch (e) {}
                };
                okBtn._currentHandler = handler;
                okBtn.addEventListener('click', handler);
            });
        });
    }
    document.getElementById('confirm-cancel').addEventListener('click', hideConfirmDialog);
    document.getElementById('confirm-popup').addEventListener('click', function(e) {
        if (e.target === this) hideConfirmDialog();
    });

    // グリッドカード外クリックで選択リセット
    document.addEventListener('click', function(e) {
        if (currentTab === 'final' && selectedForGroup.size > 0) {
            if (e.target.closest('[data-idx]') || e.target.closest('#final-actions') || e.target.closest('#confirm-popup') || e.target.closest('#modal') || e.target.closest('#preview-overlay')) return;
            selectedForGroup.clear();
            pendingChanges = {};
            renderAll();
            updateGroupSelectUI();
            updateFinalActionBar();
        }
        if (currentTab === 'live' && selectedLiveScreens.size > 0) {
            if (e.target.closest('[data-idx]') || e.target.closest('#live-actions') || e.target.closest('#confirm-popup') || e.target.closest('#modal') || e.target.closest('#preview-overlay')) return;
            selectedLiveScreens.clear();
            renderAll();
            updateLiveActionBar();
        }
    });

    grid.addEventListener('click', function(e) {
        const card = e.target.closest('[data-idx]');
        if (!card) return;
        // Shift+クリック: 複数選択モード (Final / Live タブ)
        if (e.shiftKey && currentTab === 'final') {
            const idx = parseInt(card.dataset.idx, 10);
            const s = filteredScreens[idx];
            if (s && s.master_fp) {
                if (selectedForGroup.has(s.master_fp)) {
                    selectedForGroup.delete(s.master_fp);
                } else {
                    selectedForGroup.add(s.master_fp);
                }
                renderAll();
                updateGroupSelectUI();
                updateFinalActionBar();
            }
            return;
        }
        if (e.shiftKey && currentTab === 'live' && (filterSelect.value === 'reps' || filterSelect.value === 'excluded')) {
            const idx = parseInt(card.dataset.idx, 10);
            const s = filteredScreens[idx];
            if (s && s.id) {
                if (selectedLiveScreens.has(s.id)) {
                    selectedLiveScreens.delete(s.id);
                } else {
                    selectedLiveScreens.add(s.id);
                }
                renderAll();
                updateLiveActionBar();
            }
            return;
        }
        showModal(parseInt(card.dataset.idx, 10));
    });

    // ← 古い方向
    document.getElementById('modal-prev').addEventListener('click', function(e) {
        e.stopPropagation();
        if (canGoOlder()) showModal(olderIdx());
    });
    // → 新しい方向
    document.getElementById('modal-next').addEventListener('click', function(e) {
        e.stopPropagation();
        if (canGoNewer()) showModal(newerIdx());
    });

    modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
    });
    document.getElementById('modal-close-btn').addEventListener('click', closeModal);
    document.getElementById('modal-ocr-copy').addEventListener('click', function() {
        const text = document.getElementById('modal-ocr').textContent;
        navigator.clipboard.writeText(text);
    });
    document.addEventListener('keydown', function(e) {
        // モーダルが開いている時はモーダル内ナビゲーション
        if (modal.classList.contains('flex')) {
            if (e.key === 'Escape') closeModal();
            // プレビューモーダル時は専用ナビ
            if (_previewModalShow && _previewModalIdx >= 0) {
                if (e.key === 'ArrowLeft' && _previewModalIdx > 0) _previewModalShow(_previewModalIdx - 1);
                if (e.key === 'ArrowRight' && _previewModalIdx < _previewModalItems.length - 1) _previewModalShow(_previewModalIdx + 1);
            } else {
                if (e.key === 'ArrowLeft' && canGoOlder()) showModal(olderIdx());
                if (e.key === 'ArrowRight' && canGoNewer()) showModal(newerIdx());
            }
            // ↑↓ で同一クラスタ画像を選択
            if ((e.key === 'ArrowUp' || e.key === 'ArrowDown') && _clusterSiblings.length > 1) {
                e.preventDefault();
                const currentId = _clusterSelectedId || _clusterOriginalRepId;
                const curIdx = _clusterSiblings.findIndex(s => s.id == currentId);
                if (curIdx < 0) return;
                const nextIdx = e.key === 'ArrowUp'
                    ? (curIdx - 1 + _clusterSiblings.length) % _clusterSiblings.length
                    : (curIdx + 1) % _clusterSiblings.length;
                const sib = _clusterSiblings[nextIdx];
                _clusterSelectedId = sib.id;
                if (sib) {
                    document.getElementById('modal-img').src = sib.screenshot_path ? imgUrl(sib.screenshot_path) : '';
                    document.getElementById('modal-ocr').textContent = sib.ocr_text_gemini || sib.ocr_text_hq || sib.ocr_text || '';
                }
                renderClusterGrid();
                // 選択したサムネをスクロールに表示
                const selectedEl = document.querySelector(`.cluster-sib[data-sib-id="${sib.id}"]`);
                if (selectedEl) selectedEl.scrollIntoView({ block: 'nearest' });
            }
            return;
        }
        // Live タブ: ↑↓ でセッション切替 (↑=新しい, ↓=古い)
        if (currentTab === 'live') {
            if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
                e.preventDefault();
                const opts = sessionSelect.options;
                const curIdx = sessionSelect.selectedIndex;
                const nextIdx = e.key === 'ArrowUp'
                    ? Math.max(0, curIdx - 1)
                    : Math.min(opts.length - 1, curIdx + 1);
                if (nextIdx !== curIdx) {
                    sessionSelect.selectedIndex = nextIdx;
                    sessionSelect.dispatchEvent(new Event('change'));
                }
            }
        }
        // デバッグモード: ←→ でアンカーナビゲーション、↑↓ でセッション切替
        if (_debugMode && currentTab === 'final') {
            if (e.key === 'ArrowLeft') { e.preventDefault(); _debugNavigateAnchor(-1); }
            if (e.key === 'ArrowRight') { e.preventDefault(); _debugNavigateAnchor(1); }
            if (e.key === 'ArrowUp') { e.preventDefault(); _debugNavigateSession(-1); }
            if (e.key === 'ArrowDown') { e.preventDefault(); _debugNavigateSession(1); }
            if (e.key === 'Escape') { _debugAnchorIdx = -1; _debugSessionIdx = -1; _debugFilterSession = null; _updateDebugSelection(-1); renderAll(); }
        }
    });
    // --- バージョン管理 ---

    // リネームモーダル
    (() => {
        const rm = document.getElementById('rename-modal');
        const ri = document.getElementById('rename-input');
        const rv = document.getElementById('rename-vid');
        const close = () => { rm.classList.add('hidden'); rm.classList.remove('flex'); };
        const submit = () => {
            const vid = rv.value, newName = ri.value.trim();
            if (newName) {
                fetch(API_BASE + '?action=rename_version&version_id=' + vid + '&name=' + encodeURIComponent(newName))
                    .then(() => { close(); fetchVersions(); });
            }
        };
        document.getElementById('rename-cancel').addEventListener('click', close);
        document.getElementById('rename-submit').addEventListener('click', submit);
        ri.addEventListener('keydown', e => { if (e.key === 'Enter') submit(); if (e.key === 'Escape') close(); });
        rm.addEventListener('click', e => { if (e.target === rm) close(); });
    })();

    // 削除モーダル
    (() => {
        const dm = document.getElementById('delete-modal');
        const dv = document.getElementById('delete-vid');
        const close = () => { dm.classList.add('hidden'); dm.classList.remove('flex'); };
        const submit = () => {
            const vid = dv.value;
            fetch(API_BASE + '?action=delete_version&version_id=' + vid)
                .then(() => { close(); fetchVersions(); switchTab(currentTab); });
        };
        document.getElementById('delete-cancel').addEventListener('click', close);
        document.getElementById('delete-submit').addEventListener('click', submit);
        dm.addEventListener('click', e => { if (e.target === dm) close(); });
        dm.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
    })();

    async function fetchVersions() {
        try {
            const res = await fetch(API_BASE + '?action=get_versions');
            const data = await res.json();
            const versions = data.versions || [];
            // active version を取得
            const activeRes = await fetch(API_BASE + '?action=get_active_version');
            const activeData = await activeRes.json();
            _currentVersionId = activeData.version?.id || 1;
            _currentVersionName = activeData.version?.name || '';
            renderVersions(versions);
        } catch (e) {}
    }

    function renderVersions(versions) {
        // Settings タブのバージョン一覧
        const sc = document.getElementById('settings-container');
        let html = '<div class="max-w-2xl"><h3 class="text-lg font-bold text-gray-300 mb-4">バージョン管理</h3>';
        // 新規作成フォーム
        html += `<div class="flex gap-2 mb-4">
            <input id="new-version-name" type="text" placeholder="バージョン名 (例: v2.0.0)" class="bg-gray-800 text-gray-200 text-sm rounded px-3 py-1.5 border border-gray-700 focus:border-brand outline-none flex-1" />
            <button id="create-version-btn" class="px-4 py-1.5 bg-cyan-900/50 hover:bg-cyan-800/60 text-cyan-300 text-sm rounded transition-colors">作成</button>
        </div>`;
        // バージョン一覧
        html += '<div class="space-y-2">';
        for (const v of versions) {
            const isDefault = v.is_active == 1;
            const border = isDefault ? 'border-cyan-700 bg-cyan-950/30' : 'border-gray-800';
            const badge = isDefault ? '<span class="px-2 py-0.5 text-[10px] rounded bg-cyan-900/50 text-cyan-300">Default</span>' : '';
            html += `<div class="bg-gray-900 border ${border} rounded-lg p-3 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <span class="text-sm font-mono text-gray-300 version-name" data-version-id="${v.id}">${escapeHtml(v.name)}</span>
                    ${badge}
                    <span class="text-xs text-gray-500">${fmtShort(v.created_at)}</span>
                </div>
                <div class="flex items-center gap-2">
                    <button class="rename-version-btn px-2 py-1 bg-gray-700 hover:bg-gray-600 text-gray-400 text-xs rounded transition-colors" data-version-id="${v.id}" data-version-name="${escapeHtml(v.name)}" title="名前変更">✎</button>
                    <button class="delete-version-btn px-2 py-1 bg-red-900/50 hover:bg-red-800 text-red-400 text-xs rounded transition-colors" data-version-id="${v.id}" data-version-name="${escapeHtml(v.name)}" title="削除">${TRASH_ICON}</button>
                    ${!isDefault ? `<button class="activate-version-btn px-3 py-1 bg-cyan-900/50 hover:bg-cyan-800/60 text-cyan-300 text-xs rounded transition-colors" data-version-id="${v.id}">Defaultに設定</button>` : ''}
                </div>
            </div>`;
        }
        html += '</div></div>';
        sc.innerHTML = html;
        // イベント
        document.getElementById('create-version-btn')?.addEventListener('click', async () => {
            const name = document.getElementById('new-version-name').value.trim();
            if (!name) return;
            await fetch(API_BASE + '?action=create_version&name=' + encodeURIComponent(name));
            fetchVersions();
        });
        sc.querySelectorAll('.activate-version-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const vid = btn.dataset.versionId;
                await fetch(API_BASE + '?action=activate_version&version_id=' + vid);
                _currentVersionId = parseInt(vid);
                fetchVersions();
            });
        });
        sc.querySelectorAll('.rename-version-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const vid = btn.dataset.versionId;
                const oldName = btn.dataset.versionName;
                const rm = document.getElementById('rename-modal');
                const ri = document.getElementById('rename-input');
                const rv = document.getElementById('rename-vid');
                ri.value = oldName;
                rv.value = vid;
                rm.classList.remove('hidden');
                rm.classList.add('flex');
                ri.focus();
                ri.select();
            });
        });
        sc.querySelectorAll('.delete-version-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                if (versions.length <= 1) {
                    showToast('最後のバージョンは削除できません', 'error');
                    return;
                }
                const vid = btn.dataset.versionId;
                const name = btn.dataset.versionName;
                const dm = document.getElementById('delete-modal');
                document.getElementById('delete-msg').textContent =
                    `バージョン "${name}" を削除しますか？\n\n・関連するセッションが Live / Final / Merge から消えます\n・DB上のデータは論理削除されます\n・ローカルの画像ファイルは物理削除されます`;
                document.getElementById('delete-vid').value = vid;
                dm.classList.remove('hidden');
                dm.classList.add('flex');
            });
        });
        // バージョンセレクター更新
        updateVersionSelect(versions);
    }

    function updateVersionSelect(versions) {
        if (!versions) return;
        // _currentVersionId 未設定時は Default(is_active)を自動選択
        if (!_currentVersionId) {
            const active = versions.find(v => v.is_active == 1);
            if (active) {
                _currentVersionId = active.id;
                _currentVersionName = active.name;
            }
        }
        versionSelect.innerHTML = versions.map(v =>
            `<option value="${v.id}"${v.id == _currentVersionId ? ' selected' : ''}>${escapeHtml(v.name)}</option>`
        ).join('');
    }

    versionSelect.addEventListener('change', function() {
        _currentVersionId = parseInt(this.value);
        _currentVersionName = this.options[this.selectedIndex]?.text || '';
        if (currentTab === 'final') fetchFinal();
        else if (currentTab === 'live') { fetchLiveInitial(); }
        else if (currentTab === 'merge') fetchMergeTab();
    });

    // Final タブ切替時にバージョンセレクターを表示
    const _origSwitchTab = window.switchTab;
    // バージョンセレクターの表示制御は switchTab 内で行う (Final のみ表示)

    // 初期化: active version を取得
    fetch(API_BASE + '?action=get_active_version').then(r => r.json()).then(d => {
        _currentVersionId = d.version?.id || 1;
    }).catch(() => {});

})();
</script>
{% endblock %}
